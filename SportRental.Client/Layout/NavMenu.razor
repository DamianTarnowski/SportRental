@using SportRental.Client.Services
@using SportRental.Shared.Models
@using SportRental.Shared.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject ICartService CartService
@inject ICustomerSessionService Session
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject IApiService Api
@inject AuthService AuthService
@implements IDisposable

<nav aria-label="@AriaLabel">
    <!-- Main Navigation -->
    <NavLink href="./" Match="NavLinkMatch.All" class="sr-sidebar-link" ActiveClass="active" @onclick="HandleNavigation">
        <span class="sr-sidebar-link-icon"><Icon Name="home" /></span>
        <span>Strona główna</span>
    </NavLink>

    <NavLink href="products" class="sr-sidebar-link" ActiveClass="active" @onclick="HandleNavigation">
        <span class="sr-sidebar-link-icon"><Icon Name="catalog" /></span>
        <span>Katalog produktów</span>
    </NavLink>

    <NavLink href="map" class="sr-sidebar-link" ActiveClass="active" @onclick="HandleNavigation">
        <span class="sr-sidebar-link-icon"><Icon Name="map" /></span>
        <span>Mapa wypożyczalni</span>
    </NavLink>

    <NavLink href="cart" class="sr-sidebar-link" ActiveClass="active" @onclick="HandleNavigation">
        <span class="sr-sidebar-link-icon"><Icon Name="cart" /></span>
        <span>Koszyk</span>
        @if (_cart.TotalItems > 0)
        {
            <span class="sr-sidebar-badge">@_cart.TotalItems</span>
        }
    </NavLink>

    <NavLink href="reviews" class="sr-sidebar-link" ActiveClass="active" @onclick="HandleNavigation">
        <span class="sr-sidebar-link-icon"><Icon Name="star" /></span>
        <span>Opinie</span>
    </NavLink>

    <NavLink href="contact" class="sr-sidebar-link" ActiveClass="active" @onclick="HandleNavigation">
        <span class="sr-sidebar-link-icon"><Icon Name="mail" /></span>
        <span>Kontakt</span>
    </NavLink>

    <div class="sr-sidebar-divider"></div>

    <div class="sr-sidebar-title">Dokumenty</div>

    <NavLink href="terms" class="sr-sidebar-link" ActiveClass="active" @onclick="HandleNavigation">
        <span class="sr-sidebar-link-icon"><Icon Name="rentals" /></span>
        <span>Regulamin platformy</span>
    </NavLink>

    <NavLink href="privacy" class="sr-sidebar-link" ActiveClass="active" @onclick="HandleNavigation">
        <span class="sr-sidebar-link-icon"><Icon Name="eye" /></span>
        <span>Polityka prywatności</span>
    </NavLink>

    <div class="sr-sidebar-divider"></div>

    <!-- Account Section -->
    <div class="sr-sidebar-title">Konto</div>

    @if (!_isAuthenticated)
    {
        <NavLink href="login" class="sr-sidebar-link" ActiveClass="active" @onclick="HandleNavigation">
            <span class="sr-sidebar-link-icon"><Icon Name="login" /></span>
            <span>Zaloguj się</span>
        </NavLink>

        <NavLink href="register" class="sr-sidebar-link" ActiveClass="active" @onclick="HandleNavigation">
            <span class="sr-sidebar-link-icon"><Icon Name="register" /></span>
            <span>Zarejestruj się</span>
        </NavLink>

        <NavLink href="my-rentals" class="sr-sidebar-link" ActiveClass="active" @onclick="HandleNavigation">
            <span class="sr-sidebar-link-icon"><Icon Name="rentals" /></span>
            <span>Moje wynajmy</span>
        </NavLink>
    }
    else
    {
        <!-- User Info Card -->
        <div class="sr-sidebar-user">
            <div class="sr-sidebar-user-name">@(_customer?.FullName ?? "Konto klienta")</div>
            <div class="sr-sidebar-user-email">@(_customer?.Email ?? _authenticatedEmail)</div>
        </div>

        <NavLink href="profile" class="sr-sidebar-link" ActiveClass="active" @onclick="HandleNavigation">
            <span class="sr-sidebar-link-icon"><Icon Name="settings" /></span>
            <span>Moje dane</span>
        </NavLink>

        <NavLink href="my-rentals" class="sr-sidebar-link" ActiveClass="active" @onclick="HandleNavigation">
            <span class="sr-sidebar-link-icon"><Icon Name="rentals" /></span>
            <span>Moje wynajmy</span>
        </NavLink>

        <button type="button" class="sr-sidebar-logout" disabled="@_isLoggingOut" @onclick="LogoutAsync">
            <span class="sr-sidebar-link-icon"><Icon Name="logout" /></span>
            <span>@(_isLoggingOut ? "Wylogowywanie..." : "Wyloguj się")</span>
        </button>
    }
</nav>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = "Nawigacja główna";
    
    private Cart _cart = new();
    private CustomerDto? _customer;
    private bool _isAuthenticated;
    private string? _authenticatedEmail;
    private bool _isLoggingOut;

    protected override async Task OnInitializedAsync()
    {
        _cart = CartService.GetCart();
        CartService.CartChanged += OnCartChanged;

        await LoadSessionAsync();
        Session.SessionChanged += OnSessionChanged;
        
        // Subscribe to auth state changes
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
    }

    private async Task HandleNavigation()
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }

    private async Task LoadSessionAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _isAuthenticated = user.Identity?.IsAuthenticated == true;
        _authenticatedEmail = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                           ?? user.FindFirst("email")?.Value;

        if (!_isAuthenticated)
        {
            _customer = null;
            return;
        }

        try
        {
            var customerIdValue = user.FindFirst("customer-id")?.Value;
            _customer = Guid.TryParse(customerIdValue, out var customerId)
                ? await Api.GetCustomerAsync(customerId)
                : null;

            if (_customer is null && !string.IsNullOrWhiteSpace(_authenticatedEmail))
                _customer = await Api.FindCustomerByEmailAsync(_authenticatedEmail);

            _customer ??= await Session.GetCustomerAsync();
            if (_customer is not null)
                await Session.SetCustomerAsync(_customer);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine("[NavMenu] Failed to load customer session: {0}", ex);
        }
    }

    private void OnCartChanged(object? sender, EventArgs e)
    {
        _cart = CartService.GetCart();
        InvokeAsync(StateHasChanged);
    }

    private void OnSessionChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadSessionAsync();
            StateHasChanged();
        });
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadSessionAsync();
            StateHasChanged();
        });
    }

    private async Task LogoutAsync()
    {
        if (_isLoggingOut)
        {
            return;
        }

        _isLoggingOut = true;
        try
        {
            await AuthService.LogoutAsync();
            
            _customer = null;
            _isAuthenticated = false;
            Snackbar.Add("Wylogowano.", Severity.Info);
            Navigation.NavigateTo("./", true);
        }
        finally
        {
            _isLoggingOut = false;
        }
    }

    public void Dispose()
    {
        CartService.CartChanged -= OnCartChanged;
        Session.SessionChanged -= OnSessionChanged;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}
