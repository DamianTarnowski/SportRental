@page "/"
@layout HomeLayout

<PageTitle>RentSpot — wypożyczalnia sprzętu sportowego</PageTitle>

@* DS v2: flat navy hero (no aurora, no floating emoji), SVG icons only, no emoji *@

<section class="sr-hero">
    <div class="sr-hero-content">
        <div class="sr-hero-text">
            <div class="sr-hero-tagline">Wypożyczalnia sportowa</div>
            <h1 class="sr-hero-title">
                Odkryj <span>przygodę</span> na każdą porę roku
            </h1>
            <p class="sr-hero-description">
                Przeglądaj sprzęt dostępny w różnych wypożyczalniach, wybierz termin
                i zarezerwuj go online.
            </p>
            <div class="sr-hero-buttons">
                <a href="products" class="sr-btn-primary">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.3-4.3"/>
                    </svg>
                    Przeglądaj sprzęt
                </a>
                <a href="contact" class="sr-btn-secondary">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                    Kontakt
                </a>
            </div>
        </div>

        @* Right column: flat surface cards with category preview, no glow/gradient/emoji *@
        <div class="sr-hero-visual">
            <a href="products?category=Narty" class="sr-preview-card">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 21l18-18M7 17l3-3M11 13l3-3M15 9l3-3"/>
                </svg>
                <div class="sr-preview-card-title">Narty zjazdowe</div>
                <div class="sr-preview-card-price">Zobacz aktualną ofertę</div>
            </a>
            <a href="products?category=Snowboard" class="sr-preview-card">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 20l16-16M8 16h.01M16 8h.01"/>
                </svg>
                <div class="sr-preview-card-title">Snowboardy</div>
                <div class="sr-preview-card-price">Zobacz aktualną ofertę</div>
            </a>
            <a href="products?category=Rower" class="sr-preview-card">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="5.5" cy="17.5" r="3.5"/>
                    <circle cx="18.5" cy="17.5" r="3.5"/>
                    <path d="M15 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-3 11.5V14l-3-3 4-3 2 3h2"/>
                </svg>
                <div class="sr-preview-card-title">Rowery górskie</div>
                <div class="sr-preview-card-price">Zobacz aktualną ofertę</div>
            </a>
        </div>
    </div>
</section>

@* FEATURES — outlined cards, monochrome SVG icons, no emoji *@
<section class="sr-features">
    <div class="sr-section-header">
        <div class="sr-section-label">Dlaczego my</div>
        <h2 class="sr-section-title">Wszystko, czego potrzebujesz do swojej przygody</h2>
        <p class="sr-section-subtitle">
            W jednym miejscu porównasz opublikowaną ofertę, terminy i dane punktu odbioru.
        </p>
    </div>

    <div class="sr-features-grid">
        <div class="sr-feature-card">
            <div class="sr-feature-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
                </svg>
            </div>
            <h3 class="sr-feature-title">Oferta wypożyczalni</h3>
            <p class="sr-feature-description">
                Przeglądaj dostępny sprzęt wielu punktów bez przełączania między stronami.
            </p>
        </div>

        <div class="sr-feature-card">
            <div class="sr-feature-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                </svg>
            </div>
            <h3 class="sr-feature-title">Rezerwacja online</h3>
            <p class="sr-feature-description">
                Wybierz datę i godzinę, dodaj sprzęt do koszyka i dokończ rezerwację online.
            </p>
        </div>

        <div class="sr-feature-card">
            <div class="sr-feature-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="12" y1="1" x2="12" y2="23"/>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
            </div>
            <h3 class="sr-feature-title">Wycena przed płatnością</h3>
            <p class="sr-feature-description">
                Koszyk pokazuje dokładną wycenę dla wybranego terminu i sposobu rozliczenia.
            </p>
        </div>

        <div class="sr-feature-card">
            <div class="sr-feature-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
            </div>
            <h3 class="sr-feature-title">Informacje o odbiorze</h3>
            <p class="sr-feature-description">
                Na stronie produktu sprawdzisz wypożyczalnię, adres punktu i godziny otwarcia.
            </p>
        </div>

        <div class="sr-feature-card">
            <div class="sr-feature-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <circle cx="12" cy="12" r="6"/>
                    <circle cx="12" cy="12" r="2"/>
                </svg>
            </div>
            <h3 class="sr-feature-title">Kontakt z punktem</h3>
            <p class="sr-feature-description">
                Dane kontaktowe i formularz wiadomości ułatwiają uzgodnienie szczegółów odbioru.
            </p>
        </div>

        <div class="sr-feature-card">
            <div class="sr-feature-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="23 4 23 10 17 10"/>
                    <polyline points="1 20 1 14 7 14"/>
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
                </svg>
            </div>
            <h3 class="sr-feature-title">Historia rezerwacji</h3>
            <p class="sr-feature-description">
                Po zalogowaniu zobaczysz status, szczegóły i dokumenty swoich rezerwacji.
            </p>
        </div>
    </div>
</section>

@* CATEGORIES — flat cards, no emoji, no patterns *@
<section class="sr-categories">
    <div class="sr-section-header">
        <div class="sr-section-label">Kategorie</div>
        <h2 class="sr-section-title">Wybierz swoją dyscyplinę</h2>
        <p class="sr-section-subtitle">
            Przejdź do katalogu i sprawdź, co jest obecnie dostępne w wybranej kategorii.
        </p>
    </div>

    <div class="sr-categories-grid">
        <a href="products?category=Narty" class="sr-category-card">
            <svg class="sr-category-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 21l18-18M7 17l3-3M11 13l3-3M15 9l3-3"/>
            </svg>
            <h3 class="sr-category-title">Narty</h3>
            <p class="sr-category-count">Zobacz aktualną ofertę</p>
            <span class="sr-category-arrow" aria-hidden="true">→</span>
        </a>

        <a href="products?category=Snowboard" class="sr-category-card">
            <svg class="sr-category-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 20l16-16M8 16h.01M16 8h.01"/>
            </svg>
            <h3 class="sr-category-title">Snowboard</h3>
            <p class="sr-category-count">Zobacz aktualną ofertę</p>
            <span class="sr-category-arrow" aria-hidden="true">→</span>
        </a>

        <a href="products?category=Rower" class="sr-category-card">
            <svg class="sr-category-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="5.5" cy="17.5" r="3.5"/>
                <circle cx="18.5" cy="17.5" r="3.5"/>
                <path d="M15 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-3 11.5V14l-3-3 4-3 2 3h2"/>
            </svg>
            <h3 class="sr-category-title">Rowery</h3>
            <p class="sr-category-count">Zobacz aktualną ofertę</p>
            <span class="sr-category-arrow" aria-hidden="true">→</span>
        </a>

        <a href="products?category=SUP" class="sr-category-card">
            <svg class="sr-category-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 12c2-2 4-2 6 0s4 2 6 0 4-2 6 0M2 18c2-2 4-2 6 0s4 2 6 0 4-2 6 0M2 6c2-2 4-2 6 0s4 2 6 0 4-2 6 0"/>
            </svg>
            <h3 class="sr-category-title">SUP</h3>
            <p class="sr-category-count">Zobacz aktualną ofertę</p>
            <span class="sr-category-arrow" aria-hidden="true">→</span>
        </a>
    </div>
</section>

@* CTA — flat coral tint, no animated shapes, no emoji *@
<section class="sr-cta">
    <div class="sr-cta-content">
        <h2 class="sr-cta-title">Gotowy na przygodę?</h2>
        <p class="sr-cta-description">
            Sprawdź aktualnie dostępny sprzęt i wybierz termin, który Ci odpowiada.
        </p>
        <a href="products" class="sr-btn-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/>
                <path d="m12 5 7 7-7 7"/>
            </svg>
            Zacznij teraz
        </a>
    </div>
</section>

@* FOOTER — bez emoji, aktualny rok i brand RentSpot *@
<footer class="sr-footer">
    <div class="sr-footer-content">
        <div class="sr-footer-brand">
            <div class="sr-footer-logo" style="display:inline-flex;align-items:center;gap:8px;">
                <svg viewBox="0 0 100 100" width="22" height="22" aria-hidden="true">
                    <circle cx="50" cy="50" r="48" fill="#F96167" />
                    <text x="50" y="72" font-family="Outfit, Inter, system-ui, sans-serif" font-size="64" font-weight="900" text-anchor="middle" fill="#FFFFFF">R</text>
                </svg>
                RentSpot<span style="color:#F96167">.</span>
            </div>
            <p class="sr-footer-tagline">
                Katalog i rezerwacje sprzętu publikowanego przez współpracujące wypożyczalnie.
            </p>
        </div>

        <div class="sr-footer-column">
            <h2>Oferta</h2>
            <ul class="sr-footer-links">
                <li><a href="products?search=narty">Narty</a></li>
                <li><a href="products?search=snowboard">Snowboardy</a></li>
                <li><a href="products?search=rower">Rowery</a></li>
                <li><a href="products?search=wodne">Sporty wodne</a></li>
            </ul>
        </div>

        <div class="sr-footer-column">
            <h2>Informacje</h2>
            <ul class="sr-footer-links">
                <li><a href="contact">Kontakt</a></li>
                <li><a href="terms">Regulamin platformy</a></li>
                <li><a href="privacy">Polityka prywatności</a></li>
                <li><a href="guest-access">Odzyskaj rezerwację gościa</a></li>
            </ul>
        </div>

        <div class="sr-footer-column">
            <h2>Konto</h2>
            <ul class="sr-footer-links">
                <li><a href="login">Logowanie</a></li>
                <li><a href="register">Rejestracja</a></li>
                <li><a href="my-rentals">Moje wynajmy</a></li>
                <li><a href="cart">Koszyk</a></li>
            </ul>
        </div>
    </div>

    <div class="sr-footer-bottom">
        <p>© @DateTime.Now.Year RentSpot. Wszelkie prawa zastrzeżone.</p>
    </div>
</footer>
