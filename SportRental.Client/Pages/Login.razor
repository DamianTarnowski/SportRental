@page "/login"
@layout HomeLayout
@using SportRental.Client.Services
@using SportRental.Shared.Legal
@using System.ComponentModel.DataAnnotations
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IConfiguration Configuration

<PageTitle>RentSpot — Logowanie</PageTitle>

<div class="login-page">
    <!-- Background decoration -->
    <div class="login-bg-decoration">
        <div class="login-bg-circle login-bg-circle-1"></div>
        <div class="login-bg-circle login-bg-circle-2"></div>
        <div class="login-bg-circle login-bg-circle-3"></div>
    </div>
    
    <div class="login-container">
        <!-- Left side - Branding -->
        <div class="login-branding">
            <div class="login-branding-content">
                <div class="login-logo">
                    <svg class="login-logo-icon" viewBox="0 0 100 100" width="48" height="48" aria-hidden="true">
                        <circle cx="50" cy="50" r="48" fill="#F96167" />
                        <text x="50" y="72" font-family="Inter, system-ui, sans-serif" font-size="64" font-weight="900" text-anchor="middle" fill="#FFFFFF">R</text>
                    </svg>
                    <span class="login-logo-text">RentSpot<span style="color:#F96167">.</span></span>
                </div>
                <div class="login-branding-title">Witaj ponownie!</div>
                <p class="login-branding-subtitle">
                    Zaloguj się do swojego konta i kontynuuj sportową przygodę.
                </p>
                
                <div class="login-features">
                    <div class="login-feature">
                        <svg class="login-feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                            <polyline points="9 22 9 12 15 12 15 22"/>
                        </svg>
                        <span>Dostęp do wszystkich wypożyczalni</span>
                    </div>
                    <div class="login-feature">
                        <svg class="login-feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                            <line x1="16" y1="13" x2="8" y2="13"/>
                            <line x1="16" y1="17" x2="8" y2="17"/>
                        </svg>
                        <span>Historia Twoich wypożyczeń</span>
                    </div>
                    <div class="login-feature">
                        <svg class="login-feature-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                        </svg>
                        <span>Szybka rezerwacja sprzętu</span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Right side - Login form -->
        <div class="login-form-wrapper">
            <div class="login-card">
                <div class="login-card-header">
                    <h1 class="login-card-title">Logowanie</h1>
                    <p class="login-card-subtitle">Wprowadź swoje dane dostępowe</p>
                </div>
                
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="login-alert login-alert-error">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="8" x2="12" y2="12"/>
                            <line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                        <span>@_errorMessage</span>
                    </div>
                    @if (_showResendConfirmation)
                    {
                        <button type="button"
                                class="login-forgot"
                                disabled="@_isProcessing"
                                @onclick="ResendConfirmationAsync">
                            Wyślij link potwierdzający ponownie
                        </button>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(_infoMessage))
                {
                    <div class="login-alert" style="background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.35);color:#dcfce7;">
                        <span>@_infoMessage</span>
                    </div>
                }

                <EditForm Model="@_model" OnValidSubmit="HandleLoginAsync" class="login-form">
                    <DataAnnotationsValidator />

                    <div class="login-field">
                        <label class="login-label" for="login-email">Email</label>
                        <InputText id="login-email"
                                   @bind-Value="_model.Email"
                                   class="login-input"
                                   type="email"
                                   autocomplete="email"
                                   placeholder="twoj@email.pl" />
                        <ValidationMessage For="@(() => _model.Email)" />
                    </div>

                    <div class="login-field">
                        <label class="login-label" for="login-password">Hasło</label>
                        <InputText id="login-password"
                                   @bind-Value="_model.Password"
                                   class="login-input"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="••••••••" />
                        <ValidationMessage For="@(() => _model.Password)" />
                    </div>
                    
                    <div class="login-options">
                        <span></span>
                        <a href="@ForgotPasswordUrl" class="login-forgot" rel="external">Zapomniałeś hasła?</a>
                    </div>
                    
                    <button type="submit" class="login-button" disabled="@_isProcessing">
                        @if (_isProcessing)
                        {
                            <span class="login-button-spinner"></span>
                            <span>Logowanie...</span>
                        }
                        else
                        {
                            <span>Zaloguj się</span>
                        }
                    </button>
                </EditForm>

                @if (_googleLoginAvailable)
                {
                    <div class="login-divider">
                        <span>lub</span>
                    </div>

                    <label class="login-google-legal">
                        <input type="checkbox" @bind="_acceptGoogleLegal" />
                        <span>
                            Akceptuję <a href="terms">regulamin</a> i potwierdzam zapoznanie się z
                            <a href="privacy">polityką prywatności</a>.
                        </span>
                    </label>

                    <a href="@GoogleLoginUrl"
                       class="login-google-btn @(!_acceptGoogleLegal ? "login-google-btn-disabled" : null)"
                       aria-disabled="@(!_acceptGoogleLegal)"
                       @onclick:preventDefault="@(!_acceptGoogleLegal)"
                       rel="external">
                    <svg width="20" height="20" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/>
                        <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 13 24 13c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.4 6.3 14.7z"/>
                        <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.5-4.5 2.4-7.2 2.4-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.6 39.5 16.2 44 24 44z"/>
                        <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C41 35.5 44 30.2 44 24c0-1.3-.1-2.4-.4-3.5z"/>
                    </svg>
                        <span>Kontynuuj z Google</span>
                    </a>
                }

                <div class="login-footer">
                    <p>Nie masz jeszcze konta?</p>
                    <a href="register" class="login-register-link">
                        Zarejestruj się za darmo
                    </a>
                    <p style="margin-top:1rem;">Rezerwowałeś bez konta?</p>
                    <a href="guest-access" class="login-register-link">
                        Odzyskaj dostęp do zamówienia
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* ============================================
       LOGIN PAGE - Premium Design
       ============================================ */
    
    .login-page {
        min-height: 100vh;
        /* DS v2: flat navy zamiast gradientu green-navy (Coral Energy palette) */
        background: var(--navy-900, #1B2350);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        position: relative;
        overflow: hidden;
    }
    
    /* Background decorations */
    .login-bg-decoration {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
    }
    
    .login-bg-circle {
        position: absolute;
        border-radius: 50%;
        background: rgba(249, 97, 103, 0.1);
        filter: blur(60px);
    }
    
    .login-bg-circle-1 {
        width: 600px;
        height: 600px;
        top: -200px;
        right: -100px;
    }
    
    .login-bg-circle-2 {
        width: 400px;
        height: 400px;
        bottom: -100px;
        left: -100px;
        background: rgba(224, 69, 76, 0.1);
    }
    
    .login-bg-circle-3 {
        width: 300px;
        height: 300px;
        top: 50%;
        left: 30%;
        background: rgba(249, 97, 103, 0.1);
    }
    
    /* Main container */
    .login-container {
        display: flex;
        max-width: 1000px;
        width: 100%;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(20px);
        border-radius: 32px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
        position: relative;
        z-index: 1;
    }
    
    /* Left side - Branding */
    .login-branding {
        flex: 1;
        padding: 3rem;
        display: none;
        background: linear-gradient(135deg, rgba(249, 97, 103, 0.1) 0%, rgba(224, 69, 76, 0.1) 100%);
        border-right: 1px solid rgba(255, 255, 255, 0.05);
    }
    
    @@media (min-width: 768px) {
        .login-branding {
            display: flex;
            align-items: center;
        }
    }
    
    .login-branding-content {
        color: #fff;
    }
    
    .login-logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 2rem;
    }
    
    .login-logo-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: #F96167;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        box-shadow: 0 8px 20px rgba(249, 97, 103, 0.4);
    }
    
    .login-logo-text {
        font-family: 'Outfit', sans-serif;
        font-size: 1.75rem;
        font-weight: 700;
    }
    
    .login-logo-text span {
        color: #F96167;
    }
    
    .login-branding-title {
        font-family: var(--font-sans);
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        line-height: 1.2;
    }
    
    .login-branding-subtitle {
        font-family: 'Outfit', sans-serif;
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.7);
        margin-bottom: 2.5rem;
        line-height: 1.6;
    }
    
    .login-features {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    
    .login-feature {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.9);
    }
    
    .login-feature-icon {
        font-size: 1.5rem;
    }
    
    /* Right side - Form */
    .login-form-wrapper {
        flex: 1;
        padding: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    @@media (min-width: 768px) {
        .login-form-wrapper {
            padding: 3rem;
        }
    }
    
    .login-card {
        width: 100%;
        max-width: 400px;
    }
    
    .login-card-header {
        text-align: center;
        margin-bottom: 2rem;
    }
    
    .login-card-title {
        font-family: var(--font-sans);
        font-size: 2rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 0.5rem;
    }
    
    .login-card-subtitle {
        font-family: 'Outfit', sans-serif;
        color: rgba(255, 255, 255, 0.6);
    }
    
    /* Alert */
    .login-alert {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
        font-family: 'Outfit', sans-serif;
        font-size: 0.9rem;
    }
    
    .login-alert-error {
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #fca5a5;
    }
    
    .login-alert-icon {
        font-size: 1.25rem;
    }
    
    /* Form */
    .login-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }
    
    .login-field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    
    .login-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'Outfit', sans-serif;
        font-size: 0.9rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.8);
    }
    
    .login-label-icon {
        font-size: 1rem;
    }
    
    .login-input {
        width: 100%;
        padding: 1rem 1.25rem;
        border-radius: 12px;
        border: 2px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 1rem;
        transition: all 0.3s ease;
        outline: none;
    }
    
    .login-input::placeholder {
        color: rgba(255, 255, 255, 0.4);
    }
    
    .login-input:focus {
        border-color: #E0454C;
        background: rgba(255, 255, 255, 0.08);
        box-shadow: 0 0 0 4px rgba(249, 97, 103, 0.1);
    }
    
    /* Options row */
    .login-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: 'Outfit', sans-serif;
        font-size: 0.9rem;
    }
    
    .login-remember {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: rgba(255, 255, 255, 0.7);
        cursor: pointer;
    }
    
    .login-checkbox {
        width: 18px;
        height: 18px;
        accent-color: #E0454C;
    }
    
    .login-forgot {
        color: #FCA0A4;
        text-decoration: none;
        transition: color 0.3s ease;
    }
    
    .login-forgot:hover {
        color: #F96167;
    }
    
    /* Submit button */
    .login-button {
        width: 100%;
        padding: 1rem;
        border-radius: 12px;
        border: none;
        background: #BC3138;
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 20px rgba(249, 97, 103, 0.4);
        margin-top: 0.5rem;
    }
    
    .login-button:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(249, 97, 103, 0.5);
    }
    
    .login-button:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }
    
    .login-button-spinner {
        width: 20px;
        height: 20px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }
    
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
    
    /* Divider */
    .login-divider {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 2rem 0;
        color: rgba(255, 255, 255, 0.75);
        font-family: 'Outfit', sans-serif;
        font-size: 0.85rem;
    }
    
    .login-divider::before,
    .login-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    }

    /* Google OAuth button (Client) — biały button na ciemnym tle login card */
    .login-google-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        width: 100%;
        padding: 0.85rem 1rem;
        background: #FFFFFF;
        color: #1F2937;
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 12px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-bottom: 1.5rem;
    }
    .login-google-btn:hover {
        background: #F4F6FA;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
    }
    .login-google-btn:active { transform: translateY(0); }

    .login-google-btn-disabled,
    .login-google-btn-disabled:hover {
        opacity: 0.55;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .login-google-legal {
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
        margin: 0 0 0.9rem;
        color: rgba(255, 255, 255, 0.78);
        font-size: 0.8rem;
        line-height: 1.45;
    }

    .login-google-legal input {
        margin-top: 0.2rem;
        accent-color: #F96167;
    }

    .login-google-legal a {
        color: #FCA0A4;
    }

    /* Footer */
    .login-footer {
        text-align: center;
        font-family: 'Outfit', sans-serif;
    }
    
    .login-footer p {
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 0.75rem;
    }
    
    .login-register-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #fff;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    
    .login-register-link:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
    }
</style>

@code {
    private LoginModel _model = new();
    private string? _errorMessage;
    private string? _infoMessage;
    private bool _isProcessing;
    private bool _googleLoginAvailable;
    private bool _acceptGoogleLegal;
    private bool _showResendConfirmation;

    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "emailConfirmed")]
    public bool EmailConfirmed { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _googleLoginAvailable = await AuthService.IsGoogleLoginAvailableAsync();
        if (EmailConfirmed)
            _infoMessage = "Adres e-mail został potwierdzony. Możesz się teraz zalogować.";
    }

    private string GoogleLoginUrl
    {
        get
        {
            var returnPath = SafeClientNavigation.ToBundledClientPath(ReturnUrl);
            return $"{ApiBaseUrl}/Account/StartExternalLogin?provider=Google" +
                   $"&returnUrl={Uri.EscapeDataString(returnPath)}" +
                   $"&termsVersion={Uri.EscapeDataString(LegalDocumentVersions.Terms)}" +
                   $"&privacyVersion={Uri.EscapeDataString(LegalDocumentVersions.Privacy)}";
        }
    }

    private string ApiBaseUrl =>
        (Configuration["Api:BaseUrl"] ?? new Uri(NavigationManager.BaseUri).GetLeftPart(UriPartial.Authority))
        .TrimEnd('/');

    private string ForgotPasswordUrl => $"{ApiBaseUrl}/Account/ForgotPassword";

    private async Task HandleLoginAsync()
    {
        _isProcessing = true;
        _errorMessage = null;
        _infoMessage = null;
        _showResendConfirmation = false;

        try
        {
            var result = await AuthService.LoginAsync(_model.Email, _model.Password);

            if (result.Succeeded)
            {
                Snackbar.Add("Zalogowano pomyślnie!", Severity.Success);
                NavigationManager.NavigateTo(SafeClientNavigation.NormalizeRelativeReturnUrl(ReturnUrl));
            }
            else
            {
                _errorMessage = result.ErrorMessage;
                _showResendConfirmation = string.Equals(
                    result.ErrorCode,
                    "email_confirmation_required",
                    StringComparison.Ordinal);
            }
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task ResendConfirmationAsync()
    {
        _isProcessing = true;
        try
        {
            var result = await AuthService.ResendEmailConfirmationAsync(_model.Email);
            if (result.Succeeded)
            {
                _infoMessage = "Jeśli konto oczekuje na potwierdzenie, wysłaliśmy nowy link.";
                _errorMessage = null;
                _showResendConfirmation = false;
            }
            else
            {
                _errorMessage = result.ErrorMessage;
            }
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private class LoginModel
    {
        [Required(ErrorMessage = "Podaj adres e-mail.")]
        [EmailAddress(ErrorMessage = "Podaj poprawny adres e-mail.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Podaj hasło.")]
        public string Password { get; set; } = string.Empty;
    }
}
