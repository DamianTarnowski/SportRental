@page "/my-rentals"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using SportRental.Client.Components
@using SportRental.Client.Helpers
@using SportRental.Shared.Models
@using SportRental.Shared.Services
@using MudBlazor
@inject IApiService Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService DialogService
@implements IAsyncDisposable

<PageTitle>Moje wypożyczenia — RentSpot</PageTitle>

@* ============================================
   MOBILE UI - Compact rental cards
   ============================================ *@
@if (_isMobile)
{
    <div class="rentals-mobile">
        <!-- Mobile Header -->
        <div class="rentals-mobile-header">
            <div class="rentals-mobile-title">
                <h1>Wypożyczenia</h1>
                @if (_rentals?.Count > 0)
                {
                    <span class="rentals-mobile-count">@RentalOrders.Count</span>
                }
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="rentals-mobile-loading">
                <MudProgressCircular Indeterminate="true" Color="Color.Secondary" />
                <span>Ładowanie...</span>
            </div>
        }
        else if (_loadError is not null)
        {
            <div class="rentals-mobile-empty" role="alert">
                <span class="empty-icon"><Icon Name="rentals" Size="44" /></span>
                <h3>Nie udało się pobrać wypożyczeń</h3>
                <p>@_loadError</p>
                <button type="button" class="rentals-mobile-cta" @onclick="LoadRentalsAsync">Spróbuj ponownie</button>
            </div>
        }
        else if (_rentals == null || !_rentals.Any())
        {
            <div class="rentals-mobile-empty">
                <span class="empty-icon"><Icon Name="rentals" Size="44" /></span>
                <h3>Brak wypożyczeń</h3>
                <p>Zacznij swoją przygodę ze sportem!</p>
                <a href="products" class="rentals-mobile-cta">Przeglądaj sprzęt</a>
            </div>
        }
        else
        {
            <div class="rentals-mobile-list">
                @foreach (var order in RentalOrders)
                {
                    <section class="rental-order-group">
                        @if (order.IsMarketplaceOrder)
                        {
                            <header class="rental-order-header">
                                <div>
                                    <span>Zamówienie</span>
                                    <strong>@order.Number</strong>
                                    <small>@PolishCount(order.Rentals.Count, "rezerwacja", "osobne rezerwacje", "osobnych rezerwacji") · @PolishCount(order.Rentals.Count, "punkt odbioru", "punkty odbioru", "punktów odbioru")</small>
                                </div>
                                <div class="rental-order-totals">
                                    <span>Wynajem @order.Rentals.Sum(rental => rental.TotalAmount).Pln()</span>
                                    <span>Depozyt początkowy @order.Rentals.Sum(rental => rental.DepositAmount).Pln()</span>
                                    @if (RefundedDeposit(order) > 0m)
                                    {
                                        <span>Zwrócono @RefundedDeposit(order).Pln()</span>
                                    }
                                </div>
                            </header>
                        }
                    @foreach (var rental in order.Rentals)
                    {
                    <div class="rental-mobile-card @(rental.IsOverdue ? "overdue" : "")">
                        <div class="mb-3">
                            @if (order.Rentals.Count > 1)
                            {
                                <span class="rental-order-sequence">Rezerwacja @(rental.OrderSequence ?? (order.Rentals.IndexOf(rental) + 1)) z @order.Rentals.Count</span>
                            }
                            <strong>@TenantName(rental)</strong>
                            @if (!string.IsNullOrWhiteSpace(RentalPresentation.PickupLocation(rental)))
                            {
                                <div class="text-sm text-gray-600">Odbiór: @RentalPresentation.PickupLocation(rental)</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(rental.TenantPhoneNumber))
                            {
                                <div class="text-sm"><a href="@($"tel:{rental.TenantPhoneNumber}")">@rental.TenantPhoneNumber</a></div>
                            }
                        </div>
                        <!-- Status badges -->
                        <div class="rental-mobile-badges">
                            <span class="rental-mobile-status @GetStatusClass(rental.Status)">
                                @GetStatusText(rental.Status)
                            </span>
                            <span class="rental-mobile-status @GetPaymentStatusClass(rental)">
                                @RentalPresentation.PaymentStatusText(rental)
                            </span>
                            <span class="rental-mobile-equip @GetEquipmentStatusClass(rental)" title="@GetEquipmentStatusText(rental)">
                                <Icon Name="rentals" Size="20" />
                            </span>
                        </div>

                        @if (rental.IsOverdue)
                        {
                            <div class="rental-mobile-overdue">
                                Termin minął!
                            </div>
                        }

                        <!-- Dates -->
                        <div class="rental-mobile-dates">
                            <div class="rental-mobile-date-item">
                                <span class="date-label">Od</span>
                                <span class="date-value">@FormatCompactDate(rental.StartDateUtc, rental)</span>
                            </div>
                            <span class="date-arrow">→</span>
                            <div class="rental-mobile-date-item">
                                <span class="date-label">Do</span>
                                <span class="date-value">@FormatCompactDate(rental.EndDateUtc, rental)</span>
                            </div>
                        </div>
                        <div class="text-sm text-gray-600 mb-2">
                            @RentalPresentation.RentalTypeText(rental) · @RentalPresentation.DurationText(rental)
                        </div>

                        <!-- Products preview -->
                        <div class="rental-mobile-products">
                            @foreach (var item in rental.Items.Take(2))
                            {
                                <span class="rental-mobile-product">@item.ProductName × @item.Quantity — @RentalPresentation.Money(item.TotalPrice)</span>
                            }
                            @if (rental.Items.Count > 2)
                            {
                                <span class="rental-mobile-more">+@(rental.Items.Count - 2) więcej</span>
                            }
                        </div>

                        <!-- Footer -->
                        <div class="rental-mobile-footer">
                            <div class="rental-mobile-amount">
                                <span class="amount-value">@RentalPresentation.Money(rental.TotalAmount)</span>
                                <span class="amount-deposit">Opłacono za wynajem: @RentalPresentation.Money(RentalPresentation.PaidAmount(rental))</span>
                                @if (RentalPresentation.IsDepositCollected(rental))
                                {
                                    <span class="amount-deposit">Depozyt pobrany: @RentalPresentation.Money(rental.DepositAmount)</span>
                                }
                                @if (RentalPresentation.DepositSettlementText(rental) is { } depositSettlement)
                                {
                                    <span class="amount-deposit">@depositSettlement</span>
                                }
                                <span class="amount-deposit">Do zapłaty za wynajem: @RentalPresentation.Money(RentalPresentation.OutstandingAmount(rental))</span>
                            </div>
                            <button class="rental-mobile-btn" @onclick="@(() => ViewDetails(rental.Id))">
                                Szczegóły →
                            </button>
                        </div>
                        @if (CanReview(rental))
                        {
                            <button class="rental-mobile-review-cta" @onclick="@(() => OpenReviewDialog(rental))">
                                Oceń wypożyczenie
                            </button>
                        }
                        else if (rental.HasReview)
                        {
                            <div class="rental-mobile-review-done">
                                Dziękujemy za opinię
                            </div>
                        }
                    </div>
                    }
                    </section>
                }
            </div>
        }
    </div>
}
@* ============================================
   DESKTOP UI - Original design
   ============================================ *@
else
{
<div class="rentals-container">
    <div class="max-w-5xl mx-auto">
        <!-- Header -->
        <div class="rentals-header">
            <h1>Moje wypożyczenia</h1>
            <p>Przeglądaj historię swoich wypożyczeń i aktywne rezerwacje</p>
        </div>

        @if (_isLoading)
        {
            <div class="flex items-center justify-center py-20">
                <div class="text-center">
                    <div class="w-16 h-16 border-4 border-pink-200 border-t-pink-500 rounded-full animate-spin mx-auto mb-4"></div>
                    <p class="text-gray-600">Ładowanie wypożyczeń...</p>
                </div>
            </div>
        }
        else if (_loadError is not null)
        {
            <div class="rentals-empty" role="alert">
                <div class="rentals-empty-icon"><Icon Name="rentals" Size="44" /></div>
                <h2 class="text-2xl font-bold text-gray-800 mb-2">Nie udało się pobrać wypożyczeń</h2>
                <p class="text-gray-600 mb-6">@_loadError</p>
                <button type="button" class="cart-checkout-btn" style="max-width: 300px; margin: 0 auto;" @onclick="LoadRentalsAsync">
                    Spróbuj ponownie
                </button>
            </div>
        }
        else if (_rentals == null || !_rentals.Any())
        {
            <div class="rentals-empty">
                <div class="rentals-empty-icon"><Icon Name="rentals" Size="44" /></div>
                <h2 class="text-2xl font-bold text-gray-800 mb-2">Brak wypożyczeń</h2>
                <p class="text-gray-600 mb-6">Nie masz jeszcze żadnych wypożyczeń. Zacznij swoją przygodę ze sportem!</p>
                <a href="products" class="cart-checkout-btn" style="max-width: 300px; margin: 0 auto; text-decoration: none; background: linear-gradient(135deg, #F96167 0%, #E0454C 100%);">
                    Przeglądaj sprzęt
                </a>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var order in RentalOrders)
                {
                    <section class="rental-order-group rental-order-group-desktop">
                        @if (order.IsMarketplaceOrder)
                        {
                            <header class="rental-order-header">
                                <div>
                                    <span>Zamówienie</span>
                                    <strong>@order.Number</strong>
                                    <small>@PolishCount(order.Rentals.Count, "rezerwacja", "osobne rezerwacje", "osobnych rezerwacji") w @PolishCount(order.Rentals.Count, "punkcie odbioru", "punktach odbioru", "punktach odbioru")</small>
                                </div>
                                <div class="rental-order-totals">
                                    <span>Łączny wynajem <strong>@order.Rentals.Sum(rental => rental.TotalAmount).Pln()</strong></span>
                                    <span>Depozyt początkowy <strong>@order.Rentals.Sum(rental => rental.DepositAmount).Pln()</strong></span>
                                    @if (RefundedDeposit(order) > 0m)
                                    {
                                        <span>Zwrócono <strong>@RefundedDeposit(order).Pln()</strong></span>
                                    }
                                </div>
                            </header>
                        }
                    @foreach (var rental in order.Rentals)
                    {
                    <div class="rental-card">
                        <div class="mb-4">
                            @if (order.Rentals.Count > 1)
                            {
                                <span class="rental-order-sequence">Rezerwacja @(rental.OrderSequence ?? (order.Rentals.IndexOf(rental) + 1)) z @order.Rentals.Count</span>
                            }
                            <div class="text-lg font-bold text-gray-900">@TenantName(rental)</div>
                            @if (!string.IsNullOrWhiteSpace(RentalPresentation.PickupLocation(rental)))
                            {
                                <div class="text-sm text-gray-600">Punkt odbioru: @RentalPresentation.PickupLocation(rental)</div>
                            }
                            <div class="text-sm text-gray-600">
                                @if (!string.IsNullOrWhiteSpace(rental.TenantPhoneNumber))
                                {
                                    <a href="@($"tel:{rental.TenantPhoneNumber}")">@rental.TenantPhoneNumber</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(rental.TenantEmail))
                                {
                                    <span> · <a href="@($"mailto:{rental.TenantEmail}")">@rental.TenantEmail</a></span>
                                }
                            </div>
                            <div class="text-sm text-gray-600">
                                @RentalPresentation.RentalTypeText(rental) · @RentalPresentation.DurationText(rental)
                            </div>
                        </div>
                        <div class="rental-card-header">
                            <div class="rental-card-dates">
                                <div class="rental-date-group">
                                    <div class="rental-date-label">Od</div>
                                    <div class="rental-date-value">@FormatDesktopDate(rental.StartDateUtc, rental)</div>
                                </div>
                                <div class="rental-date-group">
                                    <div class="rental-date-label">Do</div>
                                    <div class="rental-date-value">@FormatDesktopDate(rental.EndDateUtc, rental)</div>
                                </div>
                            </div>
                            <div class="rental-status-badges">
                                <span class="rental-status @GetStatusClass(rental.Status)">
                                    @GetStatusText(rental.Status)
                                </span>
                                <span class="rental-status @GetPaymentStatusClass(rental)">
                                    @RentalPresentation.PaymentStatusText(rental)
                                </span>
                                <span class="rental-status @GetEquipmentStatusClass(rental)">
                                    @GetEquipmentStatusText(rental)
                                </span>
                            </div>
                        </div>
                        
                        @* Ostrzeżenie o przeterminowaniu *@
                        @if (rental.IsOverdue)
                        {
                            <div class="rental-overdue-warning">
                                Termin zwrotu minął! Prosimy o pilny kontakt z wypożyczalnią.
                            </div>
                        }

                        <div class="rental-products">
                            @foreach (var item in rental.Items.Take(3))
                            {
                                <div class="rental-product-item">
                                    <span>@item.ProductName × @item.Quantity</span>
                                    <span class="font-medium">@RentalPresentation.Money(item.TotalPrice)</span>
                                </div>
                            }
                            @if (rental.Items.Count > 3)
                            {
                                <div class="text-sm text-gray-500 mt-2">
                                    + @(rental.Items.Count - 3) więcej...
                                </div>
                            }
                        </div>

                        <div class="rental-card-footer">
                            <div class="rental-total">
                                @RentalPresentation.Money(rental.TotalAmount)
                                <div class="text-sm font-normal text-gray-600">Opłacono za wynajem: @RentalPresentation.Money(RentalPresentation.PaidAmount(rental))</div>
                                @if (RentalPresentation.IsDepositCollected(rental))
                                {
                                    <div class="text-sm font-normal text-gray-600">Depozyt pobrany: @RentalPresentation.Money(rental.DepositAmount)</div>
                                }
                                @if (RentalPresentation.DepositSettlementText(rental) is { } depositSettlement)
                                {
                                    <div class="text-sm font-normal text-gray-600">@depositSettlement</div>
                                }
                                <div class="text-sm font-normal text-gray-600">Do zapłaty za wynajem: @RentalPresentation.Money(RentalPresentation.OutstandingAmount(rental))</div>
                            </div>
                            <div class="rental-actions">
                                @if (CanReview(rental))
                                {
                                    <button class="rental-btn rental-btn-review" @onclick="@(() => OpenReviewDialog(rental))">
                                        Oceń
                                    </button>
                                }
                                else if (rental.HasReview)
                                {
                                    <span class="rental-review-done-badge">Oceniono</span>
                                }
                                <button class="rental-btn rental-btn-primary" @onclick="@(() => ViewDetails(rental.Id))">
                                    Szczegóły
                                </button>
                                @if (rental.PublicContractUrl != null)
                                {
                                    <a href="@rental.PublicContractUrl" target="_blank" rel="noopener" class="rental-btn rental-btn-secondary">
                                        Umowa
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                    }
                    </section>
                }
            </div>
        }
    </div>
</div>
} @* End of Desktop UI *@

@code {
    private bool _isLoading = true;
    private List<MyRentalDto>? _rentals;
    private string? _loadError;
    private bool _isMobile = false;
    private DotNetObjectReference<MyRentals>? _dotNetRef;

    private IReadOnlyList<RentalOrderView> RentalOrders => (_rentals ?? new List<MyRentalDto>())
        .GroupBy(rental => rental.MarketplaceOrderId ?? rental.Id)
        .Select(group =>
        {
            var rentals = group
                .OrderBy(rental => rental.OrderSequence ?? int.MaxValue)
                .ThenBy(rental => rental.StartDateUtc)
                .ToList();
            return new RentalOrderView(
                group.Key,
                rentals.Select(rental => rental.MarketplaceOrderNumber)
                    .FirstOrDefault(number => !string.IsNullOrWhiteSpace(number)),
                rentals[0].MarketplaceOrderId.HasValue,
                rentals);
        })
        .OrderByDescending(order => order.Rentals.Max(rental => rental.StartDateUtc))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadRentalsAsync();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("setupMobileDetection", _dotNetRef);
        }
    }
    
    [JSInvokable]
    public void OnScreenResize(bool isMobile)
    {
        if (_isMobile != isMobile)
        {
            _isMobile = isMobile;
            InvokeAsync(StateHasChanged);
        }
    }
    
    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("removeMobileDetection");
        }
        catch { }
        _dotNetRef?.Dispose();
    }

    private async Task LoadRentalsAsync()
    {
        _isLoading = true;
        _loadError = null;
        StateHasChanged();

        try
        {
            _rentals = await Api.GetMyRentalsAsync();
        }
        catch (Exception ex)
        {
            _loadError = "Sprawdź połączenie z internetem i spróbuj ponownie.";
            Snackbar.Add("Nie udało się pobrać wypożyczeń.", Severity.Error);
            Console.Error.WriteLine($"Nie udało się pobrać wypożyczeń: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private static string GetStatusClass(string status) => RentalPresentation.StatusCssClass(status);

    private static string GetStatusText(string status) => RentalPresentation.StatusText(status);

    private static string GetPaymentStatusClass(MyRentalDto rental) =>
        RentalPresentation.IsPaymentConfirmed(rental) ? "active" : "pending";

    // Status wydania/zwrotu sprzętu
    private string GetEquipmentStatusClass(MyRentalDto rental)
    {
        if (rental.ReturnedAtUtc.HasValue)
            return "completed";
        if (string.Equals(rental.Status, "Completed", StringComparison.OrdinalIgnoreCase))
            return "completed";
        if (string.Equals(rental.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
            return "cancelled";
        if (rental.IssuedAtUtc.HasValue)
            return rental.IsOverdue ? "overdue" : "active";
        if (string.Equals(rental.Status, "Active", StringComparison.OrdinalIgnoreCase))
            return rental.IsOverdue ? "overdue" : "active";
        return "pending";
    }

    private string GetEquipmentStatusText(MyRentalDto rental)
    {
        if (rental.ReturnedAtUtc.HasValue)
            return $"Zwrócono {PolishRentalTime.FromUtc(rental.ReturnedAtUtc.Value):dd.MM}";
        if (string.Equals(rental.Status, "Completed", StringComparison.OrdinalIgnoreCase))
            return "Sprzęt zwrócony";
        if (string.Equals(rental.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
            return "Bez wydania";
        if (rental.IssuedAtUtc.HasValue)
            return $"Wydano {PolishRentalTime.FromUtc(rental.IssuedAtUtc.Value):dd.MM}";
        if (string.Equals(rental.Status, "Active", StringComparison.OrdinalIgnoreCase))
            return "Sprzęt wydany";
        return "Oczekuje na odbiór";
    }

    private void ViewDetails(Guid rentalId)
    {
        Nav.NavigateTo($"my-rentals/{rentalId}");
    }

    private static bool CanReview(MyRentalDto rental) => RentalPresentation.CanReview(rental);

    private static string TenantName(MyRentalDto rental) =>
        string.IsNullOrWhiteSpace(rental.TenantName) ? "Wypożyczalnia" : rental.TenantName;

    private static decimal RefundedDeposit(RentalOrderView order) =>
        order.Rentals.Sum(rental =>
            rental.ReturnDepositRefund ??
            (string.Equals(rental.PaymentStatus, "DepositRefunded", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(rental.PaymentStatus, "Refunded", StringComparison.OrdinalIgnoreCase)
                ? rental.DepositAmount
                : 0m));

    private static string PolishCount(int count, string singular, string paucal, string plural)
    {
        var absolute = Math.Abs(count);
        var lastTwoDigits = absolute % 100;
        var noun = absolute == 1
            ? singular
            : lastTwoDigits is >= 12 and <= 14
                ? plural
                : absolute % 10 is >= 2 and <= 4
                    ? paucal
                    : plural;
        return $"{count} {noun}";
    }

    private static string FormatCompactDate(DateTime value, MyRentalDto rental) =>
        PolishRentalTime.FromUtc(value).ToString(rental.RentalType == RentalTypeDto.Hourly ? "dd.MM HH:mm" : "dd.MM.yyyy");

    private static string FormatDesktopDate(DateTime value, MyRentalDto rental) =>
        PolishRentalTime.FromUtc(value).ToString(rental.RentalType == RentalTypeDto.Hourly ? "dd.MM.yyyy HH:mm" : "dd.MM.yyyy");

    private async Task OpenReviewDialog(MyRentalDto rental)
    {
        var parameters = new DialogParameters
        {
            [nameof(ReviewDialog.RentalId)] = rental.Id
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ReviewDialog>("Oceń wypożyczenie", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadRentalsAsync();
        }
    }

    private sealed record RentalOrderView(
        Guid Id,
        string? Number,
        bool IsMarketplaceOrder,
        List<MyRentalDto> Rentals);
}
