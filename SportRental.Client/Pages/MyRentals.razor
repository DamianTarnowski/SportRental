@page "/my-rentals"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using SportRental.Client.Components
@using SportRental.Shared.Models
@using SportRental.Shared.Services
@using MudBlazor
@inject IApiService Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService DialogService
@implements IAsyncDisposable

<PageTitle>Moje wypożyczenia - SportRental</PageTitle>

@* ============================================
   MOBILE UI - Compact rental cards
   ============================================ *@
@if (_isMobile)
{
    <div class="rentals-mobile">
        <!-- Mobile Header -->
        <div class="rentals-mobile-header">
            <div class="rentals-mobile-title">
                <span>📋</span>
                <h1>Wypożyczenia</h1>
                @if (_rentals?.Count > 0)
                {
                    <span class="rentals-mobile-count">@_rentals.Count</span>
                }
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="rentals-mobile-loading">
                <MudProgressCircular Indeterminate="true" Color="Color.Secondary" />
                <span>Ładowanie...</span>
            </div>
        }
        else if (_rentals == null || !_rentals.Any())
        {
            <div class="rentals-mobile-empty">
                <span class="empty-icon">📭</span>
                <h3>Brak wypożyczeń</h3>
                <p>Zacznij swoją przygodę ze sportem!</p>
                <a href="/products" class="rentals-mobile-cta">🎿 Przeglądaj sprzęt</a>
            </div>
        }
        else
        {
            <div class="rentals-mobile-list">
                @foreach (var rental in _rentals.OrderByDescending(r => r.StartDateUtc))
                {
                    <div class="rental-mobile-card @(rental.IsOverdue ? "overdue" : "")">
                        <!-- Status badges -->
                        <div class="rental-mobile-badges">
                            <span class="rental-mobile-status @GetStatusClass(rental.Status)">
                                @GetStatusEmoji(rental.Status) @GetStatusText(rental.Status)
                            </span>
                            <span class="rental-mobile-equip @GetEquipmentStatusClass(rental)">
                                @GetEquipmentStatusEmoji(rental)
                            </span>
                        </div>

                        @if (rental.IsOverdue)
                        {
                            <div class="rental-mobile-overdue">
                                ⚠️ Termin minął!
                            </div>
                        }

                        <!-- Dates -->
                        <div class="rental-mobile-dates">
                            <div class="rental-mobile-date-item">
                                <span class="date-label">Od</span>
                                <span class="date-value">@rental.StartDateUtc.ToLocalTime().ToString("dd.MM")</span>
                            </div>
                            <span class="date-arrow">→</span>
                            <div class="rental-mobile-date-item">
                                <span class="date-label">Do</span>
                                <span class="date-value">@rental.EndDateUtc.ToLocalTime().ToString("dd.MM")</span>
                            </div>
                        </div>

                        <!-- Products preview -->
                        <div class="rental-mobile-products">
                            @foreach (var item in rental.Items.Take(2))
                            {
                                <span class="rental-mobile-product">📦 @item.ProductName x@(item.Quantity)</span>
                            }
                            @if (rental.Items.Count > 2)
                            {
                                <span class="rental-mobile-more">+@(rental.Items.Count - 2) więcej</span>
                            }
                        </div>

                        <!-- Footer -->
                        <div class="rental-mobile-footer">
                            <div class="rental-mobile-amount">
                                <span class="amount-value">@rental.TotalAmount.ToString("C")</span>
                            </div>
                            <button class="rental-mobile-btn" @onclick="@(() => ViewDetails(rental.Id))">
                                Szczegóły →
                            </button>
                        </div>
                        @if (CanReview(rental))
                        {
                            <button class="rental-mobile-review-cta" @onclick="@(() => OpenReviewDialog(rental))">
                                ⭐ Oceń wypożyczenie
                            </button>
                        }
                        else if (rental.HasReview)
                        {
                            <div class="rental-mobile-review-done">
                                ✅ Dziękujemy za opinię
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
@* ============================================
   DESKTOP UI - Original design
   ============================================ *@
else
{
<div class="rentals-container">
    <div class="max-w-5xl mx-auto">
        <!-- Header -->
        <div class="rentals-header">
            <h1>📋 Moje wypożyczenia</h1>
            <p>Przeglądaj historię swoich wypożyczeń i aktywne rezerwacje</p>
        </div>

        @if (_isLoading)
        {
            <div class="flex items-center justify-center py-20">
                <div class="text-center">
                    <div class="w-16 h-16 border-4 border-pink-200 border-t-pink-500 rounded-full animate-spin mx-auto mb-4"></div>
                    <p class="text-gray-600">Ładowanie wypożyczeń...</p>
                </div>
            </div>
        }
        else if (_rentals == null || !_rentals.Any())
        {
            <div class="rentals-empty">
                <div class="rentals-empty-icon">📭</div>
                <h2 class="text-2xl font-bold text-gray-800 mb-2">Brak wypożyczeń</h2>
                <p class="text-gray-600 mb-6">Nie masz jeszcze żadnych wypożyczeń. Zacznij swoją przygodę ze sportem!</p>
                <a href="/products" class="cart-checkout-btn" style="max-width: 300px; margin: 0 auto; text-decoration: none; background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    🎿 Przeglądaj sprzęt
                </a>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var rental in _rentals.OrderByDescending(r => r.StartDateUtc))
                {
                    <div class="rental-card">
                        <div class="rental-card-header">
                            <div class="rental-card-dates">
                                <div class="rental-date-group">
                                    <div class="rental-date-label">Od</div>
                                    <div class="rental-date-value">@rental.StartDateUtc.ToLocalTime().ToString("dd.MM.yyyy")</div>
                                </div>
                                <div class="rental-date-group">
                                    <div class="rental-date-label">Do</div>
                                    <div class="rental-date-value">@rental.EndDateUtc.ToLocalTime().ToString("dd.MM.yyyy")</div>
                                </div>
                            </div>
                            <div class="rental-status-badges">
                                <span class="rental-status @GetStatusClass(rental.Status)">
                                    @GetStatusEmoji(rental.Status) @GetStatusText(rental.Status)
                                </span>
                                <span class="rental-status @GetEquipmentStatusClass(rental)">
                                    @GetEquipmentStatusEmoji(rental) @GetEquipmentStatusText(rental)
                                </span>
                            </div>
                        </div>
                        
                        @* Ostrzeżenie o przeterminowaniu *@
                        @if (rental.IsOverdue)
                        {
                            <div class="rental-overdue-warning">
                                ⚠️ Termin zwrotu minął! Prosimy o pilny kontakt z wypożyczalnią.
                            </div>
                        }

                        <div class="rental-products">
                            @foreach (var item in rental.Items.Take(3))
                            {
                                <div class="rental-product-item">
                                    <span>📦 @item.ProductName</span>
                                    <span class="font-medium">x@(item.Quantity)</span>
                                </div>
                            }
                            @if (rental.Items.Count > 3)
                            {
                                <div class="text-sm text-gray-500 mt-2">
                                    + @(rental.Items.Count - 3) więcej...
                                </div>
                            }
                        </div>

                        <div class="rental-card-footer">
                            <div class="rental-total">
                                @rental.TotalAmount.ToString("C")
                            </div>
                            <div class="rental-actions">
                                @if (CanReview(rental))
                                {
                                    <button class="rental-btn rental-btn-review" @onclick="@(() => OpenReviewDialog(rental))">
                                        ⭐ Oceń
                                    </button>
                                }
                                else if (rental.HasReview)
                                {
                                    <span class="rental-review-done-badge">✅ Oceniono</span>
                                }
                                <button class="rental-btn rental-btn-primary" @onclick="@(() => ViewDetails(rental.Id))">
                                    👁️ Szczegóły
                                </button>
                                @if (rental.ContractUrl != null)
                                {
                                    <a href="@rental.ContractUrl" target="_blank" class="rental-btn rental-btn-secondary">
                                        📄 Umowa
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
} @* End of Desktop UI *@

@code {
    private bool _isLoading = true;
    private List<MyRentalDto>? _rentals;
    private bool _isMobile = false;
    private DotNetObjectReference<MyRentals>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        await LoadRentalsAsync();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("setupMobileDetection", _dotNetRef);
        }
    }
    
    [JSInvokable]
    public void OnScreenResize(bool isMobile)
    {
        if (_isMobile != isMobile)
        {
            _isMobile = isMobile;
            InvokeAsync(StateHasChanged);
        }
    }
    
    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("removeMobileDetection");
        }
        catch { }
        _dotNetRef?.Dispose();
    }

    private async Task LoadRentalsAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            _rentals = await Api.GetMyRentalsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd podczas ładowania wypożyczeń: {ex.Message}", Severity.Error);
            _rentals = new List<MyRentalDto>();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private string GetStatusClass(string status)
    {
        return status.ToLower() switch
        {
            "draft" or "pending" => "pending",
            "reserved" or "confirmed" => "reserved",
            "active" or "onrent" => "active",
            "returned" or "completed" => "completed",
            "cancelled" => "cancelled",
            "overdue" => "overdue",
            _ => ""
        };
    }

    private string GetStatusEmoji(string status)
    {
        return status.ToLower() switch
        {
            "draft" or "pending" => "⏳",
            "reserved" or "confirmed" => "📅",
            "active" or "onrent" => "✅",
            "returned" or "completed" => "🏁",
            "cancelled" => "❌",
            "overdue" => "⚠️",
            _ => "📋"
        };
    }

    private string GetStatusText(string status)
    {
        return status.ToLower() switch
        {
            "draft" => "Szkic",
            "pending" => "Oczekujące",
            "confirmed" => "Potwierdzone",
            "active" => "Aktywne",
            "completed" => "Zakończone",
            "cancelled" => "Anulowane",
            _ => status
        };
    }

    // Status wydania/zwrotu sprzętu
    private string GetEquipmentStatusClass(MyRentalDto rental)
    {
        if (rental.ReturnedAtUtc.HasValue)
            return "completed";
        if (rental.IssuedAtUtc.HasValue)
            return rental.IsOverdue ? "overdue" : "active";
        return "pending";
    }

    private string GetEquipmentStatusEmoji(MyRentalDto rental)
    {
        if (rental.ReturnedAtUtc.HasValue)
            return "✅";
        if (rental.IssuedAtUtc.HasValue)
            return rental.IsOverdue ? "⚠️" : "📦";
        return "⏳";
    }

    private string GetEquipmentStatusText(MyRentalDto rental)
    {
        if (rental.ReturnedAtUtc.HasValue)
            return $"Zwrócono {rental.ReturnedAtUtc.Value.ToLocalTime():dd.MM}";
        if (rental.IssuedAtUtc.HasValue)
            return $"Wydano {rental.IssuedAtUtc.Value.ToLocalTime():dd.MM}";
        return "Oczekuje na odbiór";
    }

    private void ViewDetails(Guid rentalId)
    {
        Nav.NavigateTo($"/my-rentals/{rentalId}");
    }

    private static bool CanReview(MyRentalDto rental) =>
        !rental.HasReview && !string.Equals(rental.Status, "Cancelled", StringComparison.OrdinalIgnoreCase);

    private async Task OpenReviewDialog(MyRentalDto rental)
    {
        var parameters = new DialogParameters
        {
            [nameof(ReviewDialog.RentalId)] = rental.Id
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ReviewDialog>("Oceń wypożyczenie", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadRentalsAsync();
        }
    }
}
