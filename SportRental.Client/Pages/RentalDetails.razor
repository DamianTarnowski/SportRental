@page "/my-rentals/{id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using SportRental.Client.Helpers
@using SportRental.Shared.Models
@using SportRental.Shared.Services
@inject IApiService Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Szczegóły wypożyczenia — RentSpot</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    @if (_isLoading)
    {
        <MudPaper Elevation="2" Class="pa-8 text-center">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="mb-4" />
            <MudText Typo="Typo.h6">Ładowanie szczegółów wypożyczenia...</MudText>
        </MudPaper>
    }
    else if (_loadError is not null)
    {
        <MudPaper Elevation="2" Class="pa-8 text-center" role="alert">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
            <MudText Typo="Typo.h5" Class="mb-2">Nie udało się pobrać wypożyczenia</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">@_loadError</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadRentalAsync">
                Spróbuj ponownie
            </MudButton>
        </MudPaper>
    }
    else if (_rental == null)
    {
        <MudPaper Elevation="2" Class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" Class="mb-4" />
            <MudText Typo="Typo.h5" Class="mb-2">Wypożyczenie nie znalezione</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                Nie udało się znaleźć wypożyczenia o podanym ID.
            </MudText>
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       Href="my-rentals"
                       StartIcon="@Icons.Material.Filled.ArrowBack">
                Powrót do listy wypożyczeń
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="2" Class="pa-6 mb-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h4">
                        <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" />
                        Szczegóły wypożyczenia
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        ID: @Id
                    </MudText>
                    <MudText Typo="Typo.h6">@TenantName(_rental)</MudText>
                </MudStack>
                <MudChip T="string" Color="@GetStatusColor(_rental.Status)" Size="Size.Large" Variant="Variant.Filled">
                    @RentalPresentation.StatusText(_rental.Status)
                </MudChip>
            </MudStack>

            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       Href="my-rentals"
                       StartIcon="@Icons.Material.Filled.ArrowBack">
                Powrót do listy
            </MudButton>
        </MudPaper>

        @if (_rental.IsOverdue)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                Termin zwrotu minął. Skontaktuj się jak najszybciej z wypożyczalnią @TenantName(_rental).
            </MudAlert>
        }

        @if (CanReview(_rental))
        {
            <MudPaper Elevation="4" Class="pa-5 mb-4 review-cta-banner" Style="background: linear-gradient(135deg, #F96167 0%, #E0454C 100%); color: white;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="3">
                    <MudStack Spacing="1" Style="flex: 1; min-width: 240px;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Star" Style="color: #fff; font-size: 2rem;" />
                            <MudText Typo="Typo.h5" Style="color: white; font-weight: 700;">
                                Podziel się opinią
                            </MudText>
                        </MudStack>
                        <MudText Typo="Typo.body1" Style="color: rgba(255,255,255,0.95);">
                            Oceń jakość sprzętu, cenę i obsługę. Twoja opinia pomaga innym klientom wybrać dobrze.
                        </MudText>
                    </MudStack>
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.RateReview"
                               OnClick="OpenReviewDialog"
                               Style="background: white; color: #E0454C; font-weight: 600; min-width: 200px;">
                        Wystaw opinię
                    </MudButton>
                </MudStack>
            </MudPaper>
        }

        <MudGrid Spacing="3">
            <!-- Pickup and tenant contact -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4 h-100">
                    <MudText Typo="Typo.h6" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Storefront" Class="mr-2" />
                        Wypożyczalnia i odbiór
                    </MudText>
                    <MudStack Spacing="2">
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Wypożyczalnia</MudText>
                            <MudText Typo="Typo.body1">@TenantName(_rental)</MudText>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(RentalPresentation.PickupLocation(_rental)))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Punkt odbioru</MudText>
                                <MudText Typo="Typo.body1">@RentalPresentation.PickupLocation(_rental)</MudText>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_rental.OpeningHours))
                        {
                            <div>
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Godziny otwarcia</MudText>
                                <MudText Typo="Typo.body1">@_rental.OpeningHours</MudText>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_rental.TenantPhoneNumber))
                        {
                            <MudLink Href="@($"tel:{_rental.TenantPhoneNumber}")">@_rental.TenantPhoneNumber</MudLink>
                        }
                        @if (!string.IsNullOrWhiteSpace(_rental.TenantEmail))
                        {
                            <MudLink Href="@($"mailto:{_rental.TenantEmail}")">@_rental.TenantEmail</MudLink>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Rental Period -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4 h-100">
                    <MudText Typo="Typo.h6" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="mr-2" />
                        Okres wynajmu
                    </MudText>
                    <MudStack Spacing="2">
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Data rozpoczęcia</MudText>
                            <MudText Typo="Typo.body1">
                                @PolishRentalTime.FromUtc(_rental.StartDateUtc).ToString("dddd, dd MMMM yyyy, HH:mm")
                            </MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Data zakończenia</MudText>
                            <MudText Typo="Typo.body1">
                                @PolishRentalTime.FromUtc(_rental.EndDateUtc).ToString("dddd, dd MMMM yyyy, HH:mm")
                            </MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Rodzaj i czas wynajmu</MudText>
                            <MudText Typo="Typo.body1">@RentalPresentation.RentalTypeText(_rental) · @RentalPresentation.DurationText(_rental)</MudText>
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Payment Info -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4 h-100">
                    <MudText Typo="Typo.h6" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Payment" Class="mr-2" />
                        Informacje o płatności
                    </MudText>
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle2">Status płatności:</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@(RentalPresentation.IsPaymentConfirmed(_rental) ? Color.Success : Color.Warning)">
                                @RentalPresentation.PaymentStatusText(_rental)
                            </MudChip>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.subtitle2">Wartość wynajmu:</MudText>
                            <MudText Typo="Typo.body1">@RentalPresentation.Money(_rental.TotalAmount)</MudText>
                        </MudStack>
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.subtitle2">Opłacono za wynajem:</MudText>
                            <MudText Typo="Typo.body1" Color="Color.Success">@RentalPresentation.Money(RentalPresentation.PaidAmount(_rental))</MudText>
                        </MudStack>
                        @if (RentalPresentation.IsDepositCollected(_rental))
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.subtitle2">Depozyt pobrany:</MudText>
                                <MudText Typo="Typo.body1" Color="Color.Info">@RentalPresentation.Money(_rental.DepositAmount)</MudText>
                            </MudStack>
                        }
                        @if (RentalPresentation.DepositSettlementText(_rental) is { } depositSettlement)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Info">@depositSettlement</MudText>
                        }
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.subtitle2">Do zapłaty za wynajem:</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Primary">@RentalPresentation.Money(RentalPresentation.OutstandingAmount(_rental))</MudText>
                        </MudStack>
                        @if (!string.IsNullOrWhiteSpace(_rental.PaymentMethod))
                        {
                            <MudText Typo="Typo.body2">Metoda: @RentalPresentation.PaymentMethodText(_rental.PaymentMethod)</MudText>
                        }
                        @if (_rental.PaidAtUtc.HasValue)
                        {
                            <MudText Typo="Typo.body2">Potwierdzono: @PolishRentalTime.FromUtc(_rental.PaidAtUtc.Value).ToString("dd.MM.yyyy HH:mm")</MudText>
                        }
                        @if ((_rental.DamageCharge ?? 0m) > 0m)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">Opłata za uszkodzenia: @RentalPresentation.Money(_rental.DamageCharge!.Value)</MudAlert>
                        }
                        @if (_rental.ReturnDepositRefund.HasValue)
                        {
                            <MudText Typo="Typo.body2">Zwrócony depozyt: @RentalPresentation.Money(_rental.ReturnDepositRefund.Value)</MudText>
                        }
                        <MudDivider />
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Contract & Actions -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4 h-100">
                    <MudText Typo="Typo.h6" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" />
                        Dokumenty i akcje
                    </MudText>
                    <MudStack Spacing="2">
                        @if (!string.IsNullOrEmpty(_rental.PublicContractUrl))
                        {
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       Href="@_rental.PublicContractUrl"
                                       Target="_blank"
                                       StartIcon="@Icons.Material.Filled.Download"
                                       FullWidth="true">
                                Otwórz umowę PDF
                            </MudButton>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                Umowa nie jest jeszcze dostępna
                            </MudAlert>
                        }

                        @if (_rental.CanCancel)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Cancel"
                                       FullWidth="true"
                                       OnClick="CancelRentalAsync"
                                       Disabled="@_isCancelling">
                                @(_isCancelling ? "Anulowanie..." : "Anuluj wypożyczenie")
                            </MudButton>
                        }

                        @if (_rental.HasReview)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Icon="@Icons.Material.Filled.CheckCircle">
                                Dziękujemy za opinię!
                            </MudAlert>
                        }

                        <MudButton Variant="Variant.Text"
                                   Color="Color.Secondary" 
                                   Href="@($"contact?tenantId={_rental.TenantId:D}&rentalId={_rental.Id:D}")"
                                   StartIcon="@Icons.Material.Filled.ContactSupport"
                                   FullWidth="true">
                            Skontaktuj się z wypożyczalnią
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Rented Items -->
            <MudItem xs="12">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Class="mr-2" />
                        Wypożyczone produkty (@_rental.Items.Count)
                    </MudText>

                    <MudTable Items="@_rental.Items" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                        <HeaderContent>
                            <MudTh>Produkt</MudTh>
                            <MudTh>Ilość</MudTh>
                            <MudTh>@(_rental.RentalType == RentalTypeDto.Hourly ? "Cena za godzinę" : "Cena za dzień")</MudTh>
                            <MudTh class="text-right">Razem</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Produkt">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body1" Class="fw-bold">@context.ProductName</MudText>
                                </MudStack>
                            </MudTd>
                            <MudTd DataLabel="Ilość">
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                    @context.Quantity szt.
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Cena jednostkowa">
                                @if (_rental.RentalType == RentalTypeDto.Hourly)
                                {
                                    <span>@(context.HourlyPrice.HasValue ? RentalPresentation.Money(context.HourlyPrice.Value) : "Brak ceny godzinowej")</span>
                                }
                                else
                                {
                                    <span>@RentalPresentation.Money(context.DailyPrice)</span>
                                }
                            </MudTd>
                            <MudTd DataLabel="Razem" class="text-right">
                                <MudText Typo="Typo.body1" Class="fw-bold" Color="Color.Primary">
                                    @RentalPresentation.Money(context.TotalPrice)
                                </MudText>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Brak pozycji w tym wypożyczeniu.</MudText>
                        </NoRecordsContent>
                        <FooterContent>
                            <MudTh colspan="3" class="text-right">
                                <MudText Typo="Typo.h6">Suma:</MudText>
                            </MudTh>
                            <MudTh class="text-right">
                                <MudText Typo="Typo.h6" Color="Color.Primary">
                                    @RentalPresentation.Money(_rental.Items.Sum(i => i.TotalPrice))
                                </MudText>
                            </MudTh>
                        </FooterContent>
                    </MudTable>
                </MudPaper>
            </MudItem>

            <!-- Status Timeline -->
            <MudItem xs="12">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="mr-2" />
                        Status wypożyczenia
                    </MudText>
                    
                    <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Start">
                        <MudTimelineItem Color="@GetTimelineColor("Pending")" Size="Size.Small">
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">Oczekujące</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Rezerwacja została utworzona</MudText>
                        </MudTimelineItem>
                        
                        <MudTimelineItem Color="@GetTimelineColor("Confirmed")" Size="Size.Small">
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">Potwierdzone</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Rezerwacja została potwierdzona</MudText>
                        </MudTimelineItem>
                        
                        <MudTimelineItem Color="@GetTimelineColor("Active")" Size="Size.Small">
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">Aktywne</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Sprzęt został wydany</MudText>
                        </MudTimelineItem>
                        
                        <MudTimelineItem Color="@GetTimelineColor("Completed")" Size="Size.Small">
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">Zakończone</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Sprzęt został zwrócony</MudText>
                        </MudTimelineItem>
                    </MudTimeline>

                    <MudAlert Severity="@GetStatusSeverity(_rental.Status)" Class="mt-4">
                        <MudText Typo="Typo.body1">
                            <strong>Aktualny status:</strong> @GetStatusDescription(_rental.Status)
                        </MudText>
                    </MudAlert>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _isLoading = true;
    private MyRentalDto? _rental;
    private bool _isCancelling;
    private string? _loadError;

    protected override async Task OnParametersSetAsync()
    {
        await LoadRentalAsync();
    }

    private async Task LoadRentalAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            // Pobierz wszystkie wynajmy i znajdź ten konkretny
            var rentals = await Api.GetMyRentalsAsync();
            _rental = rentals?.FirstOrDefault(r => r.Id == Id);

            if (_rental == null)
            {
                Snackbar.Add("Nie znaleziono wypożyczenia", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            _rental = null;
            _loadError = "Sprawdź połączenie z internetem i spróbuj ponownie.";
            Snackbar.Add("Nie udało się pobrać szczegółów wypożyczenia.", Severity.Error);
            Console.Error.WriteLine($"Nie udało się pobrać wypożyczenia {Id}: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CancelRentalAsync()
    {
        if (_rental == null) return;

        var confirmed = await DialogService.ShowMessageBox(
            "Potwierdź anulowanie",
            "Czy na pewno chcesz anulować to wypożyczenie?",
            yesText: "Tak, anuluj",
            cancelText: "Nie");

        if (confirmed != true) return;

        _isCancelling = true;
        try
        {
            var success = await Api.CancelRentalAsync(Id);
            if (success)
            {
                Snackbar.Add("Wypożyczenie zostało anulowane", Severity.Success);
                await LoadRentalAsync(); // Odśwież dane
            }
            else
            {
                Snackbar.Add("Nie udało się anulować wypożyczenia", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Nie udało się anulować wypożyczenia. Spróbuj ponownie.", Severity.Error);
            Console.Error.WriteLine($"Rental cancellation failed: {ex.GetType().Name}");
        }
        finally
        {
            _isCancelling = false;
        }
    }

    private static bool CanReview(MyRentalDto rental) => RentalPresentation.CanReview(rental);

    private async Task OpenReviewDialog()
    {
        if (_rental == null) return;

        var parameters = new DialogParameters
        {
            [nameof(ReviewDialog.RentalId)] = _rental.Id
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ReviewDialog>("Oceń wypożyczenie", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadRentalAsync();
        }
    }

    private Color GetStatusColor(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "pending" or "confirmed" or "reserved" => Color.Primary,
            "active" or "onrent" => Color.Success,
            "completed" or "returned" => Color.Info,
            "cancelled" or "canceled" => Color.Error,
            "overdue" => Color.Warning,
            _ => Color.Default
        };
    }

    private Color GetTimelineColor(string targetStatus)
    {
        if (_rental == null) return Color.Default;
        
        var currentIndex = GetStatusIndex(_rental.Status);
        var targetIndex = GetStatusIndex(targetStatus);
        
        return targetIndex <= currentIndex ? Color.Success : Color.Default;
    }

    private int GetStatusIndex(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "draft" => 0,
            "pending" or "reserved" => 1,
            "confirmed" => 2,
            "active" or "onrent" => 3,
            "completed" or "returned" => 4,
            _ => 0
        };
    }

    private Severity GetStatusSeverity(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "pending" or "confirmed" or "reserved" => Severity.Info,
            "active" or "onrent" => Severity.Success,
            "completed" or "returned" => Severity.Success,
            "cancelled" or "canceled" => Severity.Error,
            "overdue" => Severity.Warning,
            _ => Severity.Normal
        };
    }

    private string GetStatusDescription(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "draft" => "Wypożyczenie jest przygotowywane.",
            "pending" => "Wypożyczenie oczekuje na potwierdzenie.",
            "confirmed" => "Wypożyczenie jest potwierdzone. Odbierz sprzęt w wyznaczonym terminie.",
            "active" => "Wypożyczenie jest aktywne. Sprzęt został wydany i jest w użyciu.",
            "completed" => "Sprzęt został zwrócony, a wypożyczenie zakończone.",
            "cancelled" or "canceled" => "Wypożyczenie zostało anulowane.",
            // Obsługa wyłącznie historycznych wartości przechowywanych jako tekst.
            "reserved" => "Wypożyczenie zostało zarezerwowane.",
            "onrent" => "Sprzęt jest obecnie wypożyczony.",
            "returned" => "Sprzęt został zwrócony. Wypożyczenie zostało zakończone.",
            "overdue" => "Termin zwrotu sprzętu minął. Prosimy o kontakt.",
            _ => "Status nieznany"
        };
    }

    private static string TenantName(MyRentalDto rental) =>
        string.IsNullOrWhiteSpace(rental.TenantName) ? "Wypożyczalnia" : rental.TenantName;
}

