@page "/products"
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web
@using SportRental.Shared.Models
@using SportRental.Client.Services
@inject IApiService ApiService
@inject ICartService CartService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject TenantService TenantService
@implements IAsyncDisposable

<PageTitle>RentSpot — Katalog produktów</PageTitle>

@* ============================================
   MOBILE UI - Compact cards, bottom sheet filters
   ============================================ *@
@if (_isMobile)
{
    <div class="products-mobile">
        <!-- Mobile Header - Sticky -->
        <div class="products-mobile-header">
            <div class="products-mobile-title">
                <span></span>
                <h1>Katalog</h1>
                <span class="products-mobile-count">@totalProductCount</span>
            </div>
            <button class="products-mobile-filter-btn"
                    @onclick="ToggleMobileFilters"
                    aria-label="Filtry katalogu"
                    aria-expanded="@(_showMobileFilters ? "true" : "false")"
                    aria-controls="mobile-product-filters">
                <Icon Name="filter" Size="20" />
                @if (HasActiveFilters())
                {
                    <span class="filter-badge">!</span>
                }
            </button>
        </div>

        <!-- Mobile Quick Stats -->
        <div class="products-mobile-stats">
            <div class="mobile-stat">
                <span>@availableProductCount @AvailabilityAdjective(availableProductCount)</span>
            </div>
            <div class="mobile-stat">
                <span>od @resultMinPrice.PlnInt()</span>
            </div>
        </div>

        @if (selectedTenantId.HasValue)
        {
            <div class="products-mobile-tenant-context" role="status">
                <span>Oferta: <strong>@SelectedTenantDisplayName</strong></span>
                <button type="button" @onclick="OpenMobileTenantFilter">Zmień wypożyczalnię</button>
            </div>
        }

        <!-- Mobile Filters Panel -->
        @if (_showMobileFilters)
        {
            <div class="products-mobile-filters" id="mobile-product-filters">
                <!-- Search -->
                <MudTextField @bind-Value="searchText"
                              Placeholder="Wpisz nazwę i naciśnij Enter"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentAriaLabel="Szukaj"
                              OnAdornmentClick="SearchProducts"
                              OnKeyDown="OnSearchKeyDown"
                              Class="mb-2" />

                <!-- Category chips - horizontal scroll -->
                <div class="mobile-filter-chips">
                    <button type="button"
                            class="filter-chip-mobile @(string.IsNullOrEmpty(selectedCategory) ? "active" : "")"
                            aria-pressed="@(string.IsNullOrEmpty(selectedCategory) ? "true" : "false")"
                            @onclick="@(() => SelectCategory(string.Empty))">
                        Wszystkie
                    </button>
                    @foreach (var cat in GetCategoryChips())
                    {
                        <button type="button"
                                class="filter-chip-mobile @(selectedCategory == cat.Name ? "active" : "")"
                                aria-pressed="@(selectedCategory == cat.Name ? "true" : "false")"
                                @onclick="@(() => SelectCategory(cat.Name))">
                            @cat.Name
                        </button>
                    }
                </div>

                <MudSelect T="Guid?" Label="Wypożyczalnia"
                           Value="selectedTenantId"
                           ValueChanged="OnTenantChangedAsync"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Class="mb-2">
                    @foreach (var tenant in tenants)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)tenant.Id)">@tenant.Name</MudSelectItem>
                    }
                </MudSelect>

                <!-- Location selects -->
                <div class="mobile-filter-row">
                    <MudSelect T="string" Label="Województwo" @bind-Value="SelectedVoivodeship" 
                               Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Clearable="true">
                        @foreach (var v in voivodeships)
                        {
                            <MudSelectItem Value="@v">@v</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" Label="Miasto" @bind-Value="SelectedCity" 
                               Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Clearable="true">
                        @foreach (var c in filteredCities)
                        {
                            <MudSelectItem Value="@c">@c</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <!-- Availability & Sort -->
                <div class="mobile-filter-row">
                    <MudSwitch @bind-Value="ShowOnlyAvailable" Color="Color.Success" Label="Dostępne" />
                    <MudSelect T="string" Label="Sortuj" @bind-Value="SelectedSort" 
                               Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                        <MudSelectItem Value="@("featured")">Polecane</MudSelectItem>
                        @if (userLat.HasValue && userLon.HasValue)
                        {
                            <MudSelectItem Value="@("distance")">Najbliżej</MudSelectItem>
                        }
                        <MudSelectItem Value="@("price-asc")">Najtańsze</MudSelectItem>
                        <MudSelectItem Value="@("price-desc")">Najdroższe</MudSelectItem>
                    </MudSelect>
                </div>

                <MudButton Variant="Variant.Text" Color="Color.Secondary" 
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ClearFilters" Size="Size.Small" FullWidth="true">
                    Resetuj filtry
                </MudButton>
            </div>
        }

        <!-- Mobile Products Grid -->
        @if (isLoading)
        {
            <div class="products-mobile-loading">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <span>Ładowanie...</span>
            </div>
        }
        else if (_loadError is not null)
        {
            <div class="products-mobile-empty" role="alert">
                <span class="empty-icon"><Icon Name="warning" Size="44" /></span>
                <h3>Nie udało się pobrać katalogu</h3>
                <p>@_loadError</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadInitialData">
                    Spróbuj ponownie
                </MudButton>
            </div>
        }
        else if (!filteredProducts.Any())
        {
            <div class="products-mobile-empty">
                <span class="empty-icon"><Icon Name="search" Size="44" /></span>
                <h3>Brak produktów</h3>
                <p>Zmień kryteria wyszukiwania</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ClearFilters">
                    Resetuj filtry
                </MudButton>
            </div>
        }
        else
        {
            <div class="products-mobile-grid">
                @foreach (var product in filteredProducts)
                {
                    var imageUrl = product.GetImageUrl(400);
                    var categoryIcon = GetCategoryIcon(product.Category);
                    
                    <article class="product-mobile-card">
                        <div class="product-mobile-card-image">
                            @if (!string.IsNullOrEmpty(imageUrl))
                            {
                                <img src="@imageUrl"
                                     data-fallback-src="@product.ImageUrl"
                                     alt="@product.Name"
                                     loading="lazy"
                                     onerror="srImg(this)" />
                            }
                            else
                            {
                                <div class="product-mobile-card-placeholder" aria-hidden="true">
                                    <Icon Name="catalog" Size="30" />
                                    <span>Zdjęcie wkrótce</span>
                                </div>
                            }
                            @if (product.IsAvailable && product.AvailableQuantity > 0)
                            {
                                <span class="product-mobile-card-badge available" aria-hidden="true"></span>
                                <span class="sr-only">Dostępny</span>
                            }
                            else
                            {
                                <span class="product-mobile-card-badge unavailable" aria-hidden="true"></span>
                                <span class="sr-only">Niedostępny</span>
                            }
                        </div>
                        <div class="product-mobile-card-info">
                            @if (!string.IsNullOrWhiteSpace(product.Category))
                            {
                                <span class="product-mobile-card-category">@product.Category</span>
                            }
                            <h2 class="product-mobile-card-name">@product.Name</h2>
                            <div class="product-mobile-card-tenant">
                                <span>@TenantDisplayName(product)</span>
                                <span class="product-tenant-city">Odbiór: @product.GetPickupDisplayText()</span>
                            </div>
                            <div class="product-mobile-card-price">
                                <span class="price-main">@product.DailyPrice.PlnInt()</span>
                                <span class="price-period">/dzień</span>
                            </div>
                        </div>
                        <div class="product-mobile-card-actions">
                            <button class="product-mobile-details-btn"
                                    @onclick="@(() => NavigateToProduct(product.Id))"
                                    aria-label="Zobacz szczegóły produktu @product.Name">
                                Zobacz szczegóły
                            </button>
                            <button class="product-mobile-cart-btn"
                                    disabled="@(product.AvailableQuantity <= 0 || !product.IsAvailable)"
                                    @onclick="@(async () => await AddToCart(product))"
                                    aria-label="Dodaj @product.Name do koszyka">
                                <Icon Name="cart-plus" Size="18" />
                            </button>
                        </div>
                    </article>
                }
            </div>

            @if (totalPages > 1)
            {
                <div class="products-mobile-pagination">
                    <MudPagination Count="totalPages"
                                   @bind-Selected="CurrentPage"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   BoundaryCount="1"
                                   MiddleCount="1" />
                </div>
            }
        }
    </div>
}
@* ============================================
   DESKTOP UI - Original design with full features
   ============================================ *@
else
{
<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="py-4">
    
    <!-- =============================================
         HERO SECTION
         ============================================= -->
    <div class="products-hero">
        <div class="products-hero-content">
            <h1 class="products-hero-title">Znajdź swoją przygodę</h1>
            <p class="products-hero-subtitle">
                Przeglądaj nasz katalog profesjonalnego sprzętu sportowego
            </p>
            <div class="products-stats">
                <div class="products-stat">
                    <span class="products-stat-value">@totalProductCount</span>
                    <span class="products-stat-label">@ProductNoun(totalProductCount)</span>
                </div>
                <div class="products-stat">
                    <span class="products-stat-value">@availableProductCount</span>
                    <span class="products-stat-label">@AvailabilityAdjective(availableProductCount)</span>
                </div>
                <div class="products-stat">
                    <span class="products-stat-value">@avgPrice.Pln()</span>
                    <span class="products-stat-label">śr. cena</span>
                </div>
            </div>
        </div>
    </div>

    <!-- =============================================
         FILTERS SECTION
         ============================================= -->
    <div class="products-filters">
        <MudGrid Spacing="3">
            <!-- Location filters FIRST (user request: lokalizacja najpierw) -->
            <MudItem xs="12" md="3">
                <MudSelect T="string" Label="Województwo" @bind-Value="SelectedVoivodeship" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var v in voivodeships)
                    {
                        <MudSelectItem Value="@v">@v</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12" md="3">
                <MudSelect T="string" Label="Miasto" @bind-Value="SelectedCity" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var c in filteredCities)
                    {
                        <MudSelectItem Value="@c">@c</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            
            <!-- Search SECOND -->
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="searchText"
                              Label="Szukaj produktów"
                              Placeholder="Wpisz nazwę i naciśnij Enter"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentAriaLabel="Szukaj"
                              OnAdornmentClick="SearchProducts"
                              OnKeyDown="OnSearchKeyDown"
                              Style="border-radius: 12px;" />
            </MudItem>
            
            <MudItem xs="12" md="2">
                <MudButton Variant="Variant.Text" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ClearFilters"
                           FullWidth="true"
                           Class="products-reset-filter-button"
                           Style="height: 56px;">
                    Resetuj
                </MudButton>
            </MudItem>
            
            <!-- Category chips -->
            <MudItem xs="12">
                <div class="filter-section-title">Kategorie</div>
                <div class="filter-chips">
                    <button type="button"
                            class="filter-chip @(string.IsNullOrEmpty(selectedCategory) ? "active" : "")"
                            aria-pressed="@(string.IsNullOrEmpty(selectedCategory) ? "true" : "false")"
                            @onclick="@(() => SelectCategory(string.Empty))">
                        Wszystkie
                    </button>
                    @foreach (var cat in GetCategoryChips())
                    {
                        <button type="button"
                                class="filter-chip @(selectedCategory == cat.Name ? "active" : "")"
                                aria-pressed="@(selectedCategory == cat.Name ? "true" : "false")"
                                @onclick="@(() => SelectCategory(cat.Name))">
                            @cat.Name
                        </button>
                    }
                </div>
            </MudItem>
            
            <!-- Additional filters row -->
            <MudItem xs="12" md="3">
                <MudSelect T="Guid?" Label="Wypożyczalnia"
                           Value="selectedTenantId"
                           ValueChanged="OnTenantChangedAsync"
                           Variant="Variant.Outlined"
                           Clearable="true">
                    @foreach (var t in filteredTenants)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)t.Id)">@t.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12" md="3">
                <MudSelect T="string" Label="Sortuj" @bind-Value="SelectedSort" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("featured")">Polecane</MudSelectItem>
                    @if (userLat.HasValue && userLon.HasValue)
                    {
                        <MudSelectItem Value="@("distance")">Najbliżej mnie</MudSelectItem>
                    }
                    <MudSelectItem Value="@("price-asc")">Najtańsze</MudSelectItem>
                    <MudSelectItem Value="@("price-desc")">Najdroższe</MudSelectItem>
                    <MudSelectItem Value="@("name")">Nazwa A-Z</MudSelectItem>
                </MudSelect>
            </MudItem>
            
            <MudItem xs="6" md="2">
                <MudNumericField T="decimal"
                                 Label="Cena od"
                                 Variant="Variant.Outlined"
                                 Value="selectedMinPrice"
                                 ValueChanged="OnMinPriceChanged"
                                 Adornment="Adornment.End"
                                 AdornmentText="zł"
                                 Min="@minPrice"
                                 Max="@selectedMaxPrice" />
            </MudItem>
            
            <MudItem xs="6" md="2">
                <MudNumericField T="decimal"
                                 Label="Cena do"
                                 Variant="Variant.Outlined"
                                 Value="selectedMaxPrice"
                                 ValueChanged="OnMaxPriceChanged"
                                 Adornment="Adornment.End"
                                 AdornmentText="zł"
                                 Min="@selectedMinPrice"
                                 Max="@maxPrice" />
            </MudItem>
            
            <MudItem xs="12" md="3">
                <MudSwitch @bind-Value="ShowOnlyAvailable" Color="Color.Success" Label="Tylko dostępne" />
            </MudItem>
        </MudGrid>
    </div>

    <!-- =============================================
         PRODUCTS GRID
         ============================================= -->
    @if (isLoading)
    {
        <div class="products-grid">
            @for (int i = 0; i < 8; i++)
            {
                <div class="product-skeleton">
                    <div class="skeleton-shimmer" style="height: 220px;"></div>
                    <div style="padding: 1.25rem;">
                        <div class="skeleton-shimmer" style="height: 24px; border-radius: 8px; margin-bottom: 0.75rem;"></div>
                        <div class="skeleton-shimmer" style="height: 32px; width: 60%; border-radius: 8px; margin-bottom: 0.75rem;"></div>
                        <div class="skeleton-shimmer" style="height: 44px; border-radius: 12px;"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="products-empty" role="alert">
            <div class="products-empty-icon"><Icon Name="warning" Size="44" /></div>
            <h3 class="products-empty-title">Nie udało się pobrać katalogu</h3>
            <p class="products-empty-text">@_loadError</p>
            <button class="products-reset-btn" @onclick="LoadInitialData">
                Spróbuj ponownie
            </button>
        </div>
    }
    else if (!filteredProducts.Any())
    {
        <div class="products-empty">
            <div class="products-empty-icon"><Icon Name="search" Size="44" /></div>
            <h3 class="products-empty-title">Brak produktów</h3>
            <p class="products-empty-text">Nie znaleźliśmy produktów spełniających Twoje kryteria.</p>
            <button class="products-reset-btn" @onclick="ClearFilters">
                Resetuj filtry
            </button>
        </div>
    }
    else
    {
        <div class="products-grid">
            @foreach (var product in filteredProducts)
            {
                var imageUrl = product.GetImageUrl(400);
                var categoryIcon = GetCategoryIcon(product.Category);
                
                <article class="product-card">
                    <!-- Image section -->
                    <div class="product-card-image">
                        @if (!string.IsNullOrEmpty(imageUrl))
                        {
                            <img src="@imageUrl"
                                 data-fallback-src="@product.ImageUrl"
                                 alt="@product.Name"
                                 loading="lazy"
                                 onerror="srImg(this)" />
                        }
                        else
                        {
                            <div class="product-card-placeholder">
                                <Icon Name="catalog" Size="34" />
                                <span>Zdjęcie wkrótce</span>
                            </div>
                        }
                        
                        <!-- Badges -->
                        <div class="product-card-badges">
                            @if (product.IsAvailable && product.AvailableQuantity > 0)
                            {
                                <span class="product-badge product-badge-available">Dostępny</span>
                            }
                            else
                            {
                                <span class="product-badge product-badge-unavailable">Niedostępny</span>
                            }
                            
                            @if (!string.IsNullOrEmpty(product.Category))
                            {
                                <span class="product-badge product-badge-category">
                                    @product.Category
                                </span>
                            }
                        </div>
                        
                        <!-- Quick actions overlay -->
                        <div class="product-card-actions-overlay">
                            <button class="product-quick-btn product-quick-btn-primary"
                                    disabled="@(product.AvailableQuantity <= 0 || !product.IsAvailable)"
                                    @onclick="@(async () => await AddToCart(product))">
                                Do koszyka
                            </button>
                            <button class="product-quick-btn product-quick-btn-secondary"
                                    @onclick="@(() => NavigateToProduct(product.Id))"
                                    aria-label="Zobacz szczegóły">
                                <Icon Name="eye" Size="16" />
                            </button>
                        </div>
                    </div>
                    
                    <!-- Content section -->
                    <div class="product-card-content">
                        <h2 class="product-card-title">@product.Name</h2>

                        <div class="product-card-tenant">
                            <span class="product-card-tenant-name">@TenantDisplayName(product)</span>
                            <span class="product-card-tenant-city">Odbiór: @product.GetPickupDisplayText()</span>
                        </div>
                        
                        <div class="product-card-price">
                            <span class="product-price-amount">@product.DailyPrice.PlnInt()</span>
                            <span class="product-price-period">/ dzień</span>
                            @if (product.HourlyPrice.HasValue && product.HourlyPrice.Value > 0)
                            {
                                <div class="product-price-hourly">
                                    <span class="product-price-amount-small">@product.HourlyPrice.Value.PlnInt()</span>
                                    <span class="product-price-period-small">/ godz.</span>
                                </div>
                            }
                        </div>
                        
                        <div class="product-card-meta">
                            <div class="product-meta-item">
                                <span>@product.AvailableQuantity szt.</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Footer with button -->
                    <div class="product-card-footer">
                        <button class="product-details-link-btn"
                                @onclick="@(() => NavigateToProduct(product.Id))"
                                aria-label="Zobacz szczegóły produktu @product.Name">
                            Szczegóły
                        </button>
                        <button class="product-add-btn"
                                disabled="@(product.AvailableQuantity <= 0 || !product.IsAvailable)"
                                @onclick="@(async () => await AddToCart(product))">
                            <Icon Name="cart-plus" Size="18" /> Dodaj do koszyka
                        </button>
                    </div>
                </article>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="products-pagination">
                <MudPagination Count="totalPages"
                               @bind-Selected="CurrentPage"
                               Color="Color.Primary"
                               ShowFirstButton="true"
                               ShowLastButton="true"
                               BoundaryCount="1"
                               MiddleCount="3" />
            </div>
        }
    }
</MudContainer>
} @* End of Desktop UI *@

@code {
    // Mobile detection
    private bool _isMobile = false;
    private bool _showMobileFilters = false;
    private DotNetObjectReference<Products>? _dotNetRef;
    
    private void ToggleMobileFilters() => _showMobileFilters = !_showMobileFilters;

    private void OpenMobileTenantFilter() => _showMobileFilters = true;
    
    private bool HasActiveFilters() => 
        !string.IsNullOrEmpty(searchText) || 
        !string.IsNullOrEmpty(selectedCategory) || 
        !string.IsNullOrEmpty(selectedVoivodeship) || 
        !string.IsNullOrEmpty(selectedCity) ||
        selectedTenantId.HasValue ||
        showOnlyAvailable;
    private List<ProductDto> filteredProducts = new();
    private List<string> categories = new();
    private bool isLoading = true;
    private string? _loadError;

    private string searchText = string.Empty;
    private string selectedCategory = string.Empty;
    private int currentPage = 1;
    private int totalPages = 1;
    private const int PageSize = 12;

    private bool showOnlyAvailable;
    private string selectedSort = "featured";
    private decimal minPrice;
    private decimal maxPrice;
    private decimal selectedMinPrice;
    private decimal selectedMaxPrice;
    
    // Location filters
    private List<string> voivodeships = new();
    private List<string> cities = new();
    private List<string> filteredCities = new();
    private List<ProductCatalogLocationFacetDto> marketplaceLocations = new();
    private string? selectedVoivodeship;
    private string? selectedCity;
    
    // Tenant (wypożyczalnia) filter
    private List<TenantOption> tenants = new();
    private List<TenantOption> filteredTenants = new();
    private Guid? selectedTenantId;

    private string SelectedTenantDisplayName => selectedTenantId.HasValue
        ? tenants.FirstOrDefault(tenant => tenant.Id == selectedTenantId.Value)?.Name
            ?? "Wybrana wypożyczalnia"
        : "Wszystkie wypożyczalnie";
    
    // User location (from localStorage - set on map page)
    private double? userLat;
    private double? userLon;
    
    // Stats (loaded once at init)
    private int totalProductCount;

    private static string ProductNoun(int count)
    {
        var absolute = Math.Abs(count);
        var lastTwoDigits = absolute % 100;
        return absolute == 1
            ? "produkt"
            : lastTwoDigits is >= 12 and <= 14
                ? "produktów"
                : absolute % 10 is >= 2 and <= 4
                    ? "produkty"
                    : "produktów";
    }

    private static string AvailabilityAdjective(int count)
    {
        var absolute = Math.Abs(count);
        var lastTwoDigits = absolute % 100;
        return absolute == 1
            ? "dostępny"
            : lastTwoDigits is >= 12 and <= 14
                ? "dostępnych"
                : absolute % 10 is >= 2 and <= 4
                    ? "dostępne"
                    : "dostępnych";
    }

    private int availableProductCount;
    private decimal avgPrice;
    private decimal resultMinPrice;

    [SupplyParameterFromQuery(Name = "search")]
    private string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    private string? CategoryQuery { get; set; }

    [SupplyParameterFromQuery(Name = "tenantId")]
    private string? TenantIdQuery { get; set; }

    private bool _queryParametersApplied;
    private bool _initialDataLoaded;
    private string? _lastSearchQuery;
    private string? _lastCategoryQuery;
    private string? _lastTenantIdQuery;

    private record CategoryChip(string Name, string Icon);
    private sealed record TenantOption(Guid Id, string Name);

    private List<CategoryChip> GetCategoryChips()
    {
        return categories.Select(c => new CategoryChip(c, GetCategoryIcon(c))).ToList();
    }

    private string GetCategoryIcon(string? category) => category?.ToLower() switch
    {
        "narty" or "ski" => "",
        "snowboard" => "",
        "rowery" or "bike" or "rower" => "",
        "sporty wodne" or "water" or "sup" or "kajak" => "",
        "buty" or "buty narciarskie" => "",
        "kaski" or "kask" => "",
        "akcesoria" => "",
        _ => ""
    };

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        currentPage = 1;
        _ = LoadProductsAsync();
    }

    private string SelectedSort
    {
        get => selectedSort;
        set
        {
            var newValue = value ?? "featured";
            if (selectedSort != newValue)
            {
                selectedSort = newValue;
                currentPage = 1;
                _ = LoadProductsAsync();
            }
        }
    }

    private bool ShowOnlyAvailable
    {
        get => showOnlyAvailable;
        set
        {
            if (showOnlyAvailable != value)
            {
                showOnlyAvailable = value;
                currentPage = 1;
                _ = LoadProductsAsync();
            }
        }
    }

    private int CurrentPage
    {
        get => currentPage;
        set
        {
            var clamped = Math.Clamp(value, 1, Math.Max(1, totalPages));
            if (currentPage != clamped)
            {
                currentPage = clamped;
                _ = LoadProductsAsync();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ApplyQueryParameters();
        await LoadInitialData();
        _initialDataLoaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Router zachowuje instancję komponentu przy zmianie samego query stringa.
        // Ponownie pobierz dane tylko wtedy, gdy faktycznie zmienił się filtr z URL.
        if (_initialDataLoaded && ApplyQueryParameters())
        {
            await LoadInitialData();
        }
    }

    private bool ApplyQueryParameters()
    {
        var nextSearch = NormalizeQueryValue(SearchQuery);
        var nextCategory = NormalizeQueryValue(CategoryQuery);
        var nextTenantId = NormalizeTenantId(TenantIdQuery);

        if (_queryParametersApplied &&
            string.Equals(_lastSearchQuery, nextSearch, StringComparison.Ordinal) &&
            string.Equals(_lastCategoryQuery, nextCategory, StringComparison.Ordinal) &&
            string.Equals(_lastTenantIdQuery, nextTenantId, StringComparison.Ordinal))
        {
            return false;
        }

        _lastSearchQuery = nextSearch;
        _lastCategoryQuery = nextCategory;
        _lastTenantIdQuery = nextTenantId;
        _queryParametersApplied = true;

        searchText = nextSearch ?? string.Empty;
        selectedCategory = nextCategory ?? string.Empty;
        selectedTenantId = Guid.TryParse(nextTenantId, out var tenantId) ? tenantId : null;
        currentPage = 1;

        return true;
    }

    private static string? NormalizeQueryValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string? NormalizeTenantId(string? value)
        => Guid.TryParse(value?.Trim(), out var tenantId) && tenantId != Guid.Empty
            ? tenantId.ToString("D")
            : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Setup mobile detection
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("setupMobileDetection", _dotNetRef);
            
            await LoadUserLocationFromStorage();
        }
    }
    
    [JSInvokable]
    public void OnScreenResize(bool isMobile)
    {
        if (_isMobile != isMobile)
        {
            _isMobile = isMobile;
            InvokeAsync(StateHasChanged);
        }
    }
    
    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("removeMobileDetection");
        }
        catch { }
        _dotNetRef?.Dispose();
    }

    private async Task LoadUserLocationFromStorage()
    {
        try
        {
            var location = await JS.InvokeAsync<UserLocationData?>("leafletMap.getUserLocation");
            if (location != null && location.Lat != 0 && location.Lon != 0)
            {
                userLat = location.Lat;
                userLon = location.Lon;
                
                // If user has location, default to distance sorting
                if (selectedSort == "featured")
                {
                    selectedSort = "distance";
                }
                
                await LoadProductsAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user location: {ex.Message}");
        }
    }

    private class UserLocationData
    {
        public double Lat { get; set; }
        public double Lon { get; set; }
    }

    private async Task LoadInitialData()
    {
        isLoading = true;
        _loadError = null;
        try
        {
            var facets = await ApiService.GetProductCatalogFacetsAsync();
            marketplaceLocations = facets.Locations;

            categories = facets.Categories;

            voivodeships = facets.Locations
                .Where(location => !string.IsNullOrWhiteSpace(location.Voivodeship))
                .Select(location => location.Voivodeship!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(v => v)
                .ToList();

            cities = facets.Locations
                .Where(location => !string.IsNullOrWhiteSpace(location.City))
                .Select(location => location.City!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(c => c)
                .ToList();
            
            UpdateFilteredCities();

            tenants = facets.Tenants
                .Where(tenant => tenant.TenantId != Guid.Empty && !string.IsNullOrWhiteSpace(tenant.Name))
                .Select(tenant => new TenantOption(tenant.TenantId, tenant.Name))
                .OrderBy(t => t.Name)
                .ToList();
            
            filteredTenants = tenants;

            minPrice = facets.MinimumPrice;
            maxPrice = facets.MaximumPrice;
            selectedMinPrice = minPrice;
            selectedMaxPrice = maxPrice;
            resultMinPrice = minPrice;
            totalProductCount = facets.TotalCount;
            availableProductCount = facets.AvailableCount;
            avgPrice = facets.AveragePrice;

            // Now load first page with actual filters
            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            _loadError = "Sprawdź połączenie i ponów próbę.";
            Snackbar.Add("Nie udało się załadować produktów.", Severity.Error);
            Console.Error.WriteLine($"Nie udało się załadować katalogu: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadProductsAsync()
    {
        isLoading = true;
        _loadError = null;
        try
        {
            var filter = new ProductFilterRequest
            {
                Page = currentPage,
                PageSize = PageSize,
                Search = string.IsNullOrWhiteSpace(searchText) ? null : searchText,
                Category = string.IsNullOrWhiteSpace(selectedCategory) ? null : selectedCategory,
                City = string.IsNullOrWhiteSpace(selectedCity) ? null : selectedCity,
                Voivodeship = string.IsNullOrWhiteSpace(selectedVoivodeship) ? null : selectedVoivodeship,
                TenantId = selectedTenantId,
                MinPrice = selectedMinPrice > minPrice ? selectedMinPrice : null,
                MaxPrice = selectedMaxPrice < maxPrice ? selectedMaxPrice : null,
                Available = showOnlyAvailable ? true : null,
                Sort = selectedSort,
                UserLat = userLat,
                UserLon = userLon
            };

            var response = await ApiService.GetProductsPagedAsync(filter);
            
            filteredProducts = response.Items;
            totalProductCount = response.TotalCount;
            availableProductCount = response.AvailableCount;
            avgPrice = response.AveragePrice;
            resultMinPrice = response.MinimumPrice;
            totalPages = response.TotalPages > 0 ? response.TotalPages : 1;
            currentPage = Math.Clamp(response.Page, 1, totalPages);
        }
        catch (Exception ex)
        {
            _loadError = "Sprawdź połączenie i ponów próbę.";
            Snackbar.Add("Nie udało się odświeżyć katalogu.", Severity.Error);
            Console.Error.WriteLine($"Nie udało się odświeżyć katalogu: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SearchProducts()
    {
        currentPage = 1;
        _ = LoadProductsAsync();
    }

    private async Task ClearFilters()
    {
        searchText = string.Empty;
        selectedCategory = string.Empty;
        selectedVoivodeship = null;
        selectedCity = null;
        selectedTenantId = null;
        filteredCities = cities;
        filteredTenants = tenants;
        selectedSort = "featured";
        showOnlyAvailable = false;
        currentPage = 1;
        selectedMinPrice = minPrice;
        selectedMaxPrice = maxPrice;
        await TenantService.ClearSelectedTenantAsync();
        await LoadProductsAsync();
    }

    private string? SelectedVoivodeship
    {
        get => selectedVoivodeship;
        set
        {
            if (selectedVoivodeship != value)
            {
                selectedVoivodeship = value;
                UpdateFilteredCities();
                // Clear city if voivodeship changed
                if (!string.IsNullOrWhiteSpace(selectedCity))
                {
                    selectedCity = null;
                }
                currentPage = 1;
                _ = LoadProductsAsync();
            }
        }
    }

    private string? SelectedCity
    {
        get => selectedCity;
        set
        {
            if (selectedCity != value)
            {
                selectedCity = value;
                currentPage = 1;
                _ = LoadProductsAsync();
            }
        }
    }

    private void UpdateFilteredCities()
    {
        filteredCities = string.IsNullOrWhiteSpace(selectedVoivodeship)
            ? cities
            : marketplaceLocations
                .Where(location =>
                    !string.IsNullOrWhiteSpace(location.City) &&
                    string.Equals(location.Voivodeship, selectedVoivodeship, StringComparison.OrdinalIgnoreCase))
                .Select(location => location.City!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(city => city, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
    }

    private async Task OnTenantChangedAsync(Guid? tenantId)
    {
        if (selectedTenantId == tenantId)
        {
            return;
        }

        selectedTenantId = tenantId;
        currentPage = 1;

        var selectedTenant = tenantId.HasValue
            ? tenants.FirstOrDefault(option => option.Id == tenantId.Value)
            : null;

        if (selectedTenant is null)
        {
            await TenantService.ClearSelectedTenantAsync();
        }
        else
        {
            await TenantService.SetSelectedTenantAsync(
                selectedTenant.Id.ToString("D"), selectedTenant.Name);
        }

        await LoadProductsAsync();
    }

    private void OnMinPriceChanged(decimal value)
    {
        selectedMinPrice = Math.Clamp(value, minPrice, maxPrice);
        currentPage = 1;
        _ = LoadProductsAsync();
    }

    private void OnMaxPriceChanged(decimal value)
    {
        selectedMaxPrice = Math.Clamp(value, minPrice, maxPrice);
        currentPage = 1;
        _ = LoadProductsAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            SearchProducts();
            await Task.CompletedTask;
        }
    }

    private async Task AddToCart(ProductDto product)
    {
        var todayInPoland = PolishRentalTime.TodayLocal;
        var startDate = todayInPoland.AddDays(1).AddHours(9);
        var endDate = todayInPoland.AddDays(2).AddHours(17);
        try
        {
            await CartService.AddToCartAsync(product, 1, startDate, endDate);
            var holdSecured = await CartService.EnsureHoldsAsync();
            var addedItem = CartService.GetCart().Items.FirstOrDefault(item => item.ProductId == product.Id);

            if (!holdSecured || addedItem?.HoldId is null)
            {
                Snackbar.Add(
                    CartService.LastHoldError
                    ?? $"Nie udało się zarezerwować produktu {product.Name}. Produkt pozostał w koszyku bez aktywnej rezerwacji — zmień termin lub spróbuj ponownie.",
                    Severity.Error);
                return;
            }

            Snackbar.Add(
                $"{product.Name} dodany do koszyka w {TenantDisplayName(product)} na termin " +
                $"{startDate:dd.MM, HH:mm}–{endDate:dd.MM, HH:mm}. Termin możesz zmienić w koszyku.",
                Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add(
                $"Nie udało się dodać produktu {product.Name} do koszyka. Spróbuj ponownie.",
                Severity.Error);
        }
    }

    private static string TenantDisplayName(ProductDto product) =>
        string.IsNullOrWhiteSpace(product.TenantName) ? "Wypożyczalnia" : product.TenantName;

    private Task AddToCartFromDialog(ProductDto product) => AddToCart(product);

    private async Task ViewProduct(ProductDto product)
    {
        var parameters = new DialogParameters
        {
            ["Product"] = product,
            ["AddToCart"] = EventCallback.Factory.Create<ProductDto>(this, AddToCartFromDialog)
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        await DialogService.ShowAsync<ProductDetailsDialog>("Szczegóły produktu", parameters, options);
    }

