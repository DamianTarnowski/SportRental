    private async Task LookupCustomerButtonAsync()
    {
        await LookupCustomerAsync(showFeedback: true);
    }

    private async Task LookupCustomerAsync(bool showFeedback)
    {
        if (_isLookupInProgress) return;

        var email = _customer.Email?.Trim();
        if (string.IsNullOrWhiteSpace(email))
        {
            _existingCustomerId = null;
            _lastLookupEmail = null;
            return;
        }

        if (string.Equals(email, _lastLookupEmail, StringComparison.OrdinalIgnoreCase) && _existingCustomerId.HasValue && !showFeedback)
        {
            return;
        }

        _isLookupInProgress = true;
        try
        {
            var existing = await Api.FindCustomerByEmailAsync(email);
            if (existing is null)
            {
                _existingCustomerId = null;
                _lastLookupEmail = email;
                if (showFeedback)
                {
                    Snackbar.Add("Nie znaleziono klienta z podanym adresem email.", Severity.Info);
                }
                return;
            }

            _existingCustomerId = existing.Id;
            _lastLookupEmail = existing.Email;
            _customer.FullName = existing.FullName;
            _customer.Email = existing.Email;
            _customer.PhoneNumber = existing.PhoneNumber;
            _customer.Address = existing.Address;
            _customer.DocumentNumber = existing.DocumentNumber;
            _customer.Notes = existing.Notes;
            await InvokeAsync(StateHasChanged);

            if (showFeedback)
            {
                Snackbar.Add("Załadowano dane istniejącego klienta.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            if (showFeedback)
            {
                Snackbar.Add("Nie udało się sprawdzić danych klienta. Spróbuj ponownie.", Severity.Error);
                Console.Error.WriteLine($"Customer lookup failed: {ex.GetType().Name}");
            }
        }
        finally
        {
            _isLookupInProgress = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        try
        {
            if (!AllLegalAccepted)
            {
                Snackbar.Add("Zaakceptuj regulamin platformy, politykę prywatności i regulamin każdej wypożyczalni.", Severity.Warning);
                return;
            }

            if (_cart.Items.Count == 0)
            {
                Snackbar.Add("Koszyk jest pusty", Severity.Warning);
                return;
            }

            if (_hasInvalidGroups)
            {
                Snackbar.Add("Produkty z jednego punktu odbioru muszą mieć wspólny termin i typ wynajmu.", Severity.Error);
                return;
            }

            _customer.FullName = _customer.FullName.Trim();
            _customer.Email = _customer.Email.Trim();
            _customer.PhoneNumber = _customer.PhoneNumber?.Trim() ?? string.Empty;
            if (!_customerEditContext.Validate())
            {
                Snackbar.Add("Popraw oznaczone dane klienta.", Severity.Error);
                return;
            }

            foreach (var group in CartGroups)
            {
                var selectedTerm = group.Items[0];
                if (!PolishRentalTime.TryToUtc(selectedTerm.StartDate, out var selectedStartUtc) ||
                    !PolishRentalTime.TryToUtc(selectedTerm.EndDate, out _))
                {
                    Snackbar.Add($"Termin dla {group.Name} przypada na nieistniejącą godzinę zmiany czasu.", Severity.Error);
                    return;
                }

                if (!PolishRentalTime.IsStartSafelyInFuture(selectedStartUtc, DateTime.UtcNow))
                {
                    Snackbar.Add($"Termin dla {group.Name} musi zaczynać się co najmniej 2 minuty w przyszłości.", Severity.Error);
                    return;
                }
            }

            await CartService.RefreshHoldsIfNeededAsync();
            var holdsOk = await CartService.EnsureHoldsAsync();
            if (!holdsOk)
            {
                Snackbar.Add("Nie udało się odświeżyć/utworzyć holdów. Spróbuj ponownie.", Severity.Error);
                return;
            }

            var normalizedEmail = _customer.Email?.Trim();
            CustomerDto? customer = null;

            if (!string.IsNullOrWhiteSpace(normalizedEmail) &&
                _existingCustomerId.HasValue &&
                string.Equals(normalizedEmail, _lastLookupEmail, StringComparison.OrdinalIgnoreCase))
            {
                try
                {
                    customer = await Api.UpdateCustomerAsync(_existingCustomerId.Value, new CreateCustomerRequest
                    {
                        FullName = _customer.FullName,
                        Email = _customer.Email!,
                        PhoneNumber = _customer.PhoneNumber,
                        Address = _customer.Address,
                        DocumentNumber = _customer.DocumentNumber,
                        Notes = _customer.Notes
                    });
                }
                catch (Exception ex)
                {
                    Snackbar.Add("Nie udało się zaktualizować danych klienta. Spróbuj ponownie.", Severity.Error);
                    Console.Error.WriteLine($"Customer update failed: {ex.GetType().Name}");
                    return;
                }

                if (customer is null)
                {
                    _existingCustomerId = null;
                    _lastLookupEmail = null;
                }
            }

            if (customer is null)
            {
                // Dla gości (anonimowy checkout) uzyskujemy customer-session token przez /api/auth/guest-session,
                // który wymusza auth na dalszych endpointach (my-rentals, rentals, PUT customers).
                try
                {
                    var guestAuth = await AuthStateProvider.GetAuthenticationStateAsync();
                    var alreadyAuthenticated = guestAuth.User.Identity?.IsAuthenticated == true;

                    if (alreadyAuthenticated)
                    {
                        var customerClaim = guestAuth.User.FindFirst("customer-id")?.Value;
                        if (Guid.TryParse(customerClaim, out var authenticatedCustomerId))
                            customer = await Api.GetCustomerAsync(authenticatedCustomerId);

                        if (customer is null)
                        {
                            Snackbar.Add("Nie udało się odczytać profilu zalogowanego klienta. Wyloguj się i spróbuj ponownie.", Severity.Error);
                            return;
                        }
                    }
                    else
                    {
                        var guest = await Api.CreateGuestSessionAsync(new GuestSessionPayload
                        {
                            FullName = _customer.FullName,
                            Email = _customer.Email!,
                            PhoneNumber = _customer.PhoneNumber,
                            Address = _customer.Address,
                            DocumentNumber = _customer.DocumentNumber,
                            Notes = _customer.Notes
                        });
                        if (guest is null)
                        {
                            Snackbar.Add("Nie udało się utworzyć sesji gościa. Jeśli masz już konto — zaloguj się.", Severity.Error);
                            return;
                        }
                        // SEC-009: serwer ustawił HttpOnly cookie — zapisujemy tylko id/email do UI.
                        await ((SportRental.Client.Services.ApiAuthenticationStateProvider)AuthStateProvider)
                            .MarkUserAsAuthenticated(guest.CustomerId.ToString(), guest.Email);

                        customer = new CustomerDto
                        {
                            Id = guest.CustomerId,
                            FullName = guest.FullName,
                            Email = guest.Email,
                            PhoneNumber = _customer.PhoneNumber ?? string.Empty,
                            Address = _customer.Address,
                            DocumentNumber = _customer.DocumentNumber,
                            Notes = _customer.Notes
                        };
                    }
                }
                catch (Exception ex)
                {
                    Snackbar.Add("Nie udało się zapisać danych klienta. Spróbuj ponownie.", Severity.Error);
                    Console.Error.WriteLine($"Customer create failed: {ex.GetType().Name}");
                    return;
                }
            }

            if (customer is null)
            {
                Snackbar.Add("Nie udało się otrzymać danych klienta.", Severity.Error);
                return;
            }

            var customerId = customer.Id;
            _existingCustomerId = customer.Id;
            _lastLookupEmail = customer.Email;
            _customer.FullName = customer.FullName;
            _customer.Email = customer.Email;
            _customer.PhoneNumber = customer.PhoneNumber;
            _customer.Address = customer.Address;
            _customer.DocumentNumber = customer.DocumentNumber;
            _customer.Notes = customer.Notes;

            await Session.SetCustomerAsync(customer);

            var first = CartGroups[0].Items[0];
            var startUtc = PolishRentalTime.ToUtc(first.StartDate);
            var endUtc = PolishRentalTime.ToUtc(first.EndDate);

            PaymentQuoteResponse quote;
            try
            {
                quote = await Api.GetPaymentQuoteAsync(BuildPaymentQuoteRequest());
                _quote = quote;
                ReconcileAcceptedRentalTerms(quote);
                _quoteError = null;
                if (!AllLegalAccepted)
                {
                    Snackbar.Add("Regulamin jednej z wypożyczalni zmienił się. Przeczytaj i zaakceptuj aktualną wersję.", Severity.Warning);
                    return;
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add("Nie udało się obliczyć płatności. Sprawdź koszyk i spróbuj ponownie.", Severity.Error);
                Console.Error.WriteLine($"Payment quote failed: {ex.GetType().Name}");
                return;
            }

            CheckoutSessionResponse session;
            try
            {
                _isPaymentInProgress = true;
                
                var customerEmail = _customer?.Email ?? "";
                
                var holdSessionId = await CartService.GetHoldSessionIdAsync();
                session = await Api.CreateCheckoutSessionAsync(new CreateCheckoutSessionRequest(
                    StartDateUtc: startUtc,
                    EndDateUtc: endUtc,
                    Items: _cart.Items.Select(i => new CheckoutItem(i.ProductId, i.Quantity, i.HoldId)).ToList(),
                    CustomerEmail: customerEmail,
                    CustomerId: customerId,
                    RentalType: first.RentalType,
                    HoursRented: first.HoursRented,
                    Notes: _notes,
                    HoldSessionId: holdSessionId,
                    AcceptedTermsVersion: LegalDocumentVersions.Terms,
                    AcknowledgedPrivacyVersion: LegalDocumentVersions.Privacy,
                    RentalGroups: CartGroups.Select(group =>
                    {
                        var terms = group.Items[0];
                        var tenantQuote = quote.Tenants.Single(tenant => tenant.TenantId == group.TenantId);
                        return new CheckoutRentalGroupRequest(
                            group.TenantId,
                            PolishRentalTime.ToUtc(terms.StartDate),
                            PolishRentalTime.ToUtc(terms.EndDate),
                            group.Items.Select(item => new CheckoutItem(
                                item.ProductId,
                                item.Quantity,
                                item.HoldId)).ToList(),
                            terms.RentalType,
                            terms.HoursRented,
                            tenantQuote.RentalTerms.ContentHash);
                    }).ToList()
                ));

                // Backend przedłuża holdy na cały czas życia sesji Stripe. Zapisujemy
                // ten sam termin lokalnie przed opuszczeniem WASM, aby powrót z anulowanej
                // płatności nie uznał własnych holdów za wygasłe i nie tworzył kolizji.
                var checkoutHoldIds = _cart.Items
                    .Where(item => item.HoldId.HasValue)
                    .Select(item => item.HoldId!.Value)
                    .ToArray();
                await CartService.UpdateHoldExpirationsAsync(
                    checkoutHoldIds,
                    session.HoldExpiresAtUtc ?? session.ExpiresAt);
                
                Snackbar.Add("Przekierowanie do Stripe...", Severity.Info);
            }
            catch (Exception ex)
            {
                Snackbar.Add("Nie udało się rozpocząć płatności. Spróbuj ponownie za chwilę.", Severity.Error);
                Console.Error.WriteLine($"Checkout session failed: {ex.GetType().Name}");
                _isPaymentInProgress = false;
                return;
            }

            Nav.NavigateTo(session.Url, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Nie udało się dokończyć zamówienia. Koszyk pozostał bez zmian.", Severity.Error);
            Console.Error.WriteLine($"Checkout submit failed: {ex.GetType().Name}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void StartRefreshLoop()
    {
        _refreshCts = new CancellationTokenSource();
        var token = _refreshCts.Token;
        _refreshLoop = Task.Run(async () =>
        {
            try
            {
                while (!token.IsCancellationRequested)
                {
                    await CartService.RefreshHoldsIfNeededAsync();
                    await RefreshPaymentSummaryAsync();
                    await Task.Delay(TimeSpan.FromSeconds(60), token);
                }
            }
            catch (TaskCanceledException) { }
        }, token);
    }

    public async ValueTask DisposeAsync()
    {
        CartService.CartChanged -= OnCartChanged;
        _refreshCts?.Cancel();
        try
        {
            await JS.InvokeVoidAsync("removeMobileDetection");
        }
        catch { }
        _dotNetRef?.Dispose();
    }

