@page "/checkout"
@implements IAsyncDisposable
@using System.ComponentModel.DataAnnotations
@using SportRental.Shared.Models
@using SportRental.Shared.Legal
@using CartModel = SportRental.Shared.Models.Cart
@using SportRental.Shared.Services
@using SportRental.Shared.Components
@using SportRental.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject ICartService CartService
@inject IApiService Api
@inject ICustomerSessionService Session
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Finalizacja zamówienia — RentSpot</PageTitle>

@* Payment loading overlay - shared *@
@if (_isPaymentInProgress)
{
    <div class="checkout-overlay">
        <div class="checkout-overlay-content">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <h2>Przekierowanie do płatności...</h2>
            <p>Proszę czekać</p>
        </div>
    </div>
}

@* ============================================
   MOBILE UI - Step-by-step checkout
   ============================================ *@
@if (_isMobile)
{
    <div class="checkout-mobile">
        <!-- Mobile Header -->
        <div class="checkout-mobile-header">
            <div class="checkout-mobile-title">
                <h1>Zamówienie</h1>
            </div>
            <ol class="checkout-mobile-steps" aria-label="Postęp zamówienia">
                <li class="step done" aria-label="Krok 1 z 3: koszyk zakończony">1</li>
                <li class="step-line" aria-hidden="true"></li>
                <li class="step active" aria-current="step" aria-label="Krok 2 z 3: dane i warunki">2</li>
                <li class="step-line" aria-hidden="true"></li>
                <li class="step" aria-label="Krok 3 z 3: płatność">3</li>
            </ol>
        </div>

        @if (_cart.Items.Count == 0)
        {
            <div class="checkout-mobile-empty">
                <span class="empty-icon"><Icon Name="cart" Size="44" /></span>
                <h2>Pusty koszyk</h2>
                <p>Dodaj produkty do koszyka</p>
                <a href="products" class="checkout-mobile-cta">Przeglądaj katalog</a>
            </div>
        }
        else
        {
            <!-- Cart Summary - Collapsible -->
            <div class="checkout-mobile-section">
                <button class="checkout-mobile-section-header"
                        @onclick="() => _showMobileItems = !_showMobileItems"
                        aria-expanded="@(_showMobileItems ? "true" : "false")"
                        aria-controls="checkout-mobile-items">
                    <span>Produkty (@_cart.TotalItems)</span>
                    <span class="section-toggle">@(_showMobileItems ? "▲" : "▼")</span>
                </button>
                @if (_showMobileItems)
                {
                    <div class="checkout-mobile-items" id="checkout-mobile-items">
                        @foreach (var group in CartGroups)
                        {
                            <section class="checkout-mobile-rental-group">
                                <header>
                                    <div>
                                        <strong>@group.Name</strong>
                                        <span>@FormatCartPickup(group)</span>
                                    </div>
                                    @if (CartGroups.Count > 1)
                                    {
                                        <span class="checkout-separate-reservation">Osobna rezerwacja</span>
                                    }
                                </header>
                                <div class="checkout-mobile-group-period">@FormatCartGroupPeriod(group)</div>
                                @foreach (var item in group.Items)
                                {
                                    <div class="checkout-mobile-item">
                                        <span class="item-name">@item.ProductName</span>
                                        <span class="item-qty">x@(item.Quantity)</span>
                                        <span class="item-price">@QuotedItemSubtotal(item.ProductId).Pln()</span>
                                    </div>
                                }
                            </section>
                        }
                    </div>
                }
                @if (_hasInvalidGroups)
                {
                    <div class="checkout-mobile-warning">
                        Produkty z jednego punktu mają niespójny termin. Wróć do koszyka i popraw dane.
                    </div>
                }
            </div>

            <!-- Customer Form -->
            <div class="checkout-mobile-section">
                <div class="checkout-mobile-section-title">Twoje dane</div>
                <EditForm EditContext="_customerEditContext">
                    <DataAnnotationsValidator />
                    <div class="checkout-mobile-form">
                        <div class="form-group">
                            <label for="checkout-mobile-fullname">Imię i nazwisko *</label>
                            <InputText id="checkout-mobile-fullname" @bind-Value="_customer.FullName" placeholder="Jan Kowalski" />
                            <ValidationMessage For="@(() => _customer.FullName)" />
                        </div>
                        <div class="form-group-row">
                            <div class="form-group flex-1">
                                <label for="checkout-mobile-email">Email *</label>
                                <InputText id="checkout-mobile-email" @bind-Value="_customer.Email" type="email"
                                           @onfocusout="HandleEmailBlur" placeholder="jan@example.com" />
                                <ValidationMessage For="@(() => _customer.Email)" />
                            </div>
                            @if (_canLookupOwnProfile)
                            {
                                <button type="button" class="lookup-btn" aria-label="Odśwież dane profilu"
                                        disabled="@(!CanSearchExisting || _isLookupInProgress)"
                                        @onclick="LookupCustomerButtonAsync">
                                    <Icon Name="search" Size="20" />
                                </button>
                            }
                        </div>
                        <div class="form-group">
                            <PhoneInput @bind-Value="_customer.PhoneNumber" Label="Numer telefonu *" Required="true"
                                        Variant="MudBlazor.Variant.Outlined" />
                            <ValidationMessage For="@(() => _customer.PhoneNumber)" />
                        </div>
                        <div class="form-group">
                            <label for="checkout-mobile-address">Adres</label>
                            <InputTextArea id="checkout-mobile-address" @bind-Value="_customer.Address" rows="2" placeholder="ul. Sportowa 123" />
                            <ValidationMessage For="@(() => _customer.Address)" />
                        </div>
                        <div class="form-group">
                            <label for="checkout-mobile-notes">Uwagi</label>
                            <InputTextArea id="checkout-mobile-notes" @bind-Value="_notes" rows="2" placeholder="Dodatkowe informacje..." />
                        </div>
                    </div>
                </EditForm>
            </div>

            @if (_quote is not null)
            {
                <div class="checkout-mobile-section">
                    <div class="checkout-mobile-section-title">
                        @PolishCount(_quote.Tenants.Count, "wypożyczalnia i jej warunki", "wypożyczalnie i ich warunki", "wypożyczalni i ich warunki")
                    </div>
                    <div class="checkout-rental-groups-summary checkout-rental-groups-summary-mobile">
                        @foreach (var tenant in _quote.Tenants)
                        {
                            <article class="checkout-rental-group-summary">
                                <div class="checkout-rental-group-heading">
                                    <div>
                                        <strong>@tenant.TenantName</strong>
                                        <span>@FormatPickup(tenant)</span>
                                    </div>
                                    @if (_quote.Tenants.Count > 1)
                                    {
                                        <span class="checkout-separate-reservation">Osobna rezerwacja</span>
                                    }
                                </div>
                                <div class="checkout-rental-group-period">@FormatRentalPeriod(tenant)</div>
                                <div class="checkout-rental-group-amounts">
                                    <span>Wynajem: <strong>@tenant.TotalAmount.Pln()</strong></span>
                                    <span>Depozyt: <strong>@tenant.DepositAmount.Pln()</strong></span>
                                </div>
                                <details class="checkout-rental-terms">
                                    <summary>
                                        @tenant.RentalTerms.Title
                                        @if (tenant.RentalTerms.UsesPlatformDefault)
                                        {
                                            <span>standard RentSpot</span>
                                        }
                                    </summary>
                                    @if (!string.IsNullOrWhiteSpace(tenant.RentalTerms.Content))
                                    {
                                        <div class="checkout-rental-terms-content">@tenant.RentalTerms.Content</div>
                                    }
                                </details>
                                <label class="checkout-tenant-legal-ack">
                                    <input type="checkbox"
                                           checked="@IsTenantTermsAccepted(tenant)"
                                           @onchange="@(args => OnTenantTermsAcceptanceChanged(tenant, args))" />
                                    <span>Akceptuję regulamin wypożyczalni @tenant.TenantName.</span>
                                </label>
                            </article>
                        }
                    </div>
                </div>
            }

            <!-- Payment Summary - Sticky Bottom -->
            <div class="checkout-mobile-summary">
                @if (_quoteError is not null)
                {
                    <div class="checkout-mobile-error">
                        @_quoteError
                        <button @onclick="RefreshPaymentSummaryAsync">Odśwież</button>
                    </div>
                }
                else if (_quote is null)
                {
                    <div class="checkout-mobile-loading">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                        Obliczanie...
                    </div>
                }
                else
                {
                    <div class="checkout-mobile-summary-row highlight">
                        <span>Depozyt płatny teraz</span>
                        <span class="summary-amount">@_quote.DepositAmount.Pln()</span>
                    </div>
                    <div class="checkout-mobile-summary-row">
                        <span>Cena wynajmu (płatna osobno)</span>
                        <span>@_quote.TotalAmount.Pln()</span>
                    </div>
                    <p class="checkout-mobile-secure">Depozyt jest zwrotny i nie pomniejsza ceny wynajmu.</p>

                }
                <label class="checkout-legal-ack">
                    <input type="checkbox" @bind="_acceptPlatformLegal" />
                    <span>
                        Akceptuję <a href="terms" target="_blank" rel="noopener">regulamin platformy</a> i potwierdzam
                        zapoznanie się z <a href="privacy" target="_blank" rel="noopener">polityką prywatności</a>.
                    </span>
                </label>
                <button class="checkout-mobile-submit" 
                        disabled="@(_isSubmitting || _isPaymentInProgress || !AllLegalAccepted || _cart.Items.Count == 0 || _hasInvalidGroups || _quote is null || _quoteError is not null)"
                        @onclick="SubmitAsync">
                    @if (_isSubmitting)
                    {
                        <span>Przetwarzanie...</span>
                    }
                    else
                    {
                        <span>Zapłać depozyt @_quote?.DepositAmount.Pln()</span>
                    }
                </button>
                <p class="checkout-mobile-secure">Bezpieczna płatność Stripe</p>
            </div>
        }
    </div>
}
@* ============================================
   DESKTOP UI - Original design
   ============================================ *@
else
{
<div class="checkout-container">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="checkout-header">
            <h1>Finalizacja zamówienia</h1>
            <p>Ostatni krok - sprawdź szczegóły i dokonaj płatności</p>
            <div class="checkout-steps">
                <div class="checkout-step">
                    <span class="checkout-step-number">1</span>
                    <span>Koszyk</span>
                </div>
                <div class="checkout-step active">
                    <span class="checkout-step-number">2</span>
                    <span>Finalizacja</span>
                </div>
                <div class="checkout-step">
                    <span class="checkout-step-number">3</span>
                    <span>Płatność</span>
                </div>
            </div>
        </div>

        @if (_cart.Items.Count == 0)
        {
            <div class="text-center py-20 bg-white rounded-3xl shadow-sm">
                <div class="flex justify-center mb-6"><Icon Name="cart" Size="64" /></div>
                <h2 class="text-2xl font-bold text-gray-800 mb-3">Koszyk jest pusty</h2>
                <p class="text-gray-600 mb-8">Dodaj produkty do koszyka aby kontynuować</p>
                <a href="products" class="checkout-submit-btn" style="max-width: 280px; margin: 0 auto; text-decoration: none;">
                    Przeglądaj katalog
                </a>
            </div>
        }
        else
        {
            <div class="checkout-grid">
                <!-- Items List -->
                <div class="checkout-items-card">
                    <h2>@PolishCount(CartGroups.Count, "rezerwacja", "osobne rezerwacje", "osobnych rezerwacji")</h2>
                    @if (CartGroups.Count > 1)
                    {
                        <div class="checkout-marketplace-notice">
                            Każda wypożyczalnia odpowiada za własny sprzęt, termin i punkt odbioru. Depozyty opłacisz razem w Stripe.
                        </div>
                    }
                    
                    @foreach (var group in CartGroups)
                    {
                        <section class="checkout-tenant-items">
                            <header class="checkout-tenant-items-header">
                                <div>
                                    <h3>@group.Name</h3>
                                    <p>@FormatCartPickup(group)</p>
                                    <p>@FormatCartGroupPeriod(group)</p>
                                </div>
                                @if (CartGroups.Count > 1)
                                {
                                    <span class="checkout-separate-reservation">Osobna rezerwacja</span>
                                }
                            </header>

                            @foreach (var item in group.Items)
                            {
                                <div class="checkout-item">
                                    <div style="flex: 1;">
                                        <div class="checkout-item-name">@item.ProductName</div>
                                        <div class="checkout-item-details">
                                            @if (item.RentalType == RentalTypeDto.Hourly && item.HoursRented.HasValue)
                                            {
                                                <span>@item.Quantity szt. × @item.HoursRented.Value godz. (godzinowy)</span>
                                            }
                                            else
                                            {
                                                <span>@item.Quantity szt. × @item.TotalDays dni</span>
                                            }
                                        </div>
                                        @if (item.HoldId is not null)
                                        {
                                            <span class="inline-block mt-1 px-2 py-1 bg-blue-50 text-blue-600 text-xs rounded-lg">
                                                Zarezerwowany do @FormatPolishTime(item.HoldExpiresAtUtc, "HH:mm:ss")
                                            </span>
                                        }
                                    </div>
                                    <div class="checkout-item-price">@QuotedItemSubtotal(item.ProductId).Pln()</div>
                                    <button class="checkout-remove-btn" @onclick="@(() => RemoveFromCart(item.ProductId))" title="Usuń z zamówienia" aria-label="Usuń pozycję">
                                        <Icon Name="trash" Size="20" />
                                    </button>
                                </div>
                            }
                        </section>
                    }

                    @if (_hasInvalidGroups)
                    {
                        <div class="mt-4 p-4 bg-yellow-50 border border-yellow-200 rounded-xl text-yellow-800">
                            Produkty z jednego punktu mają niespójny termin. Wróć do koszyka i popraw dane.
                        </div>
                    }
                </div>

                <!-- Form & Summary -->
                <div class="checkout-form-card">
                    <h2>Dane do rezerwacji</h2>

                    <EditForm EditContext="_customerEditContext">
                        <DataAnnotationsValidator />
                        
                        <div class="space-y-4">
                            <div>
                                <label for="checkout-fullname" class="block text-sm font-medium text-gray-700 mb-1">Imię i nazwisko *</label>
                                <InputText id="checkout-fullname" @bind-Value="_customer.FullName"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:outline-none"
                                           placeholder="Jan Kowalski" />
                                <ValidationMessage For="@(() => _customer.FullName)" />
                            </div>

                            <div class="flex gap-2">
                                <div class="flex-1">
                                    <label for="checkout-email" class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
                                    <InputText id="checkout-email" @bind-Value="_customer.Email" type="email"
                                               @onfocusout="HandleEmailBlur"
                                               class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:outline-none"
                                               placeholder="jan@example.com" />
                                    <ValidationMessage For="@(() => _customer.Email)" />
                                </div>
                                @if (_canLookupOwnProfile)
                                {
                                    <button type="button" aria-label="Odśwież dane profilu"
                                            class="self-end px-4 py-3 bg-gray-100 hover:bg-gray-200 rounded-xl text-sm font-medium transition"
                                            disabled="@(!CanSearchExisting || _isLookupInProgress)"
                                            @onclick="LookupCustomerButtonAsync">
                                        <Icon Name="search" Size="20" />
                                    </button>
                                }
                            </div>

                            <div>
                                <PhoneInput @bind-Value="_customer.PhoneNumber"
                                            Label="Numer telefonu *"
                                            Required="true"
                                            Variant="MudBlazor.Variant.Outlined" />
                                <ValidationMessage For="@(() => _customer.PhoneNumber)" />
                            </div>

                            <div>
                                <label for="checkout-address" class="block text-sm font-medium text-gray-700 mb-1">Adres (opcjonalnie)</label>
                                <InputTextArea id="checkout-address" @bind-Value="_customer.Address" rows="2"
                                               class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:outline-none"
                                               placeholder="ul. Sportowa 123, Warszawa" />
                                <ValidationMessage For="@(() => _customer.Address)" />
                            </div>

                            <div>
                                <label for="checkout-notes" class="block text-sm font-medium text-gray-700 mb-1">Uwagi do rezerwacji</label>
                                <InputTextArea id="checkout-notes" @bind-Value="_notes" rows="2"
                                               class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:outline-none"
                                               placeholder="Dodatkowe informacje..." />
                            </div>
                        </div>
                    </EditForm>

                    <!-- Payment Summary -->
                    <div class="checkout-summary">
                        <h3 class="font-semibold text-gray-800 mb-3">Podsumowanie płatności</h3>
                        
                        @if (_quoteError is not null)
                        {
                            <div class="p-3 bg-yellow-50 border border-yellow-200 rounded-xl text-yellow-800 text-sm mb-3">
                                @_quoteError
                                <button @onclick="RefreshPaymentSummaryAsync" class="ml-2 underline">Odśwież</button>
                            </div>
                        }
                        else if (_quote is null)
                        {
                            <div class="flex items-center gap-2 text-gray-500">
                                <div class="w-4 h-4 border-2 border-blue-500 border-t-transparent rounded-full animate-spin"></div>
                                Obliczanie kwoty...
                            </div>
                        }
                        else
                        {
                            <div class="checkout-summary-row checkout-summary-total">
                                <span>Depozyt płatny teraz</span>
                                <span class="text-xl text-blue-600">@_quote.DepositAmount.Pln()</span>
                            </div>
                            <div class="checkout-summary-row">
                                <span>Cena wynajmu do zapłaty osobno</span>
                                <span>@_quote.TotalAmount.Pln()</span>
                            </div>
                            <div class="text-sm text-gray-500 mt-2">
                                Depozyt jest zwrotny po rozliczeniu sprzętu i nie pomniejsza ceny wynajmu.
                            </div>

                            <div class="checkout-rental-groups-summary">
                                @foreach (var tenant in _quote.Tenants)
                                {
                                    <article class="checkout-rental-group-summary">
                                        <div class="checkout-rental-group-heading">
                                            <div>
                                                <strong>@tenant.TenantName</strong>
                                                <span>@FormatPickup(tenant)</span>
                                            </div>
                                            @if (_quote.Tenants.Count > 1)
                                            {
                                                <span class="checkout-separate-reservation">Osobna rezerwacja</span>
                                            }
                                        </div>
                                        <div class="checkout-rental-group-period">@FormatRentalPeriod(tenant)</div>
                                        <div class="checkout-rental-group-amounts">
                                            <span>Wynajem: <strong>@tenant.TotalAmount.Pln()</strong></span>
                                            <span>Depozyt: <strong>@tenant.DepositAmount.Pln()</strong></span>
                                        </div>
                                        <details class="checkout-rental-terms">
                                            <summary>
                                                @tenant.RentalTerms.Title
                                                @if (tenant.RentalTerms.UsesPlatformDefault)
                                                {
                                                    <span>standard RentSpot</span>
                                                }
                                            </summary>
                                            @if (!string.IsNullOrWhiteSpace(tenant.RentalTerms.Content))
                                            {
                                                <div class="checkout-rental-terms-content">@tenant.RentalTerms.Content</div>
                                            }
                                        </details>
                                        <label class="checkout-tenant-legal-ack">
                                            <input type="checkbox"
                                                   checked="@IsTenantTermsAccepted(tenant)"
                                                   @onchange="@(args => OnTenantTermsAcceptanceChanged(tenant, args))" />
                                            <span>Akceptuję regulamin wypożyczalni @tenant.TenantName.</span>
                                        </label>
                                    </article>
                                }
                            </div>
                        }
                    </div>

                    <label class="checkout-legal-ack">
                        <input type="checkbox" @bind="_acceptPlatformLegal" />
                        <span>
                            Akceptuję <a href="terms" target="_blank" rel="noopener">regulamin platformy</a> i potwierdzam
                            zapoznanie się z <a href="privacy" target="_blank" rel="noopener">polityką prywatności</a>.
                        </span>
                    </label>

                    <button class="checkout-submit-btn" 
                            disabled="@(_isSubmitting || _isPaymentInProgress || !AllLegalAccepted || _cart.Items.Count == 0 || _hasInvalidGroups || _quote is null || _quoteError is not null)"
                            @onclick="SubmitAsync">
                        @if (_isSubmitting)
                        {
                            <span>Przetwarzanie...</span>
                        }
                        else
                        {
                            <span>Zamawiam i płacę depozyt @_quote?.DepositAmount.Pln()</span>
                        }
                    </button>

                    <p class="text-center text-sm text-gray-500 mt-4">
                        Płatność obsługiwana przez Stripe
                    </p>
                </div>
            </div>
        }
    </div>
</div>
} @* End of Desktop UI *@

@code {
    private static string FormatPolishTime(DateTime? value, string format) =>
        value.HasValue ? PolishRentalTime.FromUtc(value.Value).ToString(format) : string.Empty;

    private CartModel _cart = new();
    private bool _isSubmitting;
    private CheckoutCustomerModel _customer = new();
    private EditContext _customerEditContext = null!;
    private string? _notes;
    private bool _hasInvalidGroups;
    private Guid? _existingCustomerId;
    private string? _lastLookupEmail;
    private bool _isLookupInProgress;
    private bool _canLookupOwnProfile;
    private CancellationTokenSource? _refreshCts;
    private Task? _refreshLoop;
    private PaymentQuoteResponse? _quote;
    private string? _quoteError;
    private int _quoteVersion;
    private bool _isPaymentInProgress;
    private bool _acceptPlatformLegal;
    private readonly Dictionary<Guid, string> _acceptedRentalTermHashes = new();
    
    // Mobile state
    private bool _isMobile = false;
    private bool _showMobileItems = true;
    private DotNetObjectReference<Checkout>? _dotNetRef;

    private bool CanSearchExisting => _canLookupOwnProfile && !string.IsNullOrWhiteSpace(_customer.Email);

    private decimal? QuotedItemSubtotal(Guid productId) =>
        _quote?.Items.FirstOrDefault(item => item.ProductId == productId)?.Subtotal;

    private IReadOnlyList<CheckoutCartGroup> CartGroups => _cart.Items
        .GroupBy(item => item.TenantId)
        .Select(group =>
        {
            var items = group.ToList();
            return new CheckoutCartGroup(
                group.Key,
                items.Select(item => item.TenantName)
                    .FirstOrDefault(name => !string.IsNullOrWhiteSpace(name)) ?? "Wypożyczalnia",
                items.Select(item => item.PickupAddress)
                    .FirstOrDefault(address => !string.IsNullOrWhiteSpace(address)),
                items.Select(item => item.PickupCity)
                    .FirstOrDefault(city => !string.IsNullOrWhiteSpace(city)),
                items);
        })
        .OrderBy(group => group.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    private bool AllLegalAccepted =>
        _acceptPlatformLegal &&
        _quote is { Tenants.Count: > 0 } &&
        _quote.Tenants.All(IsTenantTermsAccepted);

    protected override async Task OnInitializedAsync()
    {
        _customerEditContext = new EditContext(_customer);
        _cart = CartService.GetCart();
        _hasInvalidGroups = HasInvalidGroups(_cart);
        CartService.CartChanged += OnCartChanged;
        await PrefillFromSessionAsync();
        _ = RefreshPaymentSummaryAsync();
        StartRefreshLoop();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("setupMobileDetection", _dotNetRef);
        }
    }
    
    [JSInvokable]
    public void OnScreenResize(bool isMobile)
    {
        if (_isMobile != isMobile)
        {
            _isMobile = isMobile;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task PrefillFromSessionAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated != true)
                return;

            _canLookupOwnProfile = true;

            CustomerDto? customer = null;
            var customerIdValue = user.FindFirst("customer-id")?.Value;
            if (Guid.TryParse(customerIdValue, out var customerId))
                customer = await Api.GetCustomerAsync(customerId);

            if (customer is not null)
            {
                _existingCustomerId = customer.Id;
                _customer.FullName = customer.FullName ?? string.Empty;
                _customer.Email = customer.Email ?? string.Empty;
                _customer.PhoneNumber = customer.PhoneNumber ?? string.Empty;
                _customer.Address = customer.Address;
                _customer.DocumentNumber = customer.DocumentNumber;
                _customer.Notes = customer.Notes;
                _lastLookupEmail = _customer.Email;
                await InvokeAsync(StateHasChanged);
                return;
            }

            var email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                     ?? user.FindFirst("email")?.Value;

            if (!string.IsNullOrWhiteSpace(email))
            {
                _customer.Email = email;
                _lastLookupEmail = email;

                try
                {
                    var existing = await Api.FindCustomerByEmailAsync(email);
                    if (existing is not null)
                    {
                        _existingCustomerId = existing.Id;
                        _customer.FullName = existing.FullName ?? string.Empty;
                        _customer.Email = existing.Email ?? string.Empty;
                        _customer.PhoneNumber = existing.PhoneNumber ?? string.Empty;
                        _customer.Address = existing.Address;
                        _customer.DocumentNumber = existing.DocumentNumber;
                        _lastLookupEmail = existing.Email;
                        await Session.SetCustomerAsync(existing);
                    }
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine("[Checkout] Failed to lookup customer by email: {0}", ex);
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine("[Checkout] Failed to prefill customer session: {0}", ex);
        }
    }

    private void OnCartChanged(object? sender, EventArgs e)
    {
        _cart = CartService.GetCart();
        _hasInvalidGroups = HasInvalidGroups(_cart);
        _ = RefreshPaymentSummaryAsync();
    }

    private async Task RemoveFromCart(Guid productId)
    {
        await CartService.RemoveFromCartAsync(productId);
        _cart = CartService.GetCart();
        _hasInvalidGroups = HasInvalidGroups(_cart);
        await RefreshPaymentSummaryAsync();
        Snackbar.Add("Produkt usunięty z zamówienia", Severity.Info);
    }

    private static bool HasInvalidGroups(CartModel cart)
    {
        if (cart.Items.Count == 0)
            return false;

        return cart.Items
            .GroupBy(item => item.TenantId)
            .Any(group =>
            {
                if (group.Key == Guid.Empty)
                    return true;
                var first = group.First();
                return group.Skip(1).Any(item =>
                    item.StartDate != first.StartDate ||
                    item.EndDate != first.EndDate ||
                    item.RentalType != first.RentalType ||
                    item.HoursRented != first.HoursRented);
            });
    }

    private async Task RefreshPaymentSummaryAsync()
    {
        var quoteVersion = ++_quoteVersion;
        if (_cart.Items.Count == 0)
        {
            _quote = null;
            _quoteError = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            if (_hasInvalidGroups)
                throw new InvalidOperationException("Produkty z jednego punktu odbioru muszą mieć wspólny termin.");

            var quote = await Api.GetPaymentQuoteAsync(BuildPaymentQuoteRequest());
            if (quoteVersion != _quoteVersion)
                return;

            _quote = quote;
            ReconcileAcceptedRentalTerms(quote);
            _quoteError = null;
        }
        catch (Exception ex)
        {
            _quote = null;
            _quoteError = "Nie udało się obliczyć kosztu. Sprawdź terminy i spróbuj ponownie.";
            Console.Error.WriteLine($"Checkout quote failed: {ex.GetType().Name}");
        }

        await InvokeAsync(StateHasChanged);
    }

    private PaymentQuoteRequest BuildPaymentQuoteRequest()
    {
        if (CartGroups.Count == 0)
            return new PaymentQuoteRequest();

        var first = CartGroups[0].Items[0];
        return new PaymentQuoteRequest
        {
            // Pola top-level pozostają dla zgodności ze starszym API. Backend v2
            // korzysta z RentalGroups i terminów właściwych dla wypożyczalni.
            StartDateUtc = PolishRentalTime.ToUtc(first.StartDate),
            EndDateUtc = PolishRentalTime.ToUtc(first.EndDate),
            RentalType = first.RentalType,
            HoursRented = first.HoursRented,
            Items = new List<CreateRentalItem>(),
            RentalGroups = CartGroups.Select(group =>
            {
                var terms = group.Items[0];
                return new RentalGroupQuoteRequest
                {
                    TenantId = group.TenantId,
                    StartDateUtc = PolishRentalTime.ToUtc(terms.StartDate),
                    EndDateUtc = PolishRentalTime.ToUtc(terms.EndDate),
                    RentalType = terms.RentalType,
                    HoursRented = terms.HoursRented,
                    Items = group.Items.Select(item => new CreateRentalItem
                    {
                        ProductId = item.ProductId,
                        Quantity = item.Quantity
                    }).ToList()
                };
            }).ToList()
        };
    }

    private void ReconcileAcceptedRentalTerms(PaymentQuoteResponse quote)
    {
        var current = quote.Tenants.ToDictionary(
            tenant => tenant.TenantId,
            tenant => tenant.RentalTerms.ContentHash);
        foreach (var accepted in _acceptedRentalTermHashes.ToList())
        {
            if (!current.TryGetValue(accepted.Key, out var currentHash) ||
                !string.Equals(accepted.Value, currentHash, StringComparison.OrdinalIgnoreCase))
            {
                _acceptedRentalTermHashes.Remove(accepted.Key);
            }
        }
    }

    private bool IsTenantTermsAccepted(TenantQuoteBreakdown tenant) =>
        _acceptedRentalTermHashes.TryGetValue(tenant.TenantId, out var acceptedHash) &&
        string.Equals(
            acceptedHash,
            tenant.RentalTerms.ContentHash,
            StringComparison.OrdinalIgnoreCase);

    private void OnTenantTermsAcceptanceChanged(
        TenantQuoteBreakdown tenant,
        ChangeEventArgs args)
    {
        var accepted = args.Value is bool boolValue
            ? boolValue
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        if (accepted)
            _acceptedRentalTermHashes[tenant.TenantId] = tenant.RentalTerms.ContentHash;
        else
            _acceptedRentalTermHashes.Remove(tenant.TenantId);
    }

    private static string FormatPickup(TenantQuoteBreakdown tenant)
    {
        return FormatPickupLocation(
            tenant.PickupAddress,
            tenant.PickupCity,
            "Adres odbioru potwierdzi wypożyczalnia");
    }

    private static string FormatCartPickup(CheckoutCartGroup group) =>
        FormatPickupLocation(
            group.PickupAddress,
            group.PickupCity,
            "Punkt odbioru w potwierdzeniu");

    private static string FormatPickupLocation(
        string? address,
        string? city,
        string fallback)
    {
        if (string.IsNullOrWhiteSpace(address))
            return string.IsNullOrWhiteSpace(city) ? fallback : $"Odbiór: {city}";
        if (string.IsNullOrWhiteSpace(city) ||
            address.Contains(city, StringComparison.CurrentCultureIgnoreCase))
        {
            return $"Odbiór: {address}";
        }

        return $"Odbiór: {address}, {city}";
    }

    private static string PolishCount(int count, string singular, string paucal, string plural)
    {
        var absolute = Math.Abs(count);
        var lastTwoDigits = absolute % 100;
        var noun = absolute == 1
            ? singular
            : lastTwoDigits is >= 12 and <= 14
                ? plural
                : absolute % 10 is >= 2 and <= 4
                    ? paucal
                    : plural;
        return $"{count} {noun}";
    }

    private static string FormatRentalPeriod(TenantQuoteBreakdown tenant)
    {
        var start = PolishRentalTime.FromUtc(tenant.StartDateUtc);
        var end = PolishRentalTime.FromUtc(tenant.EndDateUtc);
        return tenant.RentalType == RentalTypeDto.Hourly
            ? $"{start:dd.MM.yyyy, HH:mm}–{end:HH:mm} ({tenant.HoursRented ?? 1} godz.)"
            : $"{start:dd.MM.yyyy, HH:mm} – {end:dd.MM.yyyy, HH:mm}";
    }

    private static string FormatCartGroupPeriod(CheckoutCartGroup group)
    {
        var item = group.Items[0];
        return item.RentalType == RentalTypeDto.Hourly
            ? $"{item.StartDate:dd.MM.yyyy, HH:mm}–{item.EndDate:HH:mm} ({item.HoursRented ?? 1} godz.)"
            : $"{item.StartDate:dd.MM.yyyy, HH:mm} – {item.EndDate:dd.MM.yyyy, HH:mm}";
    }

