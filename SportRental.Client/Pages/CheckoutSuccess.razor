@page "/checkout/success"
@using SportRental.Client.Helpers
@using SportRental.Shared.Models
@using SportRental.Shared.Services
@using SportRental.Client.Services
@inject NavigationManager NavigationManager
@inject IApiService ApiService
@inject ICustomerSessionService CustomerSession
@inject ICartService CartService
@inject ISnackbar Snackbar

<PageTitle>Płatność zakończona sukcesem — RentSpot</PageTitle>

<div class="success-container">
    @if (_isLoading)
    {
        <div class="success-card">
            <div class="w-20 h-20 border-4 border-green-200 border-t-green-500 rounded-full animate-spin mx-auto mb-6"></div>
            <h2 class="text-2xl font-bold text-gray-800">Ładowanie szczegółów rezerwacji...</h2>
        </div>
    }
    else if (!_isConfirmed)
    {
        <div class="success-card">
            <h1 class="success-title">Nie udało się potwierdzić rezerwacji</h1>
            <p class="success-subtitle">
                @(_loadError ?? "Brakuje identyfikatora płatności. Nie potwierdzamy rezerwacji bez weryfikacji Stripe.")
            </p>
            <div class="success-actions">
                @if (_canRetry)
                {
                    <button type="button"
                            class="checkout-submit-btn"
                            style="color:#fff;"
                            disabled="@_isRetrying"
                            @onclick="RetryConfirmationAsync">
                        @(_isRetrying ? "Ponawiam potwierdzenie..." : "Ponów potwierdzenie płatności")
                    </button>
                }
                <a href="contact" class="product-details-back-btn" style="text-decoration:none;">Kontakt</a>
            </div>
        </div>
    }
    else
    {
        <div class="success-card">
            <div class="success-icon"><Icon Name="check" Size="40" /></div>
            <h1 class="success-title">Płatność zakończona sukcesem!</h1>
            <p class="success-subtitle">
                @if (_rentals.Count > 1)
                {
                    <span>Jedna płatność została potwierdzona. Utworzyliśmy @PolishCount(_rentals.Count, "rezerwację", "osobne rezerwacje", "osobnych rezerwacji") w różnych wypożyczalniach.</span>
                }
                else
                {
                    <span>Twoja rezerwacja została potwierdzona.</span>
                }
            </p>

            @if (!string.IsNullOrWhiteSpace(_orderNumber))
            {
                <div class="inline-block px-4 py-2 bg-blue-50 text-blue-700 rounded-full text-sm mb-6">
                    Numer zamówienia: <strong>@_orderNumber</strong>
                </div>
            }

            @if (_rentals.Count > 0)
            {
                <div class="success-order-summary">
                    <div>
                        <span>Łączna wartość wynajmów</span>
                        <strong>@_rentals.Sum(rental => rental.TotalAmount).Pln()</strong>
                    </div>
                    <div>
                        <span>Depozyt opłacony online</span>
                        <strong>@_rentals.Sum(rental => rental.DepositAmount).Pln()</strong>
                    </div>
                </div>

                <div class="success-rental-groups">
                    @foreach (var rental in _rentals)
                    {
                        <article class="success-rental-group">
                            <header>
                                <div>
                                    <span class="success-rental-sequence">Rezerwacja @(rental.OrderSequence ?? (_rentals.IndexOf(rental) + 1)) z @_rentals.Count</span>
                                    <h2>@TenantName(rental)</h2>
                                    <p>@PickupLocation(rental)</p>
                                </div>
                                <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-medium">
                                    Potwierdzona
                                </span>
                            </header>

                            <div class="success-rental-period">
                                <span>Od <strong>@FormatDate(rental.StartDateUtc)</strong></span>
                                <span>Do <strong>@FormatDate(rental.EndDateUtc)</strong></span>
                            </div>

                            <div class="success-rental-products">
                                @foreach (var item in rental.Items)
                                {
                                    <div>
                                        <span>@item.ProductName × @item.Quantity</span>
                                        <span>@item.TotalPrice.Pln()</span>
                                    </div>
                                }
                            </div>

                            <div class="success-rental-amounts">
                                <span>Wynajem: <strong>@rental.TotalAmount.Pln()</strong></span>
                                <span>Depozyt: <strong>@rental.DepositAmount.Pln()</strong></span>
                                <span>Do zapłaty w punkcie: <strong>@RentalPresentation.OutstandingAmount(rental).Pln()</strong></span>
                            </div>

                            @if (!string.IsNullOrEmpty(rental.PublicContractUrl))
                            {
                                <a href="@rental.PublicContractUrl" target="_blank" rel="noopener" class="success-contract-link">
                                    Otwórz umowę tej wypożyczalni
                                </a>
                            }
                            else
                            {
                                <p class="success-contract-pending">Umowa jest generowana i pojawi się w historii wynajmów.</p>
                            }
                        </article>
                    }
                </div>
            }
            else if (_loadError != null)
            {
                <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-xl text-yellow-800 mb-6">
                    Nie udało się pobrać szczegółów rezerwacji, ale płatność została przyjęta pomyślnie.
                </div>
            }

            <p class="text-gray-500 text-sm mb-8">
                Rezerwacja jest zapisana. Powiadomienie i umowa pojawią się po zakończeniu ich generowania.
            </p>

            <div class="success-actions">
                <a href="my-rentals" class="checkout-submit-btn" style="text-decoration: none; background: linear-gradient(135deg, #F96167 0%, #FA8186 100%); color: #fff;">
                    Moje wypożyczenia
                </a>
                <a href="./" class="product-details-back-btn" style="text-decoration: none;">
                    Strona główna
                </a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "session_id")]
    public string? SessionId { get; set; }

    private bool _isLoading = true;
    private List<MyRentalDto> _rentals = new();
    private string? _orderNumber;
    private Guid? _marketplaceOrderId;
    private string? _loadError;
    private bool _isConfirmed;
    private bool _isRetrying;
    private bool _canRetry;

    protected override Task OnInitializedAsync() => ConfirmReservationAsync();

    private Task RetryConfirmationAsync() => ConfirmReservationAsync(isManualRetry: true);

    private async Task ConfirmReservationAsync(bool isManualRetry = false)
    {
        _isLoading = true;
        _isRetrying = isManualRetry;
        _loadError = null;
        _canRetry = false;

        try
        {
            if (string.IsNullOrWhiteSpace(SessionId))
            {
                _loadError = "Brakuje identyfikatora sesji Stripe.";
                return;
            }

            var finalization = await CheckoutFinalizationRetrier.FinalizeAsync(
                _ => FinalizeSessionAsync(SessionId));
            if (finalization is null || !finalization.Success)
            {
                _loadError = finalization?.Message
                    ?? "Serwer nie potwierdził jeszcze płatności i utworzenia rezerwacji.";
                _canRetry = finalization is null || finalization.Retryable;
                return;
            }

            _isConfirmed = true;
            _orderNumber = finalization.MarketplaceOrderNumber;
            _marketplaceOrderId = finalization.MarketplaceOrderId;
            await CartService.ClearCartAsync();

            // Pobierz customerId z sesji
            var customer = await CustomerSession.GetCustomerAsync();
            var customerId = customer?.Id;

            // Pobierz wypożyczenia dla tego klienta
            var rentals = await ApiService.GetMyRentalsAsync(customerId: customerId);
            
            if (rentals != null && rentals.Any())
            {
                var expectedIds = finalization.RentalIds?.Count > 0
                    ? finalization.RentalIds
                    : finalization.RentalId.HasValue
                        ? new[] { finalization.RentalId.Value }
                        : Array.Empty<Guid>();
                _rentals = rentals
                    .Where(rental => expectedIds.Contains(rental.Id))
                    .OrderBy(rental => rental.OrderSequence ?? int.MaxValue)
                    .ToList();

                if (_rentals.Count == 0 && _marketplaceOrderId.HasValue)
                {
                    _rentals = rentals
                        .Where(rental => rental.MarketplaceOrderId == _marketplaceOrderId)
                        .OrderBy(rental => rental.OrderSequence ?? int.MaxValue)
                        .ToList();
                }

                // Zgodność ze starszą finalizacją, która zwracała tylko jeden RentalId.
                if (_rentals.Count == 0 &&
                    expectedIds.Count == 0 &&
                    !_marketplaceOrderId.HasValue)
                {
                    var fallback = rentals.OrderByDescending(rental => rental.PaidAtUtc ?? rental.StartDateUtc)
                        .FirstOrDefault();
                    if (fallback is not null)
                        _rentals.Add(fallback);
                }

                _orderNumber ??= _rentals.Select(rental => rental.MarketplaceOrderNumber)
                    .FirstOrDefault(number => !string.IsNullOrWhiteSpace(number));
            }
        }
        catch (Exception ex)
        {
            _loadError = "Nie udało się potwierdzić rezerwacji. Spróbuj ponownie za chwilę.";
            _canRetry = true;
            Snackbar.Add("Płatność została przyjęta, ale szczegóły rezerwacji nie są jeszcze dostępne. Odśwież stronę za chwilę.", Severity.Warning);
            Console.Error.WriteLine($"Checkout details load failed: {ex.GetType().Name}");
        }
        finally
        {
            _isLoading = false;
            _isRetrying = false;
        }
    }

    private async Task<FinalizeSessionResponse?> FinalizeSessionAsync(string sessionId)
    {
        try
        {
            var response = await ApiService.FinalizeCheckoutSessionAsync(sessionId);
            if (response != null && response.Success)
            {
                Console.WriteLine($"[CheckoutSuccess] Session finalized: {response.Message}, RentalId: {response.RentalId}");
            }
            else if (response != null)
            {
                Console.WriteLine($"[CheckoutSuccess] Session not finalized: {response.Message}");
            }
            return response;
        }
        catch (Exception ex)
        {
            // Nie pokazuj błędu - może webhook już zadziałał
            Console.WriteLine($"[CheckoutSuccess] Finalize error (may be OK if webhook worked): {ex.Message}");
            return null;
        }
    }

    private static string TenantName(MyRentalDto rental) =>
        string.IsNullOrWhiteSpace(rental.TenantName) ? "Wypożyczalnia" : rental.TenantName;

    private static string PickupLocation(MyRentalDto rental)
    {
        var address = rental.PickupAddress?.Trim();
        var city = rental.PickupCity?.Trim();
        if (string.IsNullOrWhiteSpace(address))
        {
            return string.IsNullOrWhiteSpace(city)
                ? "Adres odbioru znajdziesz w potwierdzeniu wypożyczalni."
                : $"Odbiór: {city}";
        }
        if (string.IsNullOrWhiteSpace(city) ||
            address.Contains(city, StringComparison.CurrentCultureIgnoreCase))
        {
            return $"Odbiór: {address}";
        }

        return $"Odbiór: {address}, {city}";
    }

    private static string PolishCount(int count, string singular, string paucal, string plural)
    {
        var absolute = Math.Abs(count);
        var lastTwoDigits = absolute % 100;
        var noun = absolute == 1
            ? singular
            : lastTwoDigits is >= 12 and <= 14
                ? plural
                : absolute % 10 is >= 2 and <= 4
                    ? paucal
                    : plural;
        return $"{count} {noun}";
    }

    private static string FormatDate(DateTime value) =>
        SportRental.Shared.Time.PolishRentalTime.FromUtc(value).ToString("dd.MM.yyyy, HH:mm");
}
