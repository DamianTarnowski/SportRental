@page "/products/{id:guid}"
@using MudBlazor
@using SportRental.Shared.Models
@inject IApiService ApiService
@inject ICartService CartService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(product?.Name ?? "Szczegóły produktu") — RentSpot</PageTitle>

@* ============================================
   MOBILE UI - Single column product view
   ============================================ *@
@if (_isMobile)
{
    <div class="product-mobile">
        @if (isLoading)
        {
            <div class="product-mobile-loading">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <span>Ładowanie produktu...</span>
            </div>
        }
        else if (_loadError is not null)
        {
            <div class="product-mobile-empty" role="alert">
                <h3>Nie udało się pobrać produktu</h3>
                <p>@_loadError</p>
                <button class="product-mobile-cta" @onclick="LoadProductAsync">Spróbuj ponownie</button>
            </div>
        }
        else if (notFound || product is null)
        {
            <div class="product-mobile-empty">
                <span class="empty-icon"></span>
                <h3>Produkt nie znaleziony</h3>
                <p>Produkt mógł zostać usunięty</p>
                <button class="product-mobile-cta" @onclick="GoBack">← Wróć do katalogu</button>
            </div>
        }
        else
        {
            <!-- Mobile Image -->
            var mobileImageUrl = product.GetImageUrl(800);
            <div class="product-mobile-image">
                @if (!string.IsNullOrWhiteSpace(mobileImageUrl))
                {
                    <img src="@mobileImageUrl"
                         data-fallback-src="@product.ImageUrl"
                         alt="@product.Name"
                         onerror="srImg(this)" />
                }
                else
                {
                    <div class="product-mobile-image-placeholder" aria-hidden="true">
                        <Icon Name="catalog" Size="42" />
                        <span>Zdjęcie wkrótce</span>
                    </div>
                }
                
                <!-- Back button -->
                <button class="product-mobile-back" @onclick="GoBack" aria-label="Wróć"><Icon Name="arrow-left" Size="20" /></button>
                
                <!-- Badges -->
                <div class="product-mobile-image-badges">
                    @if (product.IsAvailable && product.AvailableQuantity > 0)
                    {
                        <span class="badge-available">Dostępny</span>
                    }
                    else
                    {
                        <span class="badge-unavailable">Niedostępny</span>
                    }
                </div>
            </div>

            <!-- Mobile Info -->
            <div class="product-mobile-content">
                @if (!string.IsNullOrWhiteSpace(product.Category))
                {
                    <span class="product-mobile-category">@product.Category</span>
                }
                
                <h1 class="product-mobile-title">@product.Name</h1>
                
                <div class="product-mobile-prices">
                    <div class="price-main">
                        <span class="price-value">@product.DailyPrice.PlnInt()</span>
                        <span class="price-period">/ dzień</span>
                    </div>
                    @if (product.HourlyPrice.HasValue && product.HourlyPrice.Value > 0)
                    {
                        <div class="price-hourly">
                            <span>@product.HourlyPrice.Value.PlnInt()</span>
                            <span>/ godz.</span>
                        </div>
                    }
                </div>

                <div class="product-mobile-stock">@product.AvailableQuantity szt. w magazynie</div>

                <div class="product-mobile-description">
                    <h3>Wypożyczalnia i odbiór</h3>
                    <p><strong>@(product.TenantName ?? "Wypożyczalnia")</strong></p>
                    <p>Odbiór: @ProductPickupDisplay(product)</p>
                    @if (_tenantLocation is not null)
                    {
                        @if (!string.IsNullOrWhiteSpace(_tenantLocation.OpeningHours))
                        {
                            <p>Godziny: @_tenantLocation.OpeningHours</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(_tenantLocation.PhoneNumber))
                        {
                            <a href="@($"tel:{_tenantLocation.PhoneNumber}")">@_tenantLocation.PhoneNumber</a>
                        }
                    }
                </div>

                <!-- Dates selection -->
                <div class="product-mobile-dates">
                    <h3>Okres wypożyczenia</h3>
                    <div class="dates-row">
                        <div class="date-input">
                            <label>Od</label>
                            <input type="datetime-local" @bind="startDate" @bind:format="yyyy-MM-ddTHH:mm"
                                   min="@EarliestStartLocal.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="date-input">
                            <label>Do</label>
                            <input type="datetime-local" @bind="endDate" @bind:format="yyyy-MM-ddTHH:mm"
                                   min="@startDate?.AddHours(1).ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>
                    
                    <div class="rental-type-row">
                        <select @bind="selectedRentalType" class="rental-type-select">
                            <option value="0">Wynajem dzienny</option>
                            @if (product.HourlyPrice.HasValue && product.HourlyPrice.Value > 0)
                            {
                                <option value="1">Wynajem godzinowy</option>
                            }
                        </select>
                        @if (selectedRentalType == 1)
                        {
                            <input type="number" @bind="selectedHours" min="1" max="24" 
                                   class="hours-input" placeholder="Godz." />
                        }
                    </div>

                    @if (startDate.HasValue && endDate.HasValue && endDate > startDate)
                    {
                        var days = Math.Max(1, (int)Math.Ceiling((endDate.Value - startDate.Value).TotalDays));
                        decimal totalPrice;
                        string priceDescription;
                        
                        if (selectedRentalType == 1 && product.HourlyPrice.HasValue)
                        {
                            totalPrice = product.HourlyPrice.Value * selectedHours;
                            priceDescription = $"{selectedHours} godz. × {product.HourlyPrice.Value.PlnInt()}";
                        }
                        else
                        {
                            totalPrice = product.DailyPrice * days;
                            priceDescription = $"{days} dni × {product.DailyPrice.PlnInt()}";
                        }
                        
                        <div class="price-summary">
                            <span>@priceDescription</span>
                            <span class="price-total">= @totalPrice.PlnInt()</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-1">Cena orientacyjna; dokładna wycena z regułami sezonowymi pojawi się w koszyku.</p>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(product.Description))
                {
                    <div class="product-mobile-description">
                        <h3>Opis</h3>
                        <p>@product.Description</p>
                    </div>
                }
            </div>

            <!-- Mobile Add to Cart - Sticky -->
            <div class="product-mobile-actions">
                <button class="product-mobile-add" 
                        disabled="@(product.AvailableQuantity <= 0 || !product.IsAvailable)"
                        @onclick="AddToCart">
                    Dodaj do koszyka
                </button>
            </div>
        }
    </div>
}
@* ============================================
   DESKTOP UI - Original two-column layout
   ============================================ *@
else
{
<div class="product-details-container">
    <div class="max-w-6xl mx-auto">
        <!-- Breadcrumbs -->
        <style>
            .rs-crumb { color:#E0454C; text-decoration:none; }
            .rs-crumb:hover { color:#F96167; text-decoration:underline; }
        </style>
        <div class="mb-6">
            <nav class="flex items-center gap-2 text-sm text-gray-500">
                <a href="./" class="rs-crumb">Home</a>
                <span>/</span>
                <a href="products" class="rs-crumb">Katalog</a>
                <span>/</span>
                <span class="text-gray-800 font-medium">@(product?.Name ?? "...")</span>
            </nav>
        </div>

        @if (isLoading)
        {
            <div class="product-details-grid">
                <div class="animate-pulse">
                    <div class="bg-gray-200 rounded-3xl h-96"></div>
                </div>
                <div class="animate-pulse space-y-4">
                    <div class="h-8 bg-gray-200 rounded w-3/4"></div>
                    <div class="h-6 bg-gray-200 rounded w-1/2"></div>
                    <div class="h-24 bg-gray-200 rounded"></div>
                    <div class="h-12 bg-gray-200 rounded w-1/2"></div>
                </div>
            </div>
        }
        else if (_loadError is not null)
        {
            <div class="text-center py-20" role="alert">
                <h1 class="text-3xl font-bold text-gray-800 mb-3">Nie udało się pobrać produktu</h1>
                <p class="text-gray-600 mb-8">@_loadError</p>
                <button @onclick="LoadProductAsync" class="product-details-add-btn" style="max-width: 250px; margin: 0 auto;">
                    Spróbuj ponownie
                </button>
            </div>
        }
        else if (notFound || product is null)
        {
            <div class="text-center py-20">
                <div class="text-8xl mb-6"></div>
                <h1 class="text-3xl font-bold text-gray-800 mb-3">Produkt nie został znaleziony</h1>
                <p class="text-gray-600 mb-8">Produkt mógł zostać usunięty lub jest chwilowo niedostępny.</p>
                <button @onclick="GoBack" class="product-details-add-btn" style="max-width: 250px; margin: 0 auto;">
                    ← Wróć do katalogu
                </button>
            </div>
        }
        else
        {
            <div class="product-details-grid">
                <!-- Image Section -->
                <div>
                    @{
                        var imageUrl = product.GetImageUrl(1280);
                        var imageSrcSet = product.GetImageSrcSet();
                        var originalUrl = product.GetOriginalImageUrl();
                    }
                    @if (!string.IsNullOrWhiteSpace(imageUrl))
                    {
                        <div class="product-details-image-wrapper" @onclick="@(() => ShowImageLightbox(originalUrl, product.Name, product.ImageUrl))">
                            @if (!string.IsNullOrEmpty(imageSrcSet))
                            {
                                <img src="@imageUrl"
                                     srcset="@imageSrcSet"
                                     sizes="(max-width: 600px) 400px, (max-width: 900px) 800px, 1280px"
                                     data-fallback-src="@product.ImageUrl"
                                     alt="@product.Name"
                                     class="product-details-image" onerror="srImg(this)" />
                            }
                            else
                            {
                                <img src="@imageUrl"
                                     data-fallback-src="@product.ImageUrl"
                                     alt="@product.Name"
                                     class="product-details-image" onerror="srImg(this)" />
                            }
                            <div class="product-details-zoom-hint">
                                Kliknij aby powiększyć
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="product-details-image-placeholder">
                            <Icon Name="catalog" Size="48" />
                            <p>Zdjęcie wkrótce dostępne</p>
                        </div>
                    }
                </div>

                <!-- Info Section -->
                <div class="product-details-info">
                    @if (!string.IsNullOrWhiteSpace(product.Category))
                    {
                        <div class="product-details-category">
                            @product.Category
                        </div>
                    }

                    <h1 class="product-details-title">@product.Name</h1>

                    <div class="product-details-price-row">
                        <span class="product-details-price">@product.DailyPrice.Pln() / dzień</span>
                        @if (product.HourlyPrice.HasValue && product.HourlyPrice.Value > 0)
                        {
                            <span class="product-details-price-hourly">@product.HourlyPrice.Value.Pln() / godz.</span>
                        }
                        @if (product.IsAvailable && product.AvailableQuantity > 0)
                        {
                            <span class="product-details-availability available">Dostępny</span>
                        }
                        else
                        {
                            <span class="product-details-availability unavailable">Niedostępny</span>
                        }
                        <span class="product-details-stock">@product.AvailableQuantity szt.</span>
                    </div>

                    <div class="mt-4 p-4 bg-gray-50 border border-gray-200 rounded-xl">
                        <div class="font-semibold text-gray-900">@(product.TenantName ?? "Wypożyczalnia")</div>
                        <div class="text-sm text-gray-600 mt-1">Odbiór: @ProductPickupDisplay(product)</div>
                        @if (_tenantLocation is not null)
                        {
                            @if (!string.IsNullOrWhiteSpace(_tenantLocation.OpeningHours))
                            {
                                <div class="text-sm text-gray-600 mt-1">Godziny: @_tenantLocation.OpeningHours</div>
                            }
                            <div class="flex gap-4 mt-2 text-sm">
                                @if (!string.IsNullOrWhiteSpace(_tenantLocation.PhoneNumber))
                                {
                                    <a href="@($"tel:{_tenantLocation.PhoneNumber}")" class="rs-crumb">@_tenantLocation.PhoneNumber</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(_tenantLocation.Email))
                                {
                                    <a href="@($"mailto:{_tenantLocation.Email}")" class="rs-crumb">@_tenantLocation.Email</a>
                                }
                            </div>
                        }
                    </div>

                    <!-- Date Selection -->
                    <div class="product-details-dates">
                        <h3>Wybierz okres wypożyczenia</h3>
                        <div class="product-details-dates-grid">
                            <div>
                                <label class="block text-sm font-medium text-gray-600 mb-2">Data rozpoczęcia</label>
                                <input type="datetime-local"
                                       @bind="startDate"
                                       @bind:format="yyyy-MM-ddTHH:mm"
                                       min="@EarliestStartLocal.ToString("yyyy-MM-ddTHH:mm")"
                                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-purple-500 focus:outline-none" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-600 mb-2">Data zakończenia</label>
                                <input type="datetime-local"
                                       @bind="endDate"
                                       @bind:format="yyyy-MM-ddTHH:mm"
                                       min="@startDate?.AddHours(1).ToString("yyyy-MM-ddTHH:mm")"
                                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-purple-500 focus:outline-none" />
                            </div>
                        </div>
                        
                        @* Typ wynajmu *@
                        <div class="mt-4 flex items-center gap-4">
                            <div class="flex-1">
                                <label class="block text-sm font-medium text-gray-600 mb-2">Typ wynajmu</label>
                                <select @bind="selectedRentalType"
                                        class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-purple-500 focus:outline-none">
                                    <option value="0">Dzienny</option>
                                    @if (product.HourlyPrice.HasValue && product.HourlyPrice.Value > 0)
                                    {
                                        <option value="1">Godzinowy</option>
                                    }
                                </select>
                            </div>
                            @if (selectedRentalType == 1)
                            {
                                <div class="flex-1">
                                    <label class="block text-sm font-medium text-gray-600 mb-2">Liczba godzin</label>
                                    <input type="number" 
                                           @bind="selectedHours"
                                           min="1" max="24"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-purple-500 focus:outline-none" />
                                </div>
                            }
                        </div>
                        
                        @if (startDate.HasValue && endDate.HasValue && endDate > startDate)
                        {
                            var days = Math.Max(1, (int)Math.Ceiling((endDate.Value - startDate.Value).TotalDays));
                            decimal totalPrice;
                            string priceDescription;
                            
                            if (selectedRentalType == 1 && product.HourlyPrice.HasValue && product.HourlyPrice.Value > 0)
                            {
                                totalPrice = product.HourlyPrice.Value * selectedHours;
                                priceDescription = $"{selectedHours} godz. × {product.HourlyPrice.Value.Pln()}";
                            }
                            else
                            {
                                totalPrice = product.DailyPrice * days;
                                priceDescription = $"{days} dni × {product.DailyPrice.Pln()}";
                            }
                            
                            <div class="mt-4 p-4 bg-purple-50 rounded-xl" style="background:#FEF2F2">
                                <div class="flex justify-between items-center">
                                    <span class="text-gray-600">@priceDescription</span>
                                    <span class="text-xl font-bold text-purple-600" style="color:#E0454C">= @totalPrice.Pln()</span>
                                </div>
                            </div>
                            <p class="text-xs text-gray-500 mt-1">Cena orientacyjna; dokładna wycena z regułami sezonowymi pojawi się w koszyku.</p>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(product.Description))
                    {
                        <p class="product-details-description">@product.Description</p>
                    }
                    else
                    {
                        <p class="product-details-description text-gray-400 italic">Szczegółowy opis będzie wkrótce dostępny.</p>
                    }

                    <div class="product-details-actions">
                        <button class="product-details-add-btn" 
                                disabled="@(product.AvailableQuantity <= 0 || !product.IsAvailable)"
                                @onclick="AddToCart">
                            Dodaj do koszyka
                        </button>
                        <button class="product-details-back-btn" @onclick="GoBack">
                            ← Wróć
                        </button>
                    </div>
                </div>
            </div>

            <!-- Related Products -->
            @if (relatedProducts.Any())
            {
                <div class="related-products">
                    <h2>Polecane dla Ciebie</h2>
                    <div class="related-products-grid">
                        @foreach (var related in relatedProducts)
                        {
                            <div class="related-product-card"
                                 role="link"
                                 tabindex="0"
                                 aria-label="@RelatedProductAriaLabel(related)"
                                 @onclick="@(() => NavigateToProduct(related.Id))"
                                 @onkeydown="@(args => OpenRelatedProductFromKeyboard(args, related.Id))">
                                @{
                                    var relatedImage = related.GetImageUrl(400);
                                    if (string.IsNullOrWhiteSpace(relatedImage))
                                    {
                                        relatedImage = related.FullImageUrl;
                                    }
                                }
                                @if (!string.IsNullOrWhiteSpace(relatedImage))
                                {
                                    <img src="@relatedImage"
                                         data-fallback-src="@related.ImageUrl"
                                         alt="@related.Name"
                                         class="related-product-image"
                                         onerror="srImg(this)" />
                                }
                                else
                                {
                                    <div class="related-product-image bg-gray-100 flex items-center justify-center text-4xl"></div>
                                }
                                <div class="related-product-info">
                                    @if (product is not null && related.TenantId != product.TenantId)
                                    {
                                        <div class="related-product-other-tenant">Inna wypożyczalnia</div>
                                    }
                                    <div class="related-product-name">@related.Name</div>
                                    <div class="related-product-tenant">
                                        @(string.IsNullOrWhiteSpace(related.TenantName) ? "Wypożyczalnia partnerska" : related.TenantName)
                                    </div>
                                    <div class="related-product-pickup">
                                        <span aria-hidden="true">📍</span>
                                        <span>@RelatedPickupDisplay(related)</span>
                                    </div>
                                    <div class="related-product-price">@related.DailyPrice.Pln() / dzień</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
} @* End of Desktop UI *@

<!-- Lightbox Dialog -->
<MudDialog @bind-Visible="_showLightbox" Options="@(new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraExtraLarge, CloseButton = true, CloseOnEscapeKey = true })">
    <DialogContent>
        <div class="text-center p-4">
            <h3 class="text-xl font-bold mb-4">@_lightboxImageTitle</h3>
            <img src="@_lightboxImageUrl"
                 data-fallback-src="@_lightboxFallbackUrl"
                 alt="@_lightboxImageTitle"
                 class="max-w-full max-h-[80vh] mx-auto rounded-lg"
                 onerror="srImg(this)" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@CloseLightbox" Color="Color.Primary" Variant="Variant.Text">Zamknij</MudButton>
        <MudButton Href="@_lightboxImageUrl" Target="_blank" Color="Color.Secondary" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Download">
            Pobierz
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Guid Id { get; set; }

    private ProductDto? product;
    private List<ProductDto> relatedProducts = new();
    private TenantLocationDto? _tenantLocation;
    private bool isLoading = true;
    private bool notFound;
    private string? _loadError;
    private DateTime? startDate;
    private DateTime? endDate;
    private int selectedRentalType = 0; // 0 = Daily, 1 = Hourly
    private int selectedHours = 1;
    private DateTime EarliestStartLocal => PolishRentalTime.EarliestStartLocal();
    
    // Mobile state
    private bool _isMobile = false;
    private DotNetObjectReference<ProductDetails>? _dotNetRef;

    protected override async Task OnParametersSetAsync()
    {
        await LoadProductAsync();
    }

    private async Task LoadProductAsync()
    {
        isLoading = true;
        notFound = false;
        _loadError = null;
        product = null;
        _tenantLocation = null;
        relatedProducts.Clear();

        try
        {
            product = await ApiService.GetProductAsync(Id);
            if (product is null)
            {
                notFound = true;
                return;
            }

            var todayInPoland = PolishRentalTime.TodayLocal;
            startDate ??= todayInPoland.AddDays(1).AddHours(9);
            endDate ??= todayInPoland.AddDays(2).AddHours(17);

            // Products from one shop form one rental. If this shop is already in the
            // cart, show its canonical terms instead of suggesting that this product
            // can have a separate period or rental type.
            var tenantTemplate = CartService.GetCart().Items
                .FirstOrDefault(item => item.TenantId == product.TenantId);
            if (tenantTemplate is not null)
            {
                startDate = tenantTemplate.StartDate;
                endDate = tenantTemplate.EndDate;
                selectedRentalType = (int)tenantTemplate.RentalType;
                selectedHours = tenantTemplate.HoursRented ?? 1;
            }

            await LoadTenantLocationAsync(product.TenantId);
            await LoadRelatedProductsAsync(product);
        }
        catch (Exception ex)
        {
            _loadError = "Sprawdź połączenie i ponów próbę.";
            Snackbar.Add("Nie udało się wczytać produktu.", Severity.Error);
            Console.Error.WriteLine($"Nie udało się wczytać produktu {Id}: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("setupMobileDetection", _dotNetRef);
        }
    }
    
    [JSInvokable]
    public void OnScreenResize(bool isMobile)
    {
        if (_isMobile != isMobile)
        {
            _isMobile = isMobile;
            InvokeAsync(StateHasChanged);
        }
    }
    
    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("removeMobileDetection");
        }
        catch { }
        _dotNetRef?.Dispose();
    }

    private async Task LoadRelatedProductsAsync(ProductDto current)
    {
        try
        {
            var catalog = await ApiService.GetProductsAsync(1, 200);
            IEnumerable<ProductDto> candidates = catalog.Where(p => p.Id != current.Id);

            if (!string.IsNullOrWhiteSpace(current.Category))
            {
                var sameCategory = candidates.Where(p => string.Equals(p.Category, current.Category, StringComparison.OrdinalIgnoreCase)).ToList();
                if (sameCategory.Count >= 4)
                {
                    candidates = sameCategory;
                }
                else if (sameCategory.Any())
                {
                    var remainder = candidates.Except(sameCategory).OrderByDescending(p => p.IsAvailable).ThenBy(p => p.Name);
                    candidates = sameCategory.Concat(remainder);
                }
            }

            relatedProducts = candidates
                .OrderByDescending(p => p.IsAvailable)
                .ThenBy(p => Math.Abs(p.DailyPrice - current.DailyPrice))
                .Take(4)
                .ToList();
        }
        catch
        {
            // Recommendations are optional
        }
    }

    private async Task LoadTenantLocationAsync(Guid tenantId)
    {
        try
        {
            _tenantLocation = (await ApiService.GetTenantLocationsAsync())
                .FirstOrDefault(location => location.TenantId == tenantId);
        }
        catch
        {
            // Dane punktu są pomocnicze; produkt nadal pozostaje możliwy do obejrzenia.
        }
    }

    private static string RelatedPickupDisplay(ProductDto related) =>
        !string.IsNullOrWhiteSpace(related.PickupAddress)
            ? related.PickupAddress.Trim()
            : related.GetPickupDisplayText();

    private static string RelatedProductAriaLabel(ProductDto related)
    {
        var tenantName = string.IsNullOrWhiteSpace(related.TenantName)
            ? "wypożyczalnia partnerska"
            : related.TenantName.Trim();
        return $"Zobacz polecany produkt {related.Name}, {tenantName}, odbiór: {RelatedPickupDisplay(related)}";
    }

    private string ProductPickupDisplay(ProductDto currentProduct)
    {
        var address = !string.IsNullOrWhiteSpace(currentProduct.PickupAddress)
            ? currentProduct.PickupAddress
            : _tenantLocation?.Address;
        if (!string.IsNullOrWhiteSpace(address))
            return address.Trim();

        var city = !string.IsNullOrWhiteSpace(currentProduct.City)
            ? currentProduct.City
            : _tenantLocation?.City;
        return !string.IsNullOrWhiteSpace(city)
            ? city.Trim()
            : currentProduct.GetPickupDisplayText();
    }

    private async Task AddToCart()
    {
        if (product is null) return;

        var tenantTemplate = product.TenantId == Guid.Empty
            ? null
            : CartService.GetCart().Items.FirstOrDefault(item => item.TenantId == product.TenantId);
        var effectiveStartDate = tenantTemplate?.StartDate ?? startDate;
        var requestedRentalType = (RentalTypeDto)selectedRentalType;
        var rentalType = tenantTemplate?.RentalType ?? requestedRentalType;
        var hours = rentalType == RentalTypeDto.Hourly
            ? tenantTemplate?.HoursRented ?? selectedHours
            : (int?)null;
        var effectiveEndDate = tenantTemplate?.EndDate ??
            (requestedRentalType == RentalTypeDto.Hourly && startDate.HasValue
                ? startDate.Value.AddHours(Math.Clamp(selectedHours, 1, 24))
                : endDate);

        if (!effectiveStartDate.HasValue || !effectiveEndDate.HasValue || effectiveEndDate <= effectiveStartDate)
        {
            Snackbar.Add("Wybierz poprawny okres wypożyczenia.", Severity.Warning);
            return;
        }

        if (!PolishRentalTime.TryToUtc(effectiveStartDate.Value, out var startUtc) ||
            !PolishRentalTime.TryToUtc(effectiveEndDate.Value, out _))
        {
            Snackbar.Add("Wybrana godzina nie istnieje z powodu zmiany czasu. Wybierz inny termin.", Severity.Warning);
            return;
        }

        if (!PolishRentalTime.IsStartSafelyInFuture(startUtc, DateTime.UtcNow))
        {
            Snackbar.Add("Data rozpoczęcia musi być co najmniej 2 minuty w przyszłości.", Severity.Warning);
            return;
        }

        try
        {
            await CartService.AddToCartAsync(product, 1, effectiveStartDate, effectiveEndDate);

            var tenantItems = CartService.GetCart().Items
                .Where(item => item.TenantId == product.TenantId)
                .ToList();
            var addedItem = tenantItems.FirstOrDefault(item => item.ProductId == product.Id);
            var reusedTenantTerms = tenantTemplate is not null ||
                                    tenantItems.Count > 1 ||
                                    addedItem?.Quantity > 1;

            // For the first product the selected type initializes the tenant rental.
            // Later products already inherit the complete canonical terms in CartService;
            // overwriting only their type would split one tenant group into two contracts.
            if (!reusedTenantTerms)
                await CartService.UpdateRentalTypeAsync(product.Id, rentalType, hours);

            if (reusedTenantTerms && addedItem is not null)
            {
                startDate = addedItem.StartDate;
                endDate = addedItem.EndDate;
                selectedRentalType = (int)addedItem.RentalType;
                selectedHours = addedItem.HoursRented ?? 1;
            }

            var holdSecured = await CartService.EnsureHoldsAsync();
            addedItem = CartService.GetCart().Items.FirstOrDefault(item => item.ProductId == product.Id);
            if (!holdSecured || addedItem?.HoldId is null)
            {
                Snackbar.Add(
                    CartService.LastHoldError
                    ?? $"Nie udało się zarezerwować produktu {product.Name}. Produkt pozostał w koszyku bez aktywnej rezerwacji — zmień termin lub spróbuj ponownie.",
                    Severity.Error);
                return;
            }

            var tenantName = string.IsNullOrWhiteSpace(product.TenantName)
                ? "wypożyczalni"
                : product.TenantName;
            Snackbar.Add(
                reusedTenantTerms
                    ? $"Produkt {product.Name} dodany do rezerwacji w {tenantName}. Obowiązuje wspólny termin i typ wynajmu tej wypożyczalni."
                    : $"Produkt {product.Name} zarezerwowany w {tenantName} i dodany do koszyka.",
                Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add(
                $"Nie udało się dodać produktu {product.Name} do koszyka. Spróbuj ponownie.",
                Severity.Error);
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("products");
    }

    private void NavigateToProduct(Guid id)
    {
        Navigation.NavigateTo($"products/{id}");
    }

    private void OpenRelatedProductFromKeyboard(KeyboardEventArgs args, Guid productId)
    {
        if (args.Key is "Enter" or " ")
        {
            NavigateToProduct(productId);
        }
    }

    // Image Lightbox
    private bool _showLightbox = false;
    private string _lightboxImageUrl = string.Empty;
    private string _lightboxFallbackUrl = string.Empty;
    private string _lightboxImageTitle = string.Empty;

    private void ShowImageLightbox(string imageUrl, string title, string? fallbackUrl)
    {
        _lightboxImageUrl = imageUrl;
        _lightboxFallbackUrl = fallbackUrl?.Trim() ?? string.Empty;
        _lightboxImageTitle = title;
        _showLightbox = true;
    }

    private void CloseLightbox()
    {
        _showLightbox = false;
    }
}
