@page "/cart"
@using SportRental.Shared.Models
@using SportRental.Shared.Services
@inject ICartService CartService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Koszyk — RentSpot</PageTitle>

@* ============================================
   MOBILE UI - Compact cart view
   ============================================ *@
@if (_isMobile)
{
    <div class="cart-mobile">
        <!-- Mobile Header -->
        <div class="cart-mobile-header">
            <div class="cart-mobile-title">
                <span>🛒</span>
                <h1>Koszyk</h1>
                @if (_cart.TotalItems > 0)
                {
                    <span class="cart-mobile-count">@_cart.TotalItems</span>
                }
            </div>
        </div>

        @if (_cart.Items.Count == 0)
        {
            <div class="cart-mobile-empty">
                <span class="empty-icon">🛒</span>
                <h3>Pusty koszyk</h3>
                <p>Dodaj sprzęt sportowy do koszyka</p>
                <a href="/products" class="cart-mobile-cta">📦 Przeglądaj katalog</a>
            </div>
        }
        else
        {
            <!-- Mobile Cart Items -->
            <div class="cart-mobile-items">
                @foreach (var item in _cart.Items)
                {
                    <div class="cart-mobile-item">
                        <div class="cart-mobile-item-header">
                            @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                            {
                                <img src="@item.ProductImageUrl" alt="@item.ProductName" class="cart-mobile-item-image" />
                            }
                            else
                            {
                                <div class="cart-mobile-item-placeholder">📦</div>
                            }
                            <div class="cart-mobile-item-info">
                                <h4>@item.ProductName</h4>
                                <span class="cart-mobile-item-price">@item.DailyPrice.ToString("C")/dzień</span>
                            </div>
                            <button class="cart-mobile-remove" @onclick="@(() => RemoveFromCart(item.ProductId))">✕</button>
                        </div>
                        
                        <div class="cart-mobile-item-dates">
                            <div class="cart-mobile-date">
                                <label>📅 Od</label>
                                <input type="date" 
                                       value="@item.StartDate.ToString("yyyy-MM-dd")" 
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       @onchange="@((e) => OnStartDateChanged(item, e))" />
                            </div>
                            <div class="cart-mobile-date">
                                <label>📅 Do</label>
                                <input type="date" 
                                       value="@item.EndDate.ToString("yyyy-MM-dd")" 
                                       min="@item.StartDate.AddDays(1).ToString("yyyy-MM-dd")"
                                       @onchange="@((e) => OnEndDateChanged(item, e))" />
                            </div>
                        </div>

                        <div class="cart-mobile-item-options">
                            <select value="@((int)item.RentalType)"
                                    @onchange="@((e) => OnRentalTypeChanged(item, e))"
                                    class="cart-mobile-select">
                                <option value="0">📅 Dzienny</option>
                                @if (item.HourlyPrice.HasValue && item.HourlyPrice.Value > 0)
                                {
                                    <option value="1">⏰ Godzinowy</option>
                                }
                            </select>
                            @if (item.RentalType == RentalTypeDto.Hourly)
                            {
                                <input type="number" 
                                       value="@(item.HoursRented ?? 1)"
                                       min="1" max="24"
                                       @onchange="@((e) => OnHoursChanged(item, e))"
                                       class="cart-mobile-hours" 
                                       placeholder="Godz." />
                            }
                        </div>

                        <div class="cart-mobile-item-footer">
                            <div class="cart-mobile-quantity">
                                <button @onclick="@(() => UpdateQuantity(item, item.Quantity - 1))">−</button>
                                <span>@item.Quantity</span>
                                <button @onclick="@(() => UpdateQuantity(item, item.Quantity + 1))">+</button>
                            </div>
                            <div class="cart-mobile-total">@item.TotalPrice.ToString("C")</div>
                        </div>

                        @if (item.HoldId is not null)
                        {
                            <div class="cart-mobile-hold">
                                ✅ Rezerwacja do @item.HoldExpiresAtUtc?.ToLocalTime().ToString("HH:mm")
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Mobile Summary - Sticky Bottom -->
            <div class="cart-mobile-summary">
                <div class="cart-mobile-summary-row">
                    <span>@_cart.TotalItems produktów</span>
                    <span class="cart-mobile-summary-total">@_cart.TotalAmount.ToString("C")</span>
                </div>
                <button class="cart-mobile-checkout" @onclick="ProceedToCheckout">
                    💳 Zamów • @_cart.TotalAmount.ToString("C")
                </button>
                <a href="/products" class="cart-mobile-continue">🛒 Kontynuuj zakupy</a>
            </div>
        }
    </div>
}
@* ============================================
   DESKTOP UI - Original design
   ============================================ *@
else
{
<div class="cart-container">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="cart-header">
            <h1>🛒 Twój Koszyk</h1>
            <p>Sprawdź wybrane produkty przed wypożyczeniem</p>
        </div>

        @if (_cart.Items.Count == 0)
        {
            <!-- Empty Cart -->
            <div class="cart-empty">
                <div class="cart-empty-icon">🛒</div>
                <h2>Twój koszyk jest pusty</h2>
                <p>Dodaj sprzęt sportowy, aby rozpocząć wypożyczenie</p>
                <a href="/products" class="cart-checkout-btn" style="max-width: 300px; margin: 0 auto; text-decoration: none;">
                    📦 Przeglądaj katalog
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Cart Items -->
                <div class="lg:col-span-2 space-y-4">
                    @foreach (var item in _cart.Items)
                    {
                        <div class="cart-item">
                            <!-- Image -->
                            @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                            {
                                <img src="@item.ProductImageUrl" alt="@item.ProductName" class="cart-item-image" />
                            }
                            else
                            {
                                <div class="cart-item-placeholder">📦</div>
                            }

                            <!-- Details -->
                            <div class="cart-item-details">
                                <h3>@item.ProductName</h3>
                                <p class="cart-item-price">@item.DailyPrice.ToString("C") / dzień</p>
                                
                                <div class="cart-item-dates">
                                    <div class="flex flex-col">
                                        <label class="text-xs text-gray-500 mb-1">📅 Od</label>
                                        <input type="date" 
                                               value="@item.StartDate.ToString("yyyy-MM-dd")" 
                                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                               @onchange="@((e) => OnStartDateChanged(item, e))"
                                               class="px-3 py-2 border rounded-lg text-sm" />
                                    </div>
                                    <div class="flex flex-col">
                                        <label class="text-xs text-gray-500 mb-1">📅 Do</label>
                                        <input type="date" 
                                               value="@item.EndDate.ToString("yyyy-MM-dd")" 
                                               min="@item.StartDate.AddDays(1).ToString("yyyy-MM-dd")"
                                               @onchange="@((e) => OnEndDateChanged(item, e))"
                                               class="px-3 py-2 border rounded-lg text-sm" />
                                    </div>
                                </div>

                                @* Typ wynajmu *@
                                <div class="flex items-center gap-3 mt-3">
                                    <div class="flex flex-col">
                                        <label class="text-xs text-gray-500 mb-1">🕐 Typ wynajmu</label>
                                        <select value="@((int)item.RentalType)"
                                                @onchange="@((e) => OnRentalTypeChanged(item, e))"
                                                class="px-3 py-2 border rounded-lg text-sm">
                                            <option value="0">📅 Dzienny</option>
                                            @if (item.HourlyPrice.HasValue && item.HourlyPrice.Value > 0)
                                            {
                                                <option value="1">⏰ Godzinowy</option>
                                            }
                                        </select>
                                    </div>
                                    @if (item.RentalType == RentalTypeDto.Hourly)
                                    {
                                        <div class="flex flex-col">
                                            <label class="text-xs text-gray-500 mb-1">Liczba godzin</label>
                                            <input type="number" 
                                                   value="@(item.HoursRented ?? 1)"
                                                   min="1" max="24"
                                                   @onchange="@((e) => OnHoursChanged(item, e))"
                                                   class="px-3 py-2 border rounded-lg text-sm w-20" />
                                        </div>
                                    }
                                </div>
                                
                                <p class="text-sm text-gray-500 mt-2">
                                    @if (item.RentalType == RentalTypeDto.Hourly && item.HoursRented.HasValue)
                                    {
                                        <span>⏱️ @item.HoursRented.Value godz. × @(item.HourlyPrice?.ToString("C") ?? "0 zł")/godz.</span>
                                    }
                                    else
                                    {
                                        <span>⏱️ @item.TotalDays dni × @item.DailyPrice.ToString("C")/dzień</span>
                                    }
                                </p>

                                @if (item.HoldId is not null)
                                {
                                    <div class="mt-2 px-3 py-1.5 bg-blue-50 text-blue-700 rounded-lg text-sm inline-flex items-center gap-1">
                                        ✅ Rezerwacja do @item.HoldExpiresAtUtc?.ToLocalTime().ToString("HH:mm:ss")
                                    </div>
                                }
                            </div>

                            <!-- Actions -->
                            <div class="cart-item-actions">
                                <div class="cart-quantity">
                                    <button @onclick="@(() => UpdateQuantity(item, item.Quantity - 1))">−</button>
                                    <span>@item.Quantity</span>
                                    <button @onclick="@(() => UpdateQuantity(item, item.Quantity + 1))">+</button>
                                </div>
                                
                                <div class="cart-item-total">@item.TotalPrice.ToString("C")</div>
                                
                                <button class="cart-remove-btn" @onclick="@(() => RemoveFromCart(item.ProductId))">
                                    🗑️ Usuń
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Summary -->
                <div class="lg:col-span-1">
                    <div class="cart-summary">
                        <h2>📋 Podsumowanie</h2>
                        
                        <div class="cart-summary-row">
                            <span>Produkty (@_cart.TotalItems)</span>
                            <span>@_cart.TotalAmount.ToString("C")</span>
                        </div>
                        
                        <div class="cart-summary-row">
                            <span>Dostawa</span>
                            <span class="text-green-600 font-medium">Gratis</span>
                        </div>
                        
                        <div class="cart-summary-row cart-summary-total">
                            <span>Łącznie</span>
                            <span class="text-xl text-purple-600">@_cart.TotalAmount.ToString("C")</span>
                        </div>

                        <button class="cart-checkout-btn" @onclick="ProceedToCheckout">
                            💳 Przejdź do płatności
                        </button>
                        
                        <button class="cart-continue-btn" @onclick="@(() => Navigation.NavigateTo("/products"))">
                            🛒 Kontynuuj zakupy
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
} @* End of Desktop UI *@

@code {
    private SportRental.Shared.Models.Cart _cart = new();
    private bool _isMobile = false;
    private DotNetObjectReference<Cart>? _dotNetRef;

    private CancellationTokenSource? _refreshCts;
    private Task? _refreshLoop;

    protected override void OnInitialized()
    {
        _cart = CartService.GetCart();
        CartService.CartChanged += OnCartChanged;
        StartRefreshLoop();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("setupMobileDetection", _dotNetRef);
        }
    }
    
    [JSInvokable]
    public void OnScreenResize(bool isMobile)
    {
        if (_isMobile != isMobile)
        {
            _isMobile = isMobile;
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnCartChanged(object? sender, EventArgs e)
    {
        _cart = CartService.GetCart();
        InvokeAsync(StateHasChanged);
    }

    private async Task UpdateQuantity(CartItem item, int newQuantity)
    {
        await CartService.UpdateQuantityAsync(item.ProductId, newQuantity);
    }

    private async Task RemoveFromCart(Guid productId)
    {
        await CartService.RemoveFromCartAsync(productId);
        Snackbar.Add("Produkt został usunięty z koszyka", Severity.Success);
    }

    private async Task OnStartDateChanged(CartItem item, ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var newDate))
        {
            if (newDate < DateTime.Today)
            {
                Snackbar.Add("Data rozpoczęcia nie może być z przeszłości", Severity.Warning);
                return;
            }

            item.StartDate = newDate;
            
            if (item.EndDate <= item.StartDate)
            {
                item.EndDate = item.StartDate.AddDays(1);
                Snackbar.Add("Data zakończenia została dostosowana", Severity.Info);
            }
            
            await CartService.UpdateDatesAsync(item.ProductId, item.StartDate, item.EndDate);
        }
    }

    private async Task OnEndDateChanged(CartItem item, ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var newDate))
        {
            if (newDate <= item.StartDate)
            {
                Snackbar.Add("Data zakończenia musi być późniejsza niż data rozpoczęcia", Severity.Warning);
                return;
            }

            var daysDiff = (newDate - item.StartDate).Days;
            if (daysDiff > 365)
            {
                Snackbar.Add("Maksymalny okres wypożyczenia to 365 dni", Severity.Warning);
                return;
            }

            item.EndDate = newDate;
            await CartService.UpdateDatesAsync(item.ProductId, item.StartDate, item.EndDate);
        }
    }

    private async Task OnRentalTypeChanged(CartItem item, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var typeValue))
        {
            var rentalType = (RentalTypeDto)typeValue;
            var hours = rentalType == RentalTypeDto.Hourly ? (item.HoursRented ?? 1) : (int?)null;
            await CartService.UpdateRentalTypeAsync(item.ProductId, rentalType, hours);
        }
    }

    private async Task OnHoursChanged(CartItem item, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var hours))
        {
            if (hours < 1) hours = 1;
            if (hours > 24) hours = 24;
            await CartService.UpdateRentalTypeAsync(item.ProductId, RentalTypeDto.Hourly, hours);
        }
    }

    private async Task ProceedToCheckout()
    {
        if (_cart.Items.Count == 0)
        {
            Snackbar.Add("Koszyk jest pusty", Severity.Warning);
            return;
        }

        foreach (var item in _cart.Items)
        {
            if (item.StartDate < DateTime.Today)
            {
                Snackbar.Add($"Data rozpoczęcia dla {item.ProductName} jest nieprawidłowa", Severity.Error);
                return;
            }

            if (item.EndDate <= item.StartDate)
            {
                Snackbar.Add($"Daty wypożyczenia dla {item.ProductName} są nieprawidłowe", Severity.Error);
                return;
            }
        }

        await CartService.RefreshHoldsIfNeededAsync();
        var holdsOk = await CartService.EnsureHoldsAsync();
        if (!holdsOk)
        {
            Snackbar.Add("Nie udało się zarezerwować wybranych produktów. Zaktualizuj koszyk i spróbuj ponownie.", Severity.Error);
            return;
        }

        var isAvailable = await CartService.ValidateAvailabilityAsync();
        if (!isAvailable)
        {
            var unavailableNames = _cart.Items
                .Where(i => CartService.LastUnavailableProductIds.Contains(i.ProductId))
                .Select(i => i.ProductName)
                .Distinct()
                .ToList();

            var message = unavailableNames.Count > 0
                ? $"Produkty niedostępne: {string.Join(", ", unavailableNames)}"
                : "Nie udało się potwierdzić dostępności produktów. Spróbuj ponownie.";

            Snackbar.Add(message, Severity.Error);
            return;
        }

        Navigation.NavigateTo("/checkout");
    }

    private void StartRefreshLoop()
    {
        _refreshCts = new CancellationTokenSource();
        var token = _refreshCts.Token;
        _refreshLoop = Task.Run(async () =>
        {
            try
            {
                while (!token.IsCancellationRequested)
                {
                    await CartService.RefreshHoldsIfNeededAsync();
                    await Task.Delay(TimeSpan.FromSeconds(60), token);
                }
            }
            catch (TaskCanceledException) { }
        }, token);
    }

    public async ValueTask DisposeAsync()
    {
        CartService.CartChanged -= OnCartChanged;
        _refreshCts?.Cancel();
        try
        {
            await JS.InvokeVoidAsync("removeMobileDetection");
        }
        catch { }
        _dotNetRef?.Dispose();
    }
}
