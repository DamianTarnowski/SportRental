@page "/contact"
@inject IApiService ApiService
@inject TenantService TenantService

<PageTitle>Kontakt — RentSpot</PageTitle>

<div class="min-h-[calc(100vh-7rem)] bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold text-gray-900 mb-4">Skontaktuj się z wypożyczalnią</h1>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                Wybierz punkt, którego dotyczy pytanie. Wiadomość trafi bezpośrednio do jego obsługi.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="bg-white rounded-2xl shadow-sm p-8 h-fit">
                <h2 class="text-2xl font-bold text-gray-900 mb-6">Dane wypożyczalni</h2>

                @if (_isLoadingLocations)
                {
                    <p class="text-gray-600">Pobieranie danych kontaktowych...</p>
                }
                else if (_selectedLocation is null)
                {
                    <div class="rounded-lg bg-gray-50 border border-gray-200 p-4 text-gray-600">
                        Wybierz wypożyczalnię w formularzu, aby zobaczyć jej dane kontaktowe.
                    </div>
                }
                else
                {
                    <div class="space-y-6">
                        <div>
                            <p class="text-sm text-gray-500">Wypożyczalnia</p>
                            <p class="font-semibold text-lg text-gray-900">@_selectedLocation.TenantName</p>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_selectedLocation.PhoneNumber))
                        {
                            <div>
                                <p class="text-sm text-gray-500">Telefon</p>
                                <a href="@($"tel:{_selectedLocation.PhoneNumber}")"
                                   style="color:#BC3138;font-weight:600;">
                                    @_selectedLocation.PhoneNumber
                                </a>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_selectedLocation.Email))
                        {
                            <div>
                                <p class="text-sm text-gray-500">Email</p>
                                <a href="@($"mailto:{_selectedLocation.Email}")"
                                   style="color:#BC3138;font-weight:600;">
                                    @_selectedLocation.Email
                                </a>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_selectedLocation.Address) ||
                             !string.IsNullOrWhiteSpace(_selectedLocation.City))
                        {
                            <div>
                                <p class="text-sm text-gray-500">Punkt odbioru i zwrotu</p>
                                @if (!string.IsNullOrWhiteSpace(_selectedLocation.Address))
                                {
                                    <p class="text-gray-900">@_selectedLocation.Address</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(_selectedLocation.City))
                                {
                                    <p class="text-gray-900">@_selectedLocation.City</p>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_selectedLocation.OpeningHours))
                        {
                            <div>
                                <p class="text-sm text-gray-500">Godziny otwarcia</p>
                                <p class="text-gray-900 whitespace-pre-line">@_selectedLocation.OpeningHours</p>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="bg-white rounded-2xl shadow-sm p-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-6">Wyślij wiadomość</h2>

                @if (_locationsError is not null)
                {
                    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg mb-4">
                        @_locationsError
                    </div>
                }

                <EditForm Model="@_formModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="space-y-4">
                        <div>
                            <label for="tenant" class="block text-sm font-medium text-gray-700 mb-1">Wypożyczalnia *</label>
                            <InputSelect id="tenant" @bind-Value="_formModel.TenantId"
                                         disabled="@_isLoadingLocations"
                                         class="w-full rounded-lg border border-gray-300 px-4 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                <option value="@Guid.Empty">Wybierz wypożyczalnię</option>
                                @foreach (var location in _locations)
                                {
                                    <option value="@location.TenantId">@location.TenantName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _formModel.TenantId)" class="text-red-600 text-sm mt-1" />
                        </div>

                        <div>
                            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Imię i nazwisko *</label>
                            <InputText id="name" @bind-Value="_formModel.Name"
                                       class="w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                       autocomplete="name" />
                            <ValidationMessage For="@(() => _formModel.Name)" class="text-red-600 text-sm mt-1" />
                        </div>

                        <div>
                            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
                            <InputText id="email" @bind-Value="_formModel.Email" type="email"
                                       class="w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                       autocomplete="email" />
                            <ValidationMessage For="@(() => _formModel.Email)" class="text-red-600 text-sm mt-1" />
                        </div>

                        <div>
                            <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Telefon</label>
                            <InputText id="phone" @bind-Value="_formModel.Phone" type="tel"
                                       class="w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                       autocomplete="tel" />
                            <ValidationMessage For="@(() => _formModel.Phone)" class="text-red-600 text-sm mt-1" />
                        </div>

                        <div>
                            <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Temat *</label>
                            <InputText id="subject" @bind-Value="_formModel.Subject"
                                       class="w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                            <ValidationMessage For="@(() => _formModel.Subject)" class="text-red-600 text-sm mt-1" />
                        </div>

                        <div>
                            <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Wiadomość *</label>
                            <InputTextArea id="message" @bind-Value="_formModel.Message" rows="7"
                                           class="w-full rounded-lg border border-gray-300 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                            <ValidationMessage For="@(() => _formModel.Message)" class="text-red-600 text-sm mt-1" />
                        </div>

                        <button type="submit"
                                disabled="@(_isSubmitting || _isLoadingLocations || _locations.Count == 0)"
                                class="w-full disabled:opacity-60 text-white font-semibold py-3 px-6 rounded-lg transition shadow-sm"
                                style="background:#BC3138;">
                            @(_isSubmitting ? "Wysyłanie..." : "Wyślij wiadomość")
                        </button>

                        @if (_submitSuccess)
                        {
                            <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg flex items-center gap-2"
                                 role="status">
                                <Icon Name="check" Size="20" />
                                <span>Wiadomość została przyjęta. Obsługa wypożyczalni odpowie na podany adres email.</span>
                            </div>
                        }

                        @if (_submitError is not null)
                        {
                            <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg" role="alert">
                                @_submitError
                            </div>
                        }
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tenantId")]
    private Guid? TenantIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "rentalId")]
    private Guid? RentalIdQuery { get; set; }

    private List<TenantLocationDto> _locations = [];
    private ContactMessageRequest _formModel = new();
    private bool _isLoadingLocations = true;
    private bool _isSubmitting;
    private bool _submitSuccess;
    private string? _locationsError;
    private string? _submitError;

    private TenantLocationDto? _selectedLocation =>
        _locations.FirstOrDefault(location => location.TenantId == _formModel.TenantId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _locations = (await ApiService.GetTenantLocationsAsync())
                .GroupBy(location => location.TenantId)
                .Select(group => group.First())
                .OrderBy(location => location.TenantName)
                .ToList();

            var savedTenantId = await TenantService.GetSelectedTenantIdAsync();
            if (TenantIdQuery is { } requestedTenantId &&
                _locations.Any(location => location.TenantId == requestedTenantId))
            {
                _formModel.TenantId = requestedTenantId;
            }
            else if (Guid.TryParse(savedTenantId, out var tenantId) &&
                _locations.Any(location => location.TenantId == tenantId))
            {
                _formModel.TenantId = tenantId;
            }
            else if (_locations.Count == 1)
            {
                _formModel.TenantId = _locations[0].TenantId;
            }

            if (RentalIdQuery is { } rentalId && string.IsNullOrWhiteSpace(_formModel.Subject))
            {
                _formModel.Subject =
                    $"Pytanie o rezerwację {rentalId.ToString("N")[..8].ToUpperInvariant()}";
            }

            if (_locations.Count == 0)
            {
                _locationsError = "Brak wypożyczalni dostępnych dla formularza kontaktowego.";
            }
        }
        catch (Exception)
        {
            _locationsError = "Nie udało się pobrać listy wypożyczalni. Spróbuj ponownie później.";
        }
        finally
        {
            _isLoadingLocations = false;
        }
    }

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _submitSuccess = false;
        _submitError = null;

        try
        {
            await ApiService.SendContactMessageAsync(_formModel);
            var selectedTenantId = _formModel.TenantId;
            _formModel = new ContactMessageRequest { TenantId = selectedTenantId };
            _submitSuccess = true;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.UnprocessableEntity)
        {
            _submitError = "Nie udało się przyjąć wiadomości. Sprawdź wybraną wypożyczalnię i dane formularza.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            _submitError = "Wysłano zbyt wiele wiadomości. Odczekaj chwilę i spróbuj ponownie.";
        }
        catch (Exception)
        {
            _submitError = "Nie udało się wysłać wiadomości. Spróbuj ponownie później.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
