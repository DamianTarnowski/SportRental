<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>_client</StaticWebAssetBasePath>
    <!-- Wyłącz generowanie web.config przez dotnet publish - używamy własnego -->
    <PublishIISAssets>false</PublishIISAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="MudBlazor" Version="8.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SportRental.Shared\SportRental.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Client WASM nie publikuje się już samodzielnie do żadnego hostingu. Od kwietnia 2026 jedyny
    aktualizowany endpoint to /_client/ wbudowany w Admin (sradmin.azurewebsites.net/_client/) —
    deploy idzie przez `dotnet publish SportRental.Admin`, który w swoim targetcie
    `PublishClientWasmIntoAdmin` wywołuje publish tego projektu i kopiuje output.

    Dawne targety (FixWebConfigAfterPublish dla srclient-blazor App Service + DeployToStaticWebAppAfterPublish
    dla SWA kind-tree) zostały usunięte — VS Publish trwał kilkanaście minut i wisiał na MSDeploy.
    Stare hostingi pozostają pod oryginalnymi URL-ami z ostatnim wdrożonym buildem (jako legacy).
  -->

</Project>
