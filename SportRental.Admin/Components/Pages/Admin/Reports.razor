@page "/admin/reports"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Owner,SuperAdmin")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject SportRental.Infrastructure.Tenancy.ITenantProvider TenantProvider
@inject ISnackbar Snackbar

<MudContainer Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Raporty</MudText>
    
    <MudGrid Spacing="3">
        <MudItem xs="12" md="6" lg="3">
            <MudDateRangePicker @bind-DateRange="dateRange" Label="Zakres dat" />
        </MudItem>
        <MudItem xs="12" md="6" lg="3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="LoadReports">
                Wygeneruj raporty
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-4" />
    }
    else if (reportData != null)
    {
        <MudGrid Spacing="3" Class="mt-4">
            <!-- Statystyki ogólne -->
            <MudItem xs="12">
                <MudPaper Class="p-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Statystyki ogólne (@dateRange?.Start?.ToString("yyyy-MM-dd") - @dateRange?.End?.ToString("yyyy-MM-dd"))</MudText>
                    <MudGrid>
                        <MudItem xs="6" md="3">
                            <MudStack Class="mud-align-center">
                                <MudText Typo="Typo.h4" Color="Color.Primary">@reportData.TotalRentals</MudText>
                                <MudText Typo="Typo.caption">Wynajmów</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudStack Class="mud-align-center">
                                <MudText Typo="Typo.h4" Color="Color.Success">@reportData.TotalRevenue.Pln()</MudText>
                                <MudText Typo="Typo.caption">Przychody</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudStack Class="mud-align-center">
                                <MudText Typo="Typo.h4" Color="Color.Info">@reportData.UniqueCustomers</MudText>
                                <MudText Typo="Typo.caption">Unikalnych klientów</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudStack Class="mud-align-center">
                                <MudText Typo="Typo.h4" Color="Color.Warning">@reportData.AverageRentalValue.Pln()</MudText>
                                <MudText Typo="Typo.caption">Średnia wartość</MudText>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <!-- Wykres wynajmów w czasie -->
            <MudItem xs="12" md="6">
                <MudPaper Class="p-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Wynajmy w czasie</MudText>
                    <MudChart ChartType="MudBlazor.ChartType.Line" 
                              XAxisLabels="@rentalsOverTimeLabels" 
                              ChartSeries="@rentalsOverTimeData" 
                              Width="100%" Height="300px" />
                </MudPaper>
            </MudItem>

            <!-- Wykres przychodów w czasie -->
            <MudItem xs="12" md="6">
                <MudPaper Class="p-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Przychody w czasie</MudText>
                    <MudChart ChartType="MudBlazor.ChartType.Line" 
                              XAxisLabels="@revenueOverTimeLabels" 
                              ChartSeries="@revenueOverTimeData" 
                              Width="100%" Height="300px" />
                </MudPaper>
            </MudItem>

            <!-- Top produkty -->
            <MudItem xs="12" md="6">
                <MudPaper Class="p-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Najpopularniejsze produkty</MudText>
                    <MudTable Items="reportData.TopProducts" Dense="true">
                        <HeaderContent>
                            <MudTh>Produkt</MudTh>
                            <MudTh>Wynajmy</MudTh>
                            <MudTh>Przychód</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.ProductName</MudTd>
                            <MudTd>@context.RentalsCount</MudTd>
                            <MudTd>@context.Revenue.Pln()</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>

            <!-- Top klienci -->
            <MudItem xs="12" md="6">
                <MudPaper Class="p-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Najlepsi klienci</MudText>
                    <MudTable Items="reportData.TopCustomers" Dense="true">
                        <HeaderContent>
                            <MudTh>Klient</MudTh>
                            <MudTh>Wynajmy</MudTh>
                            <MudTh>Przychód</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.CustomerName</MudTd>
                            <MudTd>@context.RentalsCount</MudTd>
                            <MudTd>@context.Revenue.Pln()</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>

            <!-- Statusy wynajmów -->
            <MudItem xs="12" md="6">
                <MudPaper Class="p-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Statusy wynajmów</MudText>
                    <MudChart ChartType="MudBlazor.ChartType.Pie"
                              ChartSeries="@statusData"
                              Width="100%" Height="300px" />
                </MudPaper>
            </MudItem>

            <!-- KPI tile: Avg rental duration + Avg rating -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="2" Style="border-radius: 16px;">
                    <MudText Typo="Typo.h6" Class="mb-3">Średnie wskaźniki</MudText>
                    <MudGrid>
                        <MudItem xs="6">
                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Info" Size="Size.Large" />
                                <MudText Typo="Typo.h4" Color="Color.Info">@reportData.AvgRentalDays.ToString("0.0")</MudText>
                                <MudText Typo="Typo.caption">średnia długość (dni)</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="6">
                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Large" />
                                <MudText Typo="Typo.h4" Color="Color.Warning">@(reportData.RatingCount > 0 ? reportData.AvgRating.ToString("0.0") : "—")</MudText>
                                <MudText Typo="Typo.caption">średnia ocena (@reportData.RatingCount opinii)</MudText>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <!-- Conversion & Cancellation -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="2" Style="border-radius: 16px;">
                    <MudText Typo="Typo.h6" Class="mb-3">Efektywność lejka</MudText>
                    <MudStack Spacing="3">
                        <div>
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" Class="mr-1" />Conversion rate (Completed)</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight: 700;">@reportData.ConversionRate.ToString("0.0")%</MudText>
                            </MudStack>
                            <MudProgressLinear Value="@reportData.ConversionRate" Color="Color.Success" Size="Size.Small" Class="mt-1" />
                        </div>
                        <div>
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2"><MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error" Class="mr-1" />Cancellation rate</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight: 700;">@reportData.CancellationRate.ToString("0.0")%</MudText>
                            </MudStack>
                            <MudProgressLinear Value="@reportData.CancellationRate" Color="Color.Error" Size="Size.Small" Class="mt-1" />
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Top kategoria + Peak day -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="2" Style="border-radius: 16px;">
                    <MudText Typo="Typo.h6" Class="mb-3">Najlepsze segmenty</MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Default">Najmocniejsza kategoria</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Primary">@reportData.TopCategory</MudText>
                                <MudText Typo="Typo.body2">@reportData.TopCategoryRevenue.Pln() (@reportData.TopCategoryShare.ToString("0")%)</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Default">Najlepszy dzień tygodnia</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Info">@reportData.PeakDayOfWeek</MudText>
                                <MudText Typo="Typo.body2">@reportData.PeakDayRevenue.Pln()</MudText>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <!-- Klienci nowi vs powracający + martwe sprzęty -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="2" Style="border-radius: 16px;">
                    <MudText Typo="Typo.h6" Class="mb-3">Klienci i sprzęt</MudText>
                    <MudGrid>
                        <MudItem xs="4">
                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.h4" Color="Color.Success">@reportData.NewCustomers</MudText>
                                <MudText Typo="Typo.caption" Align="Align.Center">nowych klientów</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="4">
                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.h4" Color="Color.Info">@reportData.ReturningCustomers</MudText>
                                <MudText Typo="Typo.caption" Align="Align.Center">powracających</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="4">
                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.h4" Color="@(reportData.IdleProductsCount > 0 ? Color.Warning : Color.Success)">@reportData.IdleProductsCount</MudText>
                                <MudText Typo="Typo.caption" Align="Align.Center">sprzętów bez wynajmu</MudText>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <!-- Wykorzystanie produktów -->
            <MudItem xs="12" md="6">
                <MudPaper Class="p-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Wykorzystanie produktów (%)</MudText>
                    <MudTable Items="reportData.ProductUtilization" Dense="true">
                        <HeaderContent>
                            <MudTh>Produkt</MudTh>
                            <MudTh>Dni wypożyczone</MudTh>
                            <MudTh>Wykorzystanie</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.ProductName</MudTd>
                            <MudTd>@context.DaysRented</MudTd>
                            <MudTd>
                                <MudProgressLinear Value="@context.UtilizationPercent" Color="@GetUtilizationColor(context.UtilizationPercent)" />
                                <MudText Typo="Typo.caption">@context.UtilizationPercent.ToString("0.0")%</MudText>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private MudBlazor.DateRange? dateRange = new(DateTime.Today.AddDays(-30), DateTime.Today);
    private bool isLoading = false;
    private ReportData? reportData;

    // Chart data
    private string[] rentalsOverTimeLabels = Array.Empty<string>();
    private List<MudBlazor.ChartSeries> rentalsOverTimeData = new();
    private string[] revenueOverTimeLabels = Array.Empty<string>();
    private List<MudBlazor.ChartSeries> revenueOverTimeData = new();
    private List<MudBlazor.ChartSeries> statusData = new();

    private Guid TenantId => TenantProvider.GetCurrentTenantId() ?? Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async Task LoadReports()
    {
        if (dateRange?.Start == null || dateRange.End == null) return;

        isLoading = true;
        try
        {
            await using var Db = await DbFactory.CreateDbContextAsync();
            Db.SetTenant(TenantId);

            var startDate = DateTime.SpecifyKind(dateRange.Start.Value.Date, DateTimeKind.Local).ToUniversalTime();
            var endDate = DateTime.SpecifyKind(dateRange.End.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Local).ToUniversalTime();

            // Basic stats
            var allRentals = await Db.Rentals
                .Where(r => r.CreatedAtUtc >= startDate && r.CreatedAtUtc <= endDate)
                .ToListAsync();

            var totalRentals = allRentals.Count;
            var totalRevenue = allRentals.Sum(r => r.TotalAmount);
            var uniqueCustomers = allRentals.Select(r => r.CustomerId).Distinct().Count();
            var averageRentalValue = totalRentals > 0 ? totalRevenue / totalRentals : 0;

            // Top products
            var topProducts = await Db.RentalItems
                .Where(ri => Db.Rentals.Any(r => r.Id == ri.RentalId && r.CreatedAtUtc >= startDate && r.CreatedAtUtc <= endDate))
                .GroupBy(ri => ri.ProductId)
                .Select(g => new
                {
                    ProductId = g.Key,
                    RentalsCount = g.Count(),
                    Revenue = g.Sum(x => x.Subtotal)
                })
                .OrderByDescending(x => x.Revenue)
                .Take(10)
                .ToListAsync();

            var productIds = topProducts.Select(tp => tp.ProductId).ToList();
            var productNames = await Db.Products
                .Where(p => productIds.Contains(p.Id))
                .ToDictionaryAsync(p => p.Id, p => p.Name);

            var topProductsReport = topProducts.Select(tp => new TopProductReport
            {
                ProductName = productNames.GetValueOrDefault(tp.ProductId) ?? "Nieznany",
                RentalsCount = tp.RentalsCount,
                Revenue = tp.Revenue
            }).ToList();

            // Top customers
            var topCustomers = allRentals
                .GroupBy(r => r.CustomerId)
                .Select(g => new
                {
                    CustomerId = g.Key,
                    RentalsCount = g.Count(),
                    Revenue = g.Sum(x => x.TotalAmount)
                })
                .OrderByDescending(x => x.Revenue)
                .Take(10)
                .ToList();

            var customerIds = topCustomers.Select(tc => tc.CustomerId).ToList();
            var customerNames = await Db.Customers
                .Where(c => customerIds.Contains(c.Id))
                .ToDictionaryAsync(c => c.Id, c => c.FullName);

            var topCustomersReport = topCustomers.Select(tc => new TopCustomerReport
            {
                CustomerName = customerNames.GetValueOrDefault(tc.CustomerId) ?? "Nieznany",
                RentalsCount = tc.RentalsCount,
                Revenue = tc.Revenue
            }).ToList();

            // Status distribution
            var statusDistribution = allRentals
                .GroupBy(r => r.Status)
                .ToDictionary(g => g.Key, g => g.Count());

            // Product utilization (simplified - days in period)
            var totalDaysInPeriod = (endDate - startDate).Days;
            var productUtilization = await Db.RentalItems
                .Where(ri => Db.Rentals.Any(r => r.Id == ri.RentalId && r.StartDateUtc <= endDate && r.EndDateUtc >= startDate))
                .GroupBy(ri => ri.ProductId)
                .Select(g => new
                {
                    ProductId = g.Key,
                    DaysRented = g.Sum(ri => (int)(
                        Db.Rentals.Where(r => r.Id == ri.RentalId).Select(r => r.EndDateUtc).First() -
                        Db.Rentals.Where(r => r.Id == ri.RentalId).Select(r => r.StartDateUtc).First()).TotalDays + 1)
                })
                .OrderByDescending(x => x.DaysRented)
                .Take(10)
                .ToListAsync();

            var utilizationProductNames = await Db.Products
                .Where(p => productUtilization.Select(pu => pu.ProductId).Contains(p.Id))
                .ToDictionaryAsync(p => p.Id, p => p.Name);

            var productUtilizationReport = productUtilization.Select(pu => new ProductUtilizationReport
            {
                ProductName = utilizationProductNames.GetValueOrDefault(pu.ProductId) ?? "Nieznany",
                DaysRented = pu.DaysRented,
                UtilizationPercent = totalDaysInPeriod > 0 ? (double)pu.DaysRented / totalDaysInPeriod * 100 : 0
            }).ToList();

            // Time series data
            var dailyRentals = new List<int>();
            var dailyRevenue = new List<double>();
            var labels = new List<string>();

            for (var date = dateRange.Start.Value.Date; date <= dateRange.End.Value.Date; date = date.AddDays(1))
            {
                var dayStart = DateTime.SpecifyKind(date, DateTimeKind.Local).ToUniversalTime();
                var dayEnd = dayStart.AddDays(1).AddTicks(-1);
                
                var dayRentals = allRentals.Count(r => r.CreatedAtUtc >= dayStart && r.CreatedAtUtc <= dayEnd);
                var dayRevenue = allRentals.Where(r => r.CreatedAtUtc >= dayStart && r.CreatedAtUtc <= dayEnd).Sum(r => (double)r.TotalAmount);
                
                dailyRentals.Add(dayRentals);
                dailyRevenue.Add(dayRevenue);
                labels.Add(date.ToString("MM-dd"));
            }

            // Prepare chart data
            rentalsOverTimeLabels = labels.ToArray();
            rentalsOverTimeData = new List<MudBlazor.ChartSeries>
            {
                new MudBlazor.ChartSeries { Name = "Wynajmy", Data = dailyRentals.Select(x => (double)x).ToArray() }
            };

            revenueOverTimeLabels = labels.ToArray();
            revenueOverTimeData = new List<MudBlazor.ChartSeries>
            {
                new MudBlazor.ChartSeries { Name = "Przychody (zł)", Data = dailyRevenue.ToArray() }
            };

            statusData = statusDistribution
                .Select(kvp => new MudBlazor.ChartSeries
                {
                    Name = GetStatusText(kvp.Key),
                    Data = new[] { (double)kvp.Value }
                })
                .ToList();

            // === Nowe metryki ===
            // Średni czas wynajmu (z Completed wynajmów)
            var completedRentals = allRentals.Where(r => r.Status == RentalStatus.Completed).ToList();
            var avgRentalDays = completedRentals.Count > 0
                ? completedRentals.Average(r => (r.EndDateUtc - r.StartDateUtc).TotalDays)
                : 0;

            // Top kategoria — group by Product.Category przez RentalItems
            var allItemsInPeriod = await Db.RentalItems
                .Where(ri => Db.Rentals.Any(r => r.Id == ri.RentalId && r.CreatedAtUtc >= startDate && r.CreatedAtUtc <= endDate))
                .Join(Db.Products, ri => ri.ProductId, p => p.Id, (ri, p) => new { p.Category, ri.Subtotal })
                .ToListAsync();
            var categoryTotals = allItemsInPeriod
                .GroupBy(x => x.Category ?? "Inne")
                .Select(g => new { Cat = g.Key, Rev = g.Sum(x => x.Subtotal) })
                .OrderByDescending(x => x.Rev)
                .FirstOrDefault();

            // Conversion / Cancellation rate
            var completedCount = allRentals.Count(r => r.Status == RentalStatus.Completed);
            var cancelledCount = allRentals.Count(r => r.Status == RentalStatus.Cancelled);
            var conversionRate = totalRentals > 0 ? (double)completedCount / totalRentals * 100 : 0;
            var cancellationRate = totalRentals > 0 ? (double)cancelledCount / totalRentals * 100 : 0;

            // Sprzęty bez wynajmu w okresie (produkty z 0 rentalitemami)
            var rentedProductIds = allItemsInPeriod.Select(_ => (Guid?)null).ToList(); // need product ids
            var rentedIdsSet = (await Db.RentalItems
                .Where(ri => Db.Rentals.Any(r => r.Id == ri.RentalId && r.CreatedAtUtc >= startDate && r.CreatedAtUtc <= endDate))
                .Select(ri => ri.ProductId)
                .Distinct()
                .ToListAsync()).ToHashSet();
            var totalActiveProducts = await Db.Products.Where(p => p.IsActive).CountAsync();
            var idleProductsCount = totalActiveProducts - rentedIdsSet.Count;

            // Średnia ocena z RentalReview w okresie
            var reviewsInPeriod = await Db.Set<RentalReview>()
                .Where(rev => rev.CreatedAtUtc >= startDate && rev.CreatedAtUtc <= endDate)
                .Select(rev => new { rev.QualityScore, rev.PriceScore, rev.ServiceScore })
                .ToListAsync();
            var avgRating = reviewsInPeriod.Count > 0
                ? reviewsInPeriod.Average(r => (r.QualityScore + r.PriceScore + r.ServiceScore) / 3.0)
                : 0;
            var ratingCount = reviewsInPeriod.Count;

            // Dzień tygodnia z największymi przychodami
            var revenueByDayOfWeek = allRentals
                .GroupBy(r => r.CreatedAtUtc.ToLocalTime().DayOfWeek)
                .Select(g => new { Day = g.Key, Rev = g.Sum(x => x.TotalAmount) })
                .OrderByDescending(x => x.Rev)
                .FirstOrDefault();
            var peakDayName = revenueByDayOfWeek == null ? "—" : revenueByDayOfWeek.Day switch
            {
                DayOfWeek.Monday => "Poniedziałek",
                DayOfWeek.Tuesday => "Wtorek",
                DayOfWeek.Wednesday => "Środa",
                DayOfWeek.Thursday => "Czwartek",
                DayOfWeek.Friday => "Piątek",
                DayOfWeek.Saturday => "Sobota",
                DayOfWeek.Sunday => "Niedziela",
                _ => "—"
            };

            // Nowi vs powracający klienci w okresie
            var customerFirstRentalDates = await Db.Rentals
                .Where(r => allRentals.Select(ar => ar.CustomerId).Contains(r.CustomerId))
                .GroupBy(r => r.CustomerId)
                .Select(g => new { CustomerId = g.Key, FirstRental = g.Min(r => r.CreatedAtUtc) })
                .ToListAsync();
            var newCustomers = customerFirstRentalDates.Count(c => c.FirstRental >= startDate);
            var returningCustomers = uniqueCustomers - newCustomers;

            reportData = new ReportData
            {
                TotalRentals = totalRentals,
                TotalRevenue = totalRevenue,
                UniqueCustomers = uniqueCustomers,
                AverageRentalValue = averageRentalValue,
                AvgRentalDays = avgRentalDays,
                TopCategory = categoryTotals?.Cat ?? "—",
                TopCategoryRevenue = categoryTotals?.Rev ?? 0,
                TopCategoryShare = (totalRevenue > 0 && categoryTotals != null) ? (double)(categoryTotals.Rev / totalRevenue) * 100 : 0,
                ConversionRate = conversionRate,
                CancellationRate = cancellationRate,
                IdleProductsCount = idleProductsCount,
                AvgRating = avgRating,
                RatingCount = ratingCount,
                PeakDayOfWeek = peakDayName,
                PeakDayRevenue = revenueByDayOfWeek?.Rev ?? 0,
                NewCustomers = newCustomers,
                ReturningCustomers = returningCustomers,
                TopProducts = topProductsReport,
                TopCustomers = topCustomersReport,
                ProductUtilization = productUtilizationReport
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd podczas generowania raportów: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private Color GetUtilizationColor(double percent)
    {
        return percent switch
        {
            >= 80 => Color.Success,
            >= 60 => Color.Warning,
            >= 40 => Color.Info,
            _ => Color.Default
        };
    }

    private string GetStatusText(RentalStatus status) => status switch
    {
        RentalStatus.Draft => "Szkic",
        RentalStatus.Confirmed => "Potwierdzony",
        RentalStatus.Active => "Aktywny",
        RentalStatus.Completed => "Zakończony",
        RentalStatus.Cancelled => "Anulowany",
        _ => status.ToString()
    };

    private class ReportData
    {
        public int TotalRentals { get; set; }
        public decimal TotalRevenue { get; set; }
        public int UniqueCustomers { get; set; }
        public decimal AverageRentalValue { get; set; }
        // Nowe metryki:
        public double AvgRentalDays { get; set; }
        public string TopCategory { get; set; } = "—";
        public decimal TopCategoryRevenue { get; set; }
        public double TopCategoryShare { get; set; } // % całości
        public double ConversionRate { get; set; } // % Completed
        public double CancellationRate { get; set; } // % Cancelled
        public int IdleProductsCount { get; set; }
        public double AvgRating { get; set; }
        public int RatingCount { get; set; }
        public string PeakDayOfWeek { get; set; } = "—";
        public decimal PeakDayRevenue { get; set; }
        public int NewCustomers { get; set; }
        public int ReturningCustomers { get; set; }
        public List<TopProductReport> TopProducts { get; set; } = new();
        public List<TopCustomerReport> TopCustomers { get; set; } = new();
        public List<ProductUtilizationReport> ProductUtilization { get; set; } = new();
    }

    private class TopProductReport
    {
        public string ProductName { get; set; } = string.Empty;
        public int RentalsCount { get; set; }
        public decimal Revenue { get; set; }
    }

    private class TopCustomerReport
    {
        public string CustomerName { get; set; } = string.Empty;
        public int RentalsCount { get; set; }
        public decimal Revenue { get; set; }
    }

    private class ProductUtilizationReport
    {
        public string ProductName { get; set; } = string.Empty;
        public int DaysRented { get; set; }
        public double UtilizationPercent { get; set; }
    }
}
