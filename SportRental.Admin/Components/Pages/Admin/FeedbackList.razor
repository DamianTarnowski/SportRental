@page "/admin/feedback"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Owner,SuperAdmin")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using SportRental.Admin.Services.Chat
@using SportRental.Infrastructure.Domain

@inject FeedbackService FeedbackService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @* Banner DS v2 navy *@
    <MudPaper Class="rs-page-banner pa-6 mb-4" Elevation="0">
        <MudStack Row="true" Class="mud-align-center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.Feedback" Size="Size.Large" />
            <div style="flex: 1;">
                <MudText Typo="Typo.h4" Style="font-weight: 700;">Zgłoszenia od użytkowników</MudText>
                <MudText Typo="Typo.subtitle1" Style="opacity: 0.9;">
                    @if (_feedbacks.Count == 0)
                    {
                        <text>Wszystko czysto — brak zgłoszeń</text>
                    }
                    else
                    {
                        var open = _feedbacks.Count(f => !f.IsResolved);
                        <text>@_feedbacks.Count @(_feedbacks.Count == 1 ? "zgłoszenie" : "zgłoszeń") · @open otwartych · @(_feedbacks.Count - open) rozwiązanych</text>
                    }
                </MudText>
            </div>
            @if (_isSuperAdmin)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: #FFFFFF; border-color: rgba(255,255,255,0.4);">
                    SuperAdmin · cross-tenant
                </MudChip>
            }
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true" Style="border-radius: 12px;">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudSelect T="FeedbackType?" @bind-Value="_filterType" Label="Typ" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 160px;" Clearable="true">
                <MudSelectItem T="FeedbackType?" Value="@((FeedbackType?)null)">— wszystkie —</MudSelectItem>
                <MudSelectItem T="FeedbackType?" Value="@((FeedbackType?)FeedbackType.Bug)">Błędy</MudSelectItem>
                <MudSelectItem T="FeedbackType?" Value="@((FeedbackType?)FeedbackType.Suggestion)">Sugestie</MudSelectItem>
                <MudSelectItem T="FeedbackType?" Value="@((FeedbackType?)FeedbackType.Question)">Pytania</MudSelectItem>
                <MudSelectItem T="FeedbackType?" Value="@((FeedbackType?)FeedbackType.Praise)">Pochwały</MudSelectItem>
                <MudSelectItem T="FeedbackType?" Value="@((FeedbackType?)FeedbackType.General)">Ogólne</MudSelectItem>
            </MudSelect>

            <MudSelect T="bool?" @bind-Value="_filterResolved" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 160px;" Clearable="true">
                <MudSelectItem T="bool?" Value="@((bool?)null)">— wszystkie —</MudSelectItem>
                <MudSelectItem T="bool?" Value="@((bool?)false)">Otwarte</MudSelectItem>
                <MudSelectItem T="bool?" Value="@((bool?)true)">Rozwiązane</MudSelectItem>
            </MudSelect>

            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">
                Odśwież
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (_isLoading)
    {
        <MudPaper Class="pa-6 text-center" Elevation="0" Outlined="true" Style="border-radius: 16px;">
            <MudProgressCircular Indeterminate="true" />
        </MudPaper>
    }
    else if (_feedbacks.Count == 0)
    {
        @* Empty state — onboarding hint *@
        <MudPaper Class="pa-6 text-center" Elevation="0" Outlined="true" Style="border-radius: 16px;">
            <MudIcon Icon="@Icons.Material.Filled.MarkChatRead" Size="Size.Large" Color="Color.Default" Class="mb-3" Style="opacity: 0.4;" />
            <MudText Typo="Typo.h6" Style="font-weight: 600;">Brak zgłoszeń</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                Tutaj będą się pojawiać zgłoszenia, sugestie i pytania od użytkowników.
                Mogą je dodawać przez przycisk czatu w prawym dolnym rogu (Wsparcie / Zgłoś sugestię).
            </MudText>
        </MudPaper>
    }
    else if (Filtered.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Brak zgłoszeń pasujących do filtra.</MudAlert>
    }
    else
    {
        <MudStack Spacing="2">
            @foreach (var f in Filtered)
            {
                <MudPaper Class="pa-3" Elevation="1" Style="@(f.IsResolved ? "opacity: 0.7;" : "")">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                        <MudStack Spacing="1" Style="flex: 1; min-width: 0;">
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudChip T="string" Size="Size.Small" Color="@TypeColor(f.Type)" Variant="Variant.Filled"
                                         Icon="@TypeIcon(f.Type)">
                                    @TypeLabel(f.Type)
                                </MudChip>
                                @if (f.IsResolved)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">Rozwiązane</MudChip>
                                }
                                <MudText Typo="Typo.caption" Color="Color.Default">
                                    @f.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @f.UserEmail (@f.UserRole)
                                </MudText>
                                @if (_isSuperAdmin)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">tenant: @ShortGuid(f.TenantId)</MudChip>
                                }
                            </MudStack>

                            <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@f.Message</MudText>

                            @if (!string.IsNullOrWhiteSpace(f.CurrentPage))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Default">
                                    strona: <code>@f.CurrentPage</code>
                                </MudText>
                            }

                            @if (f.IsResolved)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success">
                                    Zamknięte przez @f.ResolvedBy @f.ResolvedAtUtc?.ToLocalTime().ToString("dd.MM HH:mm")
                                    @if (!string.IsNullOrWhiteSpace(f.ResolutionNotes)) { <span>· @f.ResolutionNotes</span> }
                                </MudText>
                            }
                        </MudStack>

                        @if (!f.IsResolved)
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                       OnClick="() => ResolveAsync(f)">
                                Oznacz jako rozwiązane
                            </MudButton>
                        }
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    }
</MudContainer>

@code {
    private List<UserFeedback> _feedbacks = new();
    private bool _isLoading = true;
    private bool _isSuperAdmin;
    private Guid? _myTenantId;
    private string? _myEmail;
    private FeedbackType? _filterType;
    private bool? _filterResolved;

    private List<UserFeedback> Filtered =>
        _feedbacks
            .Where(f => !_filterType.HasValue || f.Type == _filterType.Value)
            .Where(f => !_filterResolved.HasValue || f.IsResolved == _filterResolved.Value)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var u = auth.User;
        _isSuperAdmin = u.IsInRole("SuperAdmin");
        _myEmail = u.FindFirst(ClaimTypes.Name)?.Value ?? u.FindFirst(ClaimTypes.Email)?.Value;
        if (Guid.TryParse(u.FindFirst("tenant-id")?.Value, out var tid)) _myTenantId = tid;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            // SuperAdmin: tenantId = null → wszystkie cross-tenant.
            // Owner: tylko swój tenant.
            var scopeTenantId = _isSuperAdmin ? (Guid?)null : _myTenantId;
            _feedbacks = await FeedbackService.ListAsync(scopeTenantId, type: null, isResolved: null, limit: 500);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd pobierania zgłoszeń: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ResolveAsync(UserFeedback f)
    {
        try
        {
            await FeedbackService.ResolveAsync(f.Id, _myEmail ?? "system", null);
            f.IsResolved = true;
            f.ResolvedAtUtc = DateTime.UtcNow;
            f.ResolvedBy = _myEmail;
            Snackbar.Add("Oznaczono jako rozwiązane", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się: {ex.Message}", Severity.Error);
        }
    }

    private static Color TypeColor(FeedbackType t) => t switch
    {
        FeedbackType.Bug => Color.Error,
        FeedbackType.Suggestion => Color.Info,
        FeedbackType.Question => Color.Warning,
        FeedbackType.Praise => Color.Success,
        _ => Color.Default
    };

    private static string TypeLabel(FeedbackType t) => t switch
    {
        FeedbackType.Bug => "Błąd",
        FeedbackType.Suggestion => "Sugestia",
        FeedbackType.Question => "Pytanie",
        FeedbackType.Praise => "Pochwała",
        _ => "Ogólne"
    };

    private static string TypeIcon(FeedbackType t) => t switch
    {
        FeedbackType.Bug => Icons.Material.Filled.BugReport,
        FeedbackType.Suggestion => Icons.Material.Filled.Lightbulb,
        FeedbackType.Question => Icons.Material.Filled.HelpOutline,
        FeedbackType.Praise => Icons.Material.Filled.Star,
        _ => Icons.Material.Filled.ChatBubbleOutline
    };

    private static string ShortGuid(Guid g) => g.ToString("N").Substring(0, 8);
}
