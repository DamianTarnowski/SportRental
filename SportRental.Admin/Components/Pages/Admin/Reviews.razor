@page "/admin/reviews"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Owner,SuperAdmin,Employee")]

@using SportRental.Infrastructure.Data
@using SportRental.Infrastructure.Domain
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @* Page banner — Maciej DS v2 navy flat *@
    <MudPaper Class="rs-page-banner pa-6 mb-4" Elevation="0">
        <MudStack Row="true" Class="mud-align-center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.RateReview" Size="Size.Large" />
            <div style="flex: 1;">
                <MudText Typo="Typo.h4" Style="font-weight: 700;">Opinie klientów</MudText>
                <MudText Typo="Typo.subtitle1" Style="opacity: 0.9;">
                    @if (_reviews.Count == 0)
                    {
                        <text>Średnia ocena pojawi się po pierwszej recenzji</text>
                    }
                    else
                    {
                        <text>@_reviews.Count @(_reviews.Count == 1 ? "opinia" : "opinii") · średnia @_reviews.Average(r => r.AverageScore).ToString("0.0")/10</text>
                    }
                </MudText>
            </div>
        </MudStack>
    </MudPaper>

    @* Average rating header (Maciej) — tylko gdy są opinie *@
    @if (_reviews.Count > 0)
    {
        <MudGrid Class="mb-3" Spacing="2">
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="0" Outlined="true" Class="pa-3 text-center" Style="border-radius: 12px;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Średnia ocena</MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: 700; color: var(--mud-palette-success);">@_reviews.Average(r => r.AverageScore).ToString("0.0")/10</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_reviews.Count opinii</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="0" Outlined="true" Class="pa-3 text-center" Style="border-radius: 12px;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">5★ (8-10)</MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: 700;">@_reviews.Count(r => r.AverageScore >= 8)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="0" Outlined="true" Class="pa-3 text-center" Style="border-radius: 12px;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Odpowiedzi właściciela</MudText>
                    <MudText Typo="Typo.h3" Style="font-weight: 700;">@_reviews.Count(r => !string.IsNullOrEmpty(r.OwnerReply))/@_reviews.Count</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true" Style="border-radius: 12px;">
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudSwitch T="bool" @bind-Value="_showHidden" Color="Color.Warning" Label="Pokaż ukryte" />
                <MudTextField @bind-Value="_search" Placeholder="Szukaj (imię, komentarz)..."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 240px;" />
            </MudStack>
        </MudPaper>
    }

    @if (_isLoading)
    {
        <MudPaper Class="pa-6 text-center" Elevation="0" Outlined="true" Style="border-radius: 16px;">
            <MudProgressCircular Indeterminate="true" />
        </MudPaper>
    }
    else if (_reviews.Count == 0)
    {
        @* Empty state — onboarding hint (Maciej: „Po zwrocie automat prosi o opinię") *@
        <MudPaper Class="pa-6 text-center" Elevation="0" Outlined="true" Style="border-radius: 16px;">
            <MudIcon Icon="@Icons.Material.Filled.RateReview" Size="Size.Large" Color="Color.Default" Class="mb-3" Style="opacity: 0.4;" />
            <MudText Typo="Typo.h6" Style="font-weight: 600;">Jeszcze żadnych opinii</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                System automatycznie poprosi klienta o opinię po zakończonym wynajmie
                (email + SMS w odstępach +24h, +3d, +7d od zwrotu).
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                Tutaj zobaczysz wszystkie opinie i będziesz mógł na nie odpowiedzieć.
            </MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Settings"
                       Href="/admin/company-settings" Class="mt-3">
                Sprawdź ustawienia powiadomień
            </MudButton>
        </MudPaper>
    }
    else if (Filtered.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Brak opinii pasujących do filtra.</MudAlert>
    }
    else
    {
        <MudStack Spacing="2">
            @foreach (var r in Filtered)
            {
                <MudPaper Class="pa-3" Elevation="1" Style="@(r.IsHidden ? "opacity: 0.6;" : "")">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-2" Wrap="Wrap.Wrap">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">@r.CustomerName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @r.CustomerEmail · @r.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </MudText>
                        </MudStack>
                        <MudStack Row="true" Spacing="1">
                            @if (r.IsHidden)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Ukryta</MudChip>
                            }
                            <MudIconButton Icon="@(r.IsHidden ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                           Size="Size.Small"
                                           Color="@(r.IsHidden ? Color.Success : Color.Warning)"
                                           OnClick="@(() => ToggleHiddenAsync(r))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => DeleteAsync(r))" />
                        </MudStack>
                    </MudStack>

                    <MudStack Row="true" Spacing="2" Class="mb-2" Wrap="Wrap.Wrap">
                        <MudChip T="string" Size="Size.Small" Color="@ColorFor(r.QualityScore)">Jakość: @r.QualityScore/10</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="@ColorFor(r.PriceScore)">Cena: @r.PriceScore/10</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="@ColorFor(r.ServiceScore)">Obsługa: @r.ServiceScore/10</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Średnia: @r.AverageScore.ToString("0.0")/10</MudChip>
                    </MudStack>

                    @if (!string.IsNullOrWhiteSpace(r.Comment))
                    {
                        <MudText Typo="Typo.body2">@r.Comment</MudText>
                    }

                    @* Odpowiedź właściciela (Maciej) *@
                    @if (!string.IsNullOrWhiteSpace(r.OwnerReply))
                    {
                        <MudPaper Class="pa-2 mt-2" Elevation="0" Style="border-radius: 8px; background: var(--surface-brand-tint, #FEF2F2); border-left: 3px solid var(--coral-500, #F96167);">
                            <MudText Typo="Typo.caption" Style="font-weight: 600;">
                                Odpowiedź właściciela · @r.OwnerReplyAtUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </MudText>
                            <MudText Typo="Typo.body2">@r.OwnerReply</MudText>
                        </MudPaper>
                    }
                    else
                    {
                        <MudExpansionPanels Elevation="0" Class="mt-2">
                            <MudExpansionPanel Text="Dodaj odpowiedź właściciela">
                                <MudTextField @bind-Value="r.ReplyDraft"
                                              Label="Twoja odpowiedź"
                                              Lines="2"
                                              Variant="Variant.Outlined" />
                                <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Reply"
                                           OnClick="@(() => SaveReplyAsync(r))">
                                    Opublikuj odpowiedź
                                </MudButton>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    }
                </MudPaper>
            }
        </MudStack>
    }
</MudContainer>

@code {
    private List<ReviewRow> _reviews = new();
    private bool _isLoading = true;
    private bool _showHidden = true;
    private string _search = string.Empty;
    private Guid? _tenantId;

    private List<ReviewRow> Filtered =>
        _reviews
            .Where(r => _showHidden || !r.IsHidden)
            .Where(r => string.IsNullOrWhiteSpace(_search)
                        || (r.CustomerName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                        || (r.Comment?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        // Blazor Server circuit nie ma HttpContext z X-Tenant-Id ani wygodnie dostępnego JWT,
        // więc tenant bierzemy bezpośrednio z ApplicationUser zalogowanego admina.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var appUser = await UserManager.GetUserAsync(authState.User);
        _tenantId = appUser?.TenantId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        var tenantId = _tenantId ?? Guid.Empty;

        await using var db = await DbFactory.CreateDbContextAsync();
        _reviews = await db.RentalReviews.IgnoreQueryFilters()
            .AsNoTracking()
            .Where(r => r.TenantId == tenantId)
            .OrderByDescending(r => r.CreatedAtUtc)
            .Select(r => new ReviewRow
            {
                Id = r.Id,
                RentalId = r.RentalId,
                CustomerName = r.Customer != null ? r.Customer.FullName : "Klient",
                CustomerEmail = r.Customer != null ? r.Customer.Email : null,
                QualityScore = r.QualityScore,
                PriceScore = r.PriceScore,
                ServiceScore = r.ServiceScore,
                Comment = r.Comment,
                OwnerReply = r.OwnerReply,
                OwnerReplyAtUtc = r.OwnerReplyAtUtc,
                IsHidden = r.IsHidden,
                CreatedAtUtc = r.CreatedAtUtc
            })
            .ToListAsync();

        _isLoading = false;
    }

    private async Task ToggleHiddenAsync(ReviewRow row)
    {
        var tenantId = _tenantId ?? Guid.Empty;

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.RentalReviews.IgnoreQueryFilters()
            .FirstOrDefaultAsync(r => r.Id == row.Id && r.TenantId == tenantId);
        if (entity == null)
        {
            Snackbar.Add("Opinia nie znaleziona.", Severity.Warning);
            return;
        }

        entity.IsHidden = !entity.IsHidden;
        await db.SaveChangesAsync();

        row.IsHidden = entity.IsHidden;
        Snackbar.Add(entity.IsHidden ? "Opinia ukryta." : "Opinia przywrócona.", Severity.Success);
    }

    private async Task DeleteAsync(ReviewRow row)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Usunąć opinię?",
            "Tej operacji nie można cofnąć.",
            yesText: "Usuń",
            cancelText: "Anuluj");

        if (confirmed != true) return;

        var tenantId = _tenantId ?? Guid.Empty;

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.RentalReviews.IgnoreQueryFilters()
            .FirstOrDefaultAsync(r => r.Id == row.Id && r.TenantId == tenantId);
        if (entity == null)
        {
            Snackbar.Add("Opinia nie znaleziona.", Severity.Warning);
            return;
        }

        db.RentalReviews.Remove(entity);
        await db.SaveChangesAsync();

        _reviews.RemoveAll(x => x.Id == row.Id);
        Snackbar.Add("Opinia usunięta.", Severity.Success);
    }

    private static Color ColorFor(int score) => score switch
    {
        >= 8 => Color.Success,
        >= 5 => Color.Warning,
        _ => Color.Error
    };

    private class ReviewRow
    {
        public Guid Id { get; set; }
        public Guid RentalId { get; set; }
        public string CustomerName { get; set; } = string.Empty;
        public string? CustomerEmail { get; set; }
        public int QualityScore { get; set; }
        public int PriceScore { get; set; }
        public int ServiceScore { get; set; }
        public double AverageScore => (QualityScore + PriceScore + ServiceScore) / 3.0;
        public string? Comment { get; set; }
        public string? OwnerReply { get; set; }
        public DateTime? OwnerReplyAtUtc { get; set; }
        public string? ReplyDraft { get; set; }
        public bool IsHidden { get; set; }
        public DateTime CreatedAtUtc { get; set; }
    }

    private async Task SaveReplyAsync(ReviewRow row)
    {
        if (string.IsNullOrWhiteSpace(row.ReplyDraft))
        {
            Snackbar.Add("Wpisz treść odpowiedzi.", Severity.Warning);
            return;
        }
        var tenantId = _tenantId ?? Guid.Empty;
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.RentalReviews.IgnoreQueryFilters()
            .FirstOrDefaultAsync(r => r.Id == row.Id && r.TenantId == tenantId);
        if (entity == null)
        {
            Snackbar.Add("Opinia nie znaleziona.", Severity.Warning);
            return;
        }
        entity.OwnerReply = row.ReplyDraft.Trim();
        entity.OwnerReplyAtUtc = DateTime.UtcNow;
        await db.SaveChangesAsync();

        row.OwnerReply = entity.OwnerReply;
        row.OwnerReplyAtUtc = entity.OwnerReplyAtUtc;
        row.ReplyDraft = null;
        Snackbar.Add("Odpowiedź dodana.", Severity.Success);
    }
}
