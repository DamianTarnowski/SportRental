@page "/admin/equipment-handling"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Owner,SuperAdmin,Employee")]

@using SportRental.Infrastructure.Data
@using SportRental.Infrastructure.Domain
@using Microsoft.EntityFrameworkCore

@using SportRental.Infrastructure.Tenancy
@using Microsoft.AspNetCore.Identity

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<EquipmentHandling> Logger
@inject ITenantProvider TenantProvider
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

@if (_isMobile)
{
    @* ==================== MOBILE UI ==================== *@
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-2 px-2">
        @* Nagłówek mobilny *@
        <MudPaper Class="rs-page-banner-sm pa-3 mb-2" Elevation="0">
            <div class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.h6" Style="font-weight: 700;">Obsługa sprzętu</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" 
                               Color="Color.Inherit" 
                               OnClick="LoadData" />
            </div>
        </MudPaper>

        @* Taby mobilne *@
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2" Style="border-radius: 12px;">
            <MudTabPanel Text="Wydanie" Icon="@Icons.Material.Filled.Output" BadgeData="@_toIssueCount" BadgeColor="Color.Warning">
                @if (_toIssueRentals == null)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (!_toIssueRentals.Any())
                {
                    <MudAlert Severity="Severity.Success" Dense="true">✓ Brak do wydania</MudAlert>
                }
                else
                {
                    <MudStack Spacing="1">
                        @foreach (var rental in _toIssueRentals)
                        {
                            <MudCard Elevation="2" Style="border-radius: 10px; border-left: 3px solid #ff9800;">
                                <MudCardContent Class="pa-2">
                                    <div class="d-flex align-center gap-2">
                                        <MudAvatar Color="Color.Warning" Size="Size.Medium">
                                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                        </MudAvatar>
                                        <div class="flex-1 overflow-hidden">
                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                                @(rental.Customer?.FullName ?? "—")
                                            </MudText>
                                            <div class="d-flex align-center gap-1 flex-wrap">
                                                <MudText Typo="Typo.caption">@rental.StartDateUtc.ToLocalTime().ToString("dd.MM HH:mm")</MudText>
                                                <MudText Typo="Typo.caption">•</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Success">@rental.TotalAmount.PlnInt()</MudText>
                                            </div>
                                            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                                                @string.Join(", ", rental.Items.Select(i => $"{i.Product?.Name} x{i.Quantity}").Take(2))
                                                @if (rental.Items.Count > 2) { <text>...</text> }
                                            </MudText>
                                        </div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Output" 
                                                       Color="Color.Success" 
                                                       OnClick="() => IssueEquipment(rental)" />
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        }
                    </MudStack>
                }
            </MudTabPanel>
            
            <MudTabPanel Text="Zwrot" Icon="@Icons.Material.Filled.Input" BadgeData="@_toReturnCount" BadgeColor="Color.Error">
                @if (_toReturnRentals == null)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (!_toReturnRentals.Any())
                {
                    <MudAlert Severity="Severity.Success" Dense="true">✓ Brak do zwrotu</MudAlert>
                }
                else
                {
                    <MudStack Spacing="1">
                        @foreach (var rental in _toReturnRentals)
                        {
                            var isOverdue = rental.EndDateUtc < DateTime.UtcNow;
                            <MudCard Elevation="2" Style="@($"border-radius: 10px; border-left: 3px solid {(isOverdue ? "#f44336" : "#4caf50")};")">
                                <MudCardContent Class="pa-2">
                                    <div class="d-flex align-center gap-2">
                                        <MudAvatar Color="@(isOverdue ? Color.Error : Color.Success)" Size="Size.Medium">
                                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                        </MudAvatar>
                                        <div class="flex-1 overflow-hidden">
                                            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                                @(rental.Customer?.FullName ?? "—")
                                            </MudText>
                                            <div class="d-flex align-center gap-1 flex-wrap">
                                                @if (isOverdue)
                                                {
                                                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Po terminie</MudChip>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.caption">Zwrot do: @rental.EndDateUtc.ToLocalTime().ToString("dd.MM HH:mm")</MudText>
                                                }
                                            </div>
                                            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                                                @string.Join(", ", rental.Items.Select(i => i.Product?.Name).Take(2))
                                                @if (rental.Items.Count > 2) { <text>...</text> }
                                            </MudText>
                                        </div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Input" 
                                                       Color="@(isOverdue ? Color.Error : Color.Primary)" 
                                                       OnClick="() => ReturnEquipment(rental)" />
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        }
                    </MudStack>
                }
            </MudTabPanel>
            
            <MudTabPanel Text="Historia" Icon="@Icons.Material.Filled.History">
                @if (_historyRentals == null)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (!_historyRentals.Any())
                {
                    <MudAlert Severity="Severity.Info" Dense="true">Brak historii</MudAlert>
                }
                else
                {
                    <MudStack Spacing="1">
                        @foreach (var rental in _historyRentals.Take(20))
                        {
                            <MudCard Elevation="1" Style="border-radius: 8px;">
                                <MudCardContent Class="pa-2">
                                    <div class="d-flex align-center gap-2">
                                        <MudAvatar Color="@GetStatusColor(rental.Status)" Size="Size.Small">
                                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                        </MudAvatar>
                                        <div class="flex-1">
                                            <MudText Typo="Typo.body2">@(rental.Customer?.FullName ?? "—")</MudText>
                                            <div class="d-flex align-center gap-1">
                                                <MudText Typo="Typo.caption">
                                                    @(rental.ReturnedAtUtc?.ToLocalTime().ToString("dd.MM") ?? rental.IssuedAtUtc?.ToLocalTime().ToString("dd.MM") ?? "—")
                                                </MudText>
                                                <MudChip T="string" Color="@GetStatusColor(rental.Status)" Size="Size.Small">
                                                    @GetStatusText(rental.Status)
                                                </MudChip>
                                            </div>
                                        </div>
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        }
                    </MudStack>
                }
            </MudTabPanel>
        </MudTabs>
    </MudContainer>
}
else
{
    @* ==================== DESKTOP UI ==================== *@
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
        <MudPaper Class="rs-page-banner pa-6 mb-4" Elevation="0">
            <MudStack Row="true" Class="mud-align-center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h4" Style="font-weight: 700;">Obsługa sprzętu</MudText>
                    <MudText Typo="Typo.subtitle1" Style="opacity: 0.9;">Wydawanie i przyjmowanie zwrotów sprzętu</MudText>
                </div>
            </MudStack>
        </MudPaper>

        <MudTabs Elevation="4" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Style="border-radius: 16px;">
            <MudTabPanel Text="Do wydania" Icon="@Icons.Material.Filled.Output" BadgeData="@_toIssueCount" BadgeColor="Color.Warning">
                <MudText Typo="Typo.h6" Class="mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Output" Class="mr-2" />
                    Wypożyczenia oczekujące na wydanie sprzętu
                </MudText>
                
                @if (_toIssueRentals == null)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else if (!_toIssueRentals.Any())
                {
                    <MudAlert Severity="Severity.Info" Elevation="0">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" />
                        Brak wypożyczeń oczekujących na wydanie sprzętu
                    </MudAlert>
                }
                else
                {
                    <MudStack Spacing="3">
                        @foreach (var rental in _toIssueRentals)
                        {
                            var prio = GetIssuePriority(rental);
                            var borderColor = prio.Color == Color.Error ? "#C8362B" : prio.Color == Color.Warning ? "#DD8413" : "#1F9D61";
                            <MudCard Elevation="0" Outlined="true" Style="@($"border-radius: 12px; border-left: 4px solid {borderColor};")">
                                <MudCardContent>
                                    <MudGrid Spacing="2" Class="mud-align-center">
                                        <MudItem xs="12" md="6">
                                            <MudStack Spacing="1">
                                                <MudStack Row="true" Class="mud-align-center" Spacing="2">
                                                    <MudAvatar Color="@prio.Color" Size="Size.Medium">
                                                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                                                    </MudAvatar>
                                                    <div>
                                                        <MudText Typo="Typo.h6">@(rental.Customer?.FullName ?? "Nieznany klient")</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Default">
                                                            @(rental.Customer?.Email ?? rental.Customer?.PhoneNumber ?? "")
                                                        </MudText>
                                                    </div>
                                                </MudStack>

                                                <MudStack Row="true" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap">
                                                    <MudChip T="string" Color="@prio.Color" Size="Size.Small" Variant="Variant.Filled">
                                                        @prio.Label
                                                    </MudChip>
                                                    <MudChip T="string" Icon="@GetSourceIcon(rental.Source)"
                                                             Color="@GetSourceColor(rental.Source)"
                                                             Size="Size.Small"
                                                             Variant="Variant.Outlined">
                                                        @GetSourceText(rental.Source)
                                                    </MudChip>
                                                    <MudChip T="string" Icon="@Icons.Material.Filled.CalendarMonth"
                                                             Color="Color.Default"
                                                             Variant="Variant.Outlined"
                                                             Size="Size.Small">
                                                        @rental.StartDateUtc.ToLocalTime().ToString("dd.MM HH:mm") - @rental.EndDateUtc.ToLocalTime().ToString("dd.MM HH:mm")
                                                    </MudChip>
                                                </MudStack>
                                                
                                                <MudText Typo="Typo.body2" Class="mt-2">
                                                    <strong>Produkty:</strong>
                                                    @string.Join(", ", rental.Items.Select(i => $"{i.Product?.Name} x{i.Quantity}"))
                                                </MudText>
                                            </MudStack>
                                        </MudItem>
                                        
                                        <MudItem xs="12" md="3">
                                            <MudStack Spacing="1">
                                                <MudText Typo="Typo.body2">
                                                    <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" />
                                                    Kwota: <strong>@rental.TotalAmount.Pln()</strong>
                                                </MudText>
                                                <MudText Typo="Typo.body2">
                                                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" />
                                                    Depozyt: <strong>@rental.DepositAmount.Pln()</strong>
                                                </MudText>
                                                <MudText Typo="Typo.body2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Payment" Size="Size.Small" />
                                                    Płatność: <strong>@rental.PaymentStatus</strong>
                                                </MudText>
                                            </MudStack>
                                        </MudItem>
                                        
                                        <MudItem xs="12" md="3">
                                            <MudButton Variant="Variant.Filled" 
                                                       Color="Color.Success" 
                                                       StartIcon="@Icons.Material.Filled.Output"
                                                       OnClick="() => IssueEquipment(rental)"
                                                       FullWidth="true"
                                                       Size="Size.Large"
                                                       Class="rounded-lg">
                                                Wydaj sprzęt
                                            </MudButton>
                                        </MudItem>
                                    </MudGrid>
                                </MudCardContent>
                            </MudCard>
                        }
                    </MudStack>
                }
            </MudTabPanel>
            
            <MudTabPanel Text="Do zwrotu" Icon="@Icons.Material.Filled.Input" BadgeData="@_toReturnCount" BadgeColor="Color.Error">
                <MudText Typo="Typo.h6" Class="mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Input" Class="mr-2" />
                    Wypożyczenia oczekujące na zwrot sprzętu
                </MudText>
                
                @if (_toReturnRentals == null)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else if (!_toReturnRentals.Any())
                {
                    <MudAlert Severity="Severity.Info" Elevation="0">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" />
                        Brak wypożyczeń oczekujących na zwrot
                    </MudAlert>
                }
                else
                {
                    <MudStack Spacing="3">
                        @foreach (var rental in _toReturnRentals)
                        {
                            var prio = GetReturnPriority(rental);
                            var borderColor = prio.Color == Color.Error ? "#C8362B" : prio.Color == Color.Warning ? "#DD8413" : "#1F9D61";
                            <MudCard Elevation="0" Outlined="true" Style="@($"border-radius: 12px; border-left: 4px solid {borderColor};")">
                                <MudCardContent>
                                    <MudGrid Spacing="2" Class="mud-align-center">
                                        <MudItem xs="12" md="5">
                                            <MudStack Spacing="1">
                                                <MudStack Row="true" Class="mud-align-center" Spacing="2">
                                                    <MudAvatar Color="@prio.Color" Size="Size.Medium">
                                                        <MudIcon Icon="@Icons.Material.Filled.Person" />
                                                    </MudAvatar>
                                                    <div>
                                                        <MudText Typo="Typo.h6">@(rental.Customer?.FullName ?? "Nieznany klient")</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Default">
                                                            @(rental.Customer?.Email ?? rental.Customer?.PhoneNumber ?? "")
                                                        </MudText>
                                                    </div>
                                                </MudStack>

                                                <MudStack Row="true" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap">
                                                    <MudChip T="string" Color="@prio.Color" Size="Size.Small" Variant="Variant.Filled">
                                                        @prio.Label
                                                    </MudChip>
                                                    <MudChip T="string" Icon="@Icons.Material.Filled.Schedule"
                                                             Color="@prio.Color"
                                                             Variant="Variant.Outlined"
                                                             Size="Size.Small">
                                                        @SportRental.Shared.Formatting.TimeRemaining.Format(rental.EndDateUtc)
                                                    </MudChip>
                                                    <MudChip T="string" Icon="@GetSourceIcon(rental.Source)"
                                                             Color="@GetSourceColor(rental.Source)"
                                                             Size="Size.Small"
                                                             Variant="Variant.Outlined">
                                                        @GetSourceText(rental.Source)
                                                    </MudChip>
                                                </MudStack>
                                                
                                                <MudText Typo="Typo.body2" Class="mt-2">
                                                    <strong>Produkty:</strong>
                                                    @string.Join(", ", rental.Items.Select(i => $"{i.Product?.Name} x{i.Quantity}"))
                                                </MudText>
                                            </MudStack>
                                        </MudItem>
                                        
                                        <MudItem xs="12" md="4">
                                            <MudStack Spacing="1">
                                                <MudText Typo="Typo.body2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Output" Size="Size.Small" />
                                                    Wydano: <strong>@(rental.IssuedAtUtc?.ToLocalTime().ToString("dd.MM HH:mm") ?? "-")</strong>
                                                </MudText>
                                                <MudText Typo="Typo.body2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                                    Termin zwrotu: <strong>@rental.EndDateUtc.ToLocalTime().ToString("dd.MM HH:mm")</strong>
                                                </MudText>
                                                <MudText Typo="Typo.body2">
                                                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" />
                                                    Depozyt: <strong>@rental.DepositAmount.Pln()</strong>
                                                </MudText>
                                            </MudStack>
                                        </MudItem>
                                        
                                        <MudItem xs="12" md="3">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="@prio.Color"
                                                       StartIcon="@Icons.Material.Filled.Input"
                                                       OnClick="() => ReturnEquipment(rental)"
                                                       FullWidth="true"
                                                       Size="Size.Large"
                                                       Class="rounded-lg">
                                                Przyjmij zwrot
                                            </MudButton>
                                        </MudItem>
                                    </MudGrid>
                                </MudCardContent>
                            </MudCard>
                        }
                    </MudStack>
                }
            </MudTabPanel>
            
            <MudTabPanel Text="Historia" Icon="@Icons.Material.Filled.History">
                <MudText Typo="Typo.h6" Class="mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
                    Historia wydań i zwrotów (ostatnie 30 dni)
                </MudText>
                
                @if (_historyRentals == null)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else if (!_historyRentals.Any())
                {
                    <MudAlert Severity="Severity.Info" Elevation="0">
                        Brak historii wydań i zwrotów
                    </MudAlert>
                }
                else
                {
                    @* NXRE QA #15+#16: tabela z expand-row pokazującym listę pozycji *@
                    <MudTable Items="@_historyRentals" Hover="true" Striped="false" Dense="true" Elevation="0" Outlined="true" Style="border-radius: 12px;">
                        <HeaderContent>
                            <MudTh Style="width: 24px;"></MudTh>
                            <MudTh>Klient</MudTh>
                            <MudTh>Źródło</MudTh>
                            <MudTh>Wydano</MudTh>
                            <MudTh>Zwrócono</MudTh>
                            <MudTh>Pozycje</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Depozyt zwrócony</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudIconButton Icon="@(_expandedRows.Contains(context.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                               Size="Size.Small"
                                               OnClick="@(() => ToggleHistoryRow(context.Id))" />
                            </MudTd>
                            <MudTd>@(context.Customer?.FullName ?? "-")</MudTd>
                            <MudTd>
                                <MudChip T="string" Icon="@GetSourceIcon(context.Source)"
                                         Color="@GetSourceColor(context.Source)"
                                         Size="Size.Small">
                                    @GetSourceText(context.Source)
                                </MudChip>
                            </MudTd>
                            <MudTd>@(context.IssuedAtUtc?.ToLocalTime().ToString("dd.MM HH:mm") ?? "-")</MudTd>
                            <MudTd>
                                @if (context.ReturnedAtUtc.HasValue)
                                {
                                    <span>@context.ReturnedAtUtc.Value.ToLocalTime().ToString("dd.MM HH:mm")</span>
                                }
                                else if (context.Status == RentalStatus.Completed)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">brak danych</MudChip>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.body2">@(context.Items?.Sum(i => i.Quantity) ?? 0) szt.</MudText>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">
                                    @GetStatusText(context.Status)
                                </MudChip>
                            </MudTd>
                            <MudTd>@(context.ReturnDepositRefund?.Pln() ?? "-")</MudTd>
                        </RowTemplate>
                        <ChildRowContent>
                            @if (_expandedRows.Contains(context.Id))
                            {
                                <MudTr>
                                    <td colspan="8" style="background: rgba(0,0,0,0.02); padding: 0.75rem 1.5rem;">
                                        <MudText Typo="Typo.caption" Style="font-weight: 600;">Pozycje:</MudText>
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-1">
                                            @if (context.Items != null)
                                            {
                                                @foreach (var item in context.Items)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                                        @(item.Product?.Name ?? "?") ×@item.Quantity
                                                    </MudChip>
                                                }
                                            }
                                        </MudStack>
                                        @if (!string.IsNullOrWhiteSpace(context.IssueNotes))
                                        {
                                            <MudText Typo="Typo.caption" Class="mt-2 d-block"><strong>Uwagi przy wydaniu:</strong> @context.IssueNotes</MudText>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(context.ReturnNotes))
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block"><strong>Uwagi przy zwrocie:</strong> @context.ReturnNotes</MudText>
                                        }
                                    </td>
                                </MudTr>
                            }
                        </ChildRowContent>
                    </MudTable>
                }
            </MudTabPanel>
        </MudTabs>
    </MudContainer>
}

<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />

@code {
    // ==================== BREAKPOINT ====================
    private bool _isMobile = false;
    
    private void OnBreakpointChanged(Breakpoint breakpoint)
    {
        _isMobile = breakpoint < Breakpoint.Md;
        StateHasChanged();
    }

    // ==================== DATA ====================
    private List<Rental>? _toIssueRentals;
    private List<Rental>? _toReturnRentals;
    private List<Rental>? _historyRentals;
    private HashSet<Guid> _expandedRows = new();

    private void ToggleHistoryRow(Guid id)
    {
        if (!_expandedRows.Add(id)) _expandedRows.Remove(id);
    }
    private int _toIssueCount;
    private int _toReturnCount;
    private Guid _tenantId;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        
        _tenantId = TenantProvider.GetCurrentTenantId() ?? Guid.Empty;
        if (_tenantId == Guid.Empty)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            _tenantId = user?.TenantId ?? Guid.Empty;
        }
        db.SetTenant(_tenantId);
        
        var now = DateTime.UtcNow;
        
        _toIssueRentals = await db.Rentals
            .Include(r => r.Customer)
            .Include(r => r.Items).ThenInclude(i => i.Product)
            .Where(r => r.TenantId == _tenantId)
            .Where(r => r.Status == RentalStatus.Confirmed || r.Status == RentalStatus.Pending)
            .Where(r => r.IssuedAtUtc == null)
            .OrderBy(r => r.StartDateUtc)
            .ToListAsync();
        _toIssueCount = _toIssueRentals.Count;
        
        _toReturnRentals = await db.Rentals
            .Include(r => r.Customer)
            .Include(r => r.Items).ThenInclude(i => i.Product)
            .Where(r => r.TenantId == _tenantId)
            .Where(r => r.Status == RentalStatus.Active)
            .Where(r => r.IssuedAtUtc != null)
            .Where(r => r.ReturnedAtUtc == null)
            .OrderBy(r => r.EndDateUtc)
            .ToListAsync();
        _toReturnCount = _toReturnRentals.Count;
        
        var thirtyDaysAgo = now.AddDays(-30);
        _historyRentals = await db.Rentals
            .Include(r => r.Customer)
            .Include(r => r.Items).ThenInclude(i => i.Product)  // NXRE QA #16: items dla detail view
            .Where(r => r.TenantId == _tenantId)
            .Where(r => r.ReturnedAtUtc != null || r.IssuedAtUtc != null)
            .Where(r => r.CreatedAtUtc >= thirtyDaysAgo)
            .OrderByDescending(r => r.ReturnedAtUtc ?? r.IssuedAtUtc)
            .Take(50)
            .ToListAsync();
    }

    private async Task IssueEquipment(Rental rental)
    {
        var parameters = new DialogParameters<IssueEquipmentDialog>
        {
            { x => x.Rental, rental }
        };
        
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<IssueEquipmentDialog>("Wydanie sprzętu", parameters, options);
        var result = await dialog.Result;
        
        if (result != null && !result.Canceled)
        {
            await LoadData();
            Snackbar.Add("Sprzęt został wydany", Severity.Success);
        }
    }

