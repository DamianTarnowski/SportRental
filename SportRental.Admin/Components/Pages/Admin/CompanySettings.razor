@page "/admin/company-settings"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Owner,SuperAdmin")]
@using SportRental.Shared.Legal
@using SportRental.Shared.Branding
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject SportRental.Infrastructure.Tenancy.ITenantProvider TenantProvider
@inject SportRental.Admin.Services.Cache.IAppCache AppCache
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject SportRental.Admin.Services.Storage.IFileStorage FileStorage
@inject ILogger<CompanySettings> Logger

<PageTitle>Ustawienia firmy — RentSpot</PageTitle>

@if (_isMobile)
{
    @* ==================== MOBILE UI ==================== *@
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-2 px-2">
        @* Nagłówek mobilny *@
        <MudPaper Class="rs-page-banner-sm pa-3 mb-2" Elevation="0">
            <div class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.h6" HtmlTag="h1" Style="font-weight: 700;">Ustawienia firmy</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Save" 
                               Color="Color.Inherit" 
                               OnClick="Save"
                               aria-label="Zapisz ustawienia"
                               Disabled="@isSaving" />
            </div>
        </MudPaper>
        
        @if (tenant == null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudStack Spacing="2">
                @* Informacje podstawowe *@
                <MudExpansionPanels Elevation="2">
                    <MudExpansionPanel Text="Dane firmy" IsInitiallyExpanded="true" Style="border-radius: 10px;">
                        <MudStack Spacing="2">
                            <MudTextField @bind-Value="tenant.Name" Label="Nazwa firmy" Required="true" Dense="true" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.Address" Label="Adres" Lines="2" Dense="true" Variant="Variant.Outlined" HelperText="Ulica i numer (np. Rynek Jeżycki 1)" />
                            <MudTextField @bind-Value="companyInfo.PhoneNumber" Label="Telefon" Dense="true" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.Email" Label="Email" InputType="InputType.Email" Dense="true" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.NIP" Label="NIP" MaxLength="20" Dense="true" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.REGON" Label="REGON" MaxLength="14" Dense="true" Variant="Variant.Outlined" />
                        </MudStack>
                    </MudExpansionPanel>
                    
                    <MudExpansionPanel Text="Personalizacja" Style="border-radius: 10px;">
                        <MudStack Spacing="2">
                            <MudAlert Severity="Severity.Info" Dense="true">
                                Logo i kolory są używane na wizytówce wypożyczalni w aplikacji klienta,
                                w umowach PDF i e-mailach potwierdzających rezerwację.
                                SMS pozostaje wiadomością tekstową i korzysta z osobnych szablonów.
                            </MudAlert>
                            <MudTextField @bind-Value="tenant.PrimaryColorHex" Label="Kolor główny (#RRGGBB)" HelperText="Np. #2F3C7E" Dense="true" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="tenant.SecondaryColorHex" Label="Kolor dodatkowy (#RRGGBB)" HelperText="Np. #F96167" Dense="true" Variant="Variant.Outlined" />
                            <MudText Typo="Typo.caption">Logo firmy (PNG/JPG/WebP)</MudText>
                            <InputFile OnChange="OnLogoSelected" accept="image/png,image/jpeg,image/webp" aria-label="Logo firmy" />
                            @if (!string.IsNullOrWhiteSpace(tenant.LogoUrl))
                            {
                                <img src="@tenant.LogoUrl" alt="Logo" style="max-height: 60px; max-width: 150px;" />
                            }
                        </MudStack>
                    </MudExpansionPanel>
                    
                    <MudExpansionPanel Text="Szablony Email" Style="border-radius: 10px;">
                        <MudStack Spacing="2">
                            <MudTextField @bind-Value="companyInfo.EmailThanksText" Label="Email - podziękowanie" Lines="2" Dense="true" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.EmailReminderText" Label="Email - przypomnienie" Lines="2" Dense="true" Variant="Variant.Outlined" />
                        </MudStack>
                    </MudExpansionPanel>
                    
                    <MudExpansionPanel Text="Ustawienia SMS" Style="border-radius: 10px;">
                        <MudStack Spacing="2">
                            <MudAlert Severity="Severity.Success" Dense="true">
                                SMSAPI.pl aktywne
                            </MudAlert>
                            <MudSwitch T="bool" 
                                       Value="@companyInfo.SmsConfirmationEnabled" 
                                       ValueChanged="@(v => { companyInfo.SmsConfirmationEnabled = v; StateHasChanged(); })"
                                       Color="Color.Primary"
                                       Label="Potwierdzenie umowy" />
                            <MudSwitch T="bool" 
                                       Value="@companyInfo.SmsThanksEnabled" 
                                       ValueChanged="@(v => { companyInfo.SmsThanksEnabled = v; StateHasChanged(); })"
                                       Color="Color.Primary"
                                       Label="Podziękowanie po zwrocie" />
                            <MudSwitch T="bool" 
                                       Value="@companyInfo.SmsReminderEnabled" 
                                       ValueChanged="@(v => { companyInfo.SmsReminderEnabled = v; StateHasChanged(); })"
                                       Color="Color.Primary"
                                       Label="Przypomnienie o zwrocie" />

                            <MudButton StartIcon="@Icons.Material.Filled.Save"
                                       Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       OnClick="Save"
                                       Disabled="@isSaving"
                                       Class="mt-2">
                                Zapisz ustawienia SMS
                            </MudButton>
                        </MudStack>
                    </MudExpansionPanel>
                    
                    <MudExpansionPanel Text="Lokalizacja" Style="border-radius: 10px;">
                        <MudStack Spacing="2">
                            @* NXRE QA #6: edytowalne (auto-fill z mapy + manual edit) *@
                            <MudTextField @bind-Value="companyInfo.City" Label="Miasto" Required="true" Dense="true" Variant="Variant.Outlined" HelperText="Auto-uzupełnione z mapy; możesz poprawić ręcznie." />
                            @* Feedback #9: kod pocztowy — na umowie PDF *@
                            <MudTextField @bind-Value="companyInfo.PostalCode" Label="Kod pocztowy" MaxLength="10" Dense="true" Variant="Variant.Outlined" HelperText="np. 60-001; auto-uzupełniony z mapy." />
                            <MudSelect T="string" @bind-Value="companyInfo.Voivodeship" Label="Województwo" Required="true" Dense="true" Variant="Variant.Outlined">
                                @foreach (var v in _voivodeships)
                                {
                                    <MudSelectItem Value="@v">@v</MudSelectItem>
                                }
                            </MudSelect>
                            <LeafletMap MapId="company-location-map-mobile"
                                        Height="250px"
                                        Latitude="@(companyInfo.Lat ?? 52.0)"
                                        Longitude="@(companyInfo.Lon ?? 19.0)"
                                        Zoom="@(companyInfo.Lat.HasValue ? 15 : 6)"
                                        AllowMarkerDrag="true"
                                        OnLocationChanged="OnLocationChanged"
                                        OnLocationDetailsChanged="OnLocationDetailsChanged" />
                        </MudStack>
                    </MudExpansionPanel>
                    
                    <MudExpansionPanel Text="Dodatkowe" Style="border-radius: 10px;">
                        <MudStack Spacing="2">
                            <MudTextField @bind-Value="companyInfo.LegalForm" Label="Forma prawna" Dense="true" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.OpeningHours" Label="Godziny otwarcia" Dense="true" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.Description" Label="Opis" Lines="2" Dense="true" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.ExtraInfo" Label="Dodatkowe info" Lines="2" Dense="true" Variant="Variant.Outlined" />
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
                
                @* Przyciski *@
                <MudStack Row="true" Spacing="2" Class="mud-justify-end mt-4 mb-4">
                    <MudButton Href="/admin/owner" Variant="Variant.Outlined" Size="Size.Small">Anuluj</MudButton>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@isSaving" Size="Size.Small">
                        @if (isSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" /> }
                        Zapisz
                    </MudButton>
                </MudStack>
            </MudStack>
        }
    </MudContainer>
}
else
{
    @* ==================== DESKTOP UI ==================== *@
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <MudPaper Class="rs-page-banner pa-6 mb-4" Elevation="0">
            <MudStack Row="true" Class="mud-align-center" Spacing="3">
                <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h4" HtmlTag="h1" Style="font-weight: 700;">Ustawienia firmy</MudText>
                    <MudText Typo="Typo.subtitle1" Style="opacity: 0.9;">Skonfiguruj dane i wygląd wypożyczalni</MudText>
                </div>
            </MudStack>
        </MudPaper>
        
        @if (tenant == null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="3" Style="border-radius: 16px;">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">Informacje podstawowe</MudText>
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                            <MudText Typo="Typo.body2">
                                Te dane będą automatycznie uwzględniane w umowach PDF wysyłanych do klientów!
                            </MudText>
                        </MudAlert>
                        <MudStack Spacing="3">
                            <MudTextField @bind-Value="tenant.Name" Label="Nazwa firmy" Required="true" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.Address" Label="Adres" Lines="2" Variant="Variant.Outlined" HelperText="Ulica i numer (np. Rynek Jeżycki 1)" />
                            <MudTextField @bind-Value="companyInfo.PhoneNumber" Label="Telefon" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.Email" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.NIP" Label="NIP" HelperText="10 cyfr" MaxLength="20" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.REGON" Label="REGON" HelperText="9 lub 14 cyfr" MaxLength="14" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.LegalForm" Label="Forma prawna" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.OpeningHours" Label="Godziny otwarcia" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.Description" Label="Opis" Lines="2" Variant="Variant.Outlined" />
                        </MudStack>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="3" Style="border-radius: 16px;">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">Personalizacja</MudText>
                        <MudStack Spacing="3">
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                Logo oraz kolory pojawią się na wizytówce wypożyczalni w aplikacji klienta,
                                w umowach PDF i e-mailach potwierdzających rezerwację.
                                SMS nie obsługuje grafiki ani kolorów — jego treść ustawisz w sekcji „Ustawienia SMS”.
                            </MudAlert>
                            <MudTextField @bind-Value="tenant.PrimaryColorHex" Label="Kolor główny (#RRGGBB)" HelperText="Np. #2F3C7E" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="tenant.SecondaryColorHex" Label="Kolor dodatkowy (#RRGGBB)" HelperText="Np. #F96167" Variant="Variant.Outlined" />
                            <MudText Typo="Typo.caption">Logo firmy (PNG/JPG/WebP)</MudText>
                            <InputFile OnChange="OnLogoSelected" accept="image/png,image/jpeg,image/webp" aria-label="Logo firmy" />
                            @if (!string.IsNullOrWhiteSpace(tenant.LogoUrl))
                            {
                                <div>
                                    <MudText Typo="Typo.caption">Obecne logo:</MudText>
                                    <img src="@tenant.LogoUrl" alt="Logo" style="max-height: 80px; max-width: 200px;" />
                                </div>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="3" Style="border-radius: 16px;">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">Szablony Email</MudText>
                        <MudStack Spacing="3">
                            <MudTextField @bind-Value="companyInfo.EmailThanksText" 
                                          Label="Email - podziękowanie" 
                                          Lines="3"
                                          Variant="Variant.Outlined"
                                          HelperText="Email po zakończeniu wynajmu" />
                            <MudTextField @bind-Value="companyInfo.EmailReminderText" 
                                          Label="Email - przypomnienie 1" 
                                          Lines="3"
                                          Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="companyInfo.EmailReminderText2" 
                                          Label="Email - przypomnienie 2" 
                                          Lines="3"
                                          Variant="Variant.Outlined"
                                          HelperText="Wysyłane raz, 1 dzień po terminie zwrotu; puste pole wyłącza ten etap." />
                            <MudTextField @bind-Value="companyInfo.EmailReminderText3" 
                                          Label="Email - przypomnienie 3" 
                                          Lines="3"
                                          Variant="Variant.Outlined"
                                          HelperText="Wysyłane raz, 3 dni po terminie zwrotu; puste pole wyłącza ten etap." />
                        </MudStack>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="3" Style="border-radius: 16px;">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">Ustawienia SMS</MudText>
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                            <MudText Typo="Typo.body2">
                                Integracja z SMSAPI.pl jest aktywna. SMS-y będą wysyłane do klientów.
                            </MudText>
                        </MudAlert>
                        <MudStack Spacing="3">
                            <MudSwitch T="bool" 
                                       Value="@companyInfo.SmsConfirmationEnabled" 
                                       ValueChanged="@(v => { companyInfo.SmsConfirmationEnabled = v; StateHasChanged(); })"
                                       Color="Color.Primary"
                                       Label="Wysyłaj SMS z prośbą o potwierdzenie umowy" />
                            <MudSwitch T="bool" 
                                       Value="@companyInfo.SmsThanksEnabled" 
                                       ValueChanged="@(v => { companyInfo.SmsThanksEnabled = v; StateHasChanged(); })"
                                       Color="Color.Primary"
                                       Label="Wysyłaj SMS z podziękowaniem po zwrocie" />
                            <MudSwitch T="bool" 
                                       Value="@companyInfo.SmsReminderEnabled" 
                                       ValueChanged="@(v => { companyInfo.SmsReminderEnabled = v; StateHasChanged(); })"
                                       Color="Color.Primary"
                                       Label="Wysyłaj SMS z przypomnieniem o zwrocie" />

                            <MudButton StartIcon="@Icons.Material.Filled.Save"
                                       Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       OnClick="Save"
                                       Disabled="@isSaving">
                                Zapisz ustawienia SMS
                            </MudButton>
                            
                            @if (companyInfo.SmsThanksEnabled)
                            {
                                <MudTextField @bind-Value="companyInfo.SmsThanksText" 
                                              Label="Treść SMS - podziękowanie" 
                                              Lines="2"
                                              Variant="Variant.Outlined"
                                              HelperText="Zostaw puste dla domyślnej wiadomości" />
                            }
                            @if (companyInfo.SmsReminderEnabled)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                                    <MudText Typo="Typo.caption">
                                        Dostępne zmienne: <b>{imie}</b> - imię klienta, <b>{data_konca}</b> - data końca wynajmu, 
                                        <b>{sprzet}</b> - lista sprzętu, <b>{firma}</b> - nazwa firmy, <b>{telefon}</b> - tel. firmy
                                    </MudText>
                                </MudAlert>
                                <MudTextField @bind-Value="companyInfo.SmsReminderText" 
                                              Label="Treść SMS - przypomnienie o zwrocie" 
                                              Lines="3"
                                              Variant="Variant.Outlined"
                                              Placeholder="Witaj {imie}! Wynajem sprzetu ({sprzet}) konczy sie {data_konca}. Prosimy o zwrot lub kontakt. {firma}"
                                              HelperText="Zostaw puste dla domyślnej wiadomości" />
                                <MudTextField @bind-Value="companyInfo.SmsReminderText2" 
                                              Label="Treść SMS - przypomnienie 2 (opcjonalne)" 
                                              Lines="2"
                                              Variant="Variant.Outlined"
                                              HelperText="Wysyłane raz, 1 dzień po terminie zwrotu" />
                                <MudTextField @bind-Value="companyInfo.SmsReminderText3" 
                                              Label="Treść SMS - przypomnienie 3 (opcjonalne)" 
                                              Lines="2"
                                              Variant="Variant.Outlined"
                                              HelperText="Wysyłane raz, 3 dni po terminie zwrotu" />
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Elevation="3" Style="border-radius: 16px;">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">Regulamin wypożyczalni</MudText>
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            <MudText Typo="Typo.caption">
                                Regulamin jest pokazywany w checkout i zapisywany razem z rezerwacją jako dowód zaakceptowanej wersji.
                                Gdy pole pozostanie puste, klient zobaczy standardowy regulamin RentSpot — rezerwacja nigdy nie będzie bez warunków.
                            </MudText>
                        </MudAlert>
                        <MudTextField @bind-Value="companyInfo.RegulationsText" 
                                      Label="Treść regulaminu" 
                                      Lines="10"
                                      Variant="Variant.Outlined"
                                      Placeholder="Wpisz treść regulaminu wypożyczalni..."
                                      HelperText="Zostaw puste, aby użyć wersjonowanego regulaminu standardowego RentSpot" />
                        <details class="mt-3" style="border:1px solid var(--mud-palette-lines-default);border-radius:8px;padding:12px;">
                            <summary style="cursor:pointer;font-weight:600;">Podejrzyj regulamin standardowy (@DefaultRentalRegulations.Version)</summary>
                            <div style="white-space:pre-wrap;max-height:320px;overflow:auto;margin-top:12px;font-size:.82rem;line-height:1.55;">@DefaultRentalRegulations.Content</div>
                        </details>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Elevation="3" Style="border-radius: 16px;">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">Dodatkowe informacje</MudText>
                        <MudTextField @bind-Value="companyInfo.ExtraInfo" 
                                      Label="Dodatkowe informacje" 
                                      Lines="3"
                                      Variant="Variant.Outlined"
                                      HelperText="Informacje dodatkowe o firmie" />
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Elevation="3" Style="border-radius: 16px;">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">Lokalizacja wypożyczalni</MudText>
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                            <MudText Typo="Typo.body2">
                                Kliknij na mapie lub wyszukaj adres, aby ustawić lokalizację wypożyczalni. 
                                Ta lokalizacja będzie widoczna dla klientów w aplikacji.
                            </MudText>
                        </MudAlert>
                        <MudStack Spacing="3">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="4">
                                    @* NXRE QA #6: edytowalne (auto-fill z mapy + manual edit) *@
                                    <MudTextField @bind-Value="companyInfo.City"
                                                  Label="Miasto"
                                                  Required="true"
                                                  Variant="Variant.Outlined"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.LocationCity"
                                                  HelperText="Auto-uzupełnione z mapy; możesz poprawić ręcznie." />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    @* Feedback #9: kod pocztowy — na umowie PDF, auto-fill z mapy *@
                                    <MudTextField @bind-Value="companyInfo.PostalCode"
                                                  Label="Kod pocztowy"
                                                  MaxLength="10"
                                                  Variant="Variant.Outlined"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Markunread"
                                                  HelperText="np. 60-001; auto-uzupełniony z mapy." />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    @* NXRE QA #6: dropdown z gotowymi województwami *@
                                    <MudSelect T="string" @bind-Value="companyInfo.Voivodeship"
                                               Label="Województwo"
                                               Required="true"
                                               Variant="Variant.Outlined"
                                               Adornment="Adornment.Start"
                                               AdornmentIcon="@Icons.Material.Filled.Map">
                                        @foreach (var v in _voivodeships)
                                        {
                                            <MudSelectItem Value="@v">@v</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                            <MudStack Row="true" Spacing="2" Class="mb-2">
                                <MudNumericField T="double?" @bind-Value="companyInfo.Lat" 
                                                 Label="Szerokość geograficzna" 
                                                 Format="F6"
                                                 ReadOnly="true"
                                                 Variant="Variant.Outlined" />
                                <MudNumericField T="double?" @bind-Value="companyInfo.Lon" 
                                                 Label="Długość geograficzna" 
                                                 Format="F6"
                                                 ReadOnly="true"
                                                 Variant="Variant.Outlined" />
                                @if (companyInfo.Lat.HasValue && companyInfo.Lon.HasValue)
                                {
                                    <MudButton Variant="Variant.Outlined" 
                                               Color="Color.Secondary" 
                                               OnClick="ClearLocation"
                                               StartIcon="@Icons.Material.Filled.Clear">
                                        Wyczyść
                                    </MudButton>
                                }
                            </MudStack>
                            <LeafletMap MapId="company-location-map"
                                        Height="400px"
                                        Latitude="@(companyInfo.Lat ?? 52.0)"
                                        Longitude="@(companyInfo.Lon ?? 19.0)"
                                        Zoom="@(companyInfo.Lat.HasValue ? 15 : 6)"
                                        AllowMarkerDrag="true"
                                        OnLocationChanged="OnLocationChanged"
                                        OnLocationDetailsChanged="OnLocationDetailsChanged" />
                        </MudStack>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12">
                    <MudStack Row="true" Spacing="2" Class="mud-justify-end mt-6 mb-6">
                        <MudButton Href="/admin/owner" Variant="Variant.Outlined">Anuluj</MudButton>
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@isSaving">
                            @if (isSaving)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ml-2">Zapisywanie...</MudText>
                            }
                            else
                            {
                                <MudText>Zapisz ustawienia</MudText>
                            }
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        }
    </MudContainer>
}

<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />

@code {
    // ==================== BREAKPOINT ====================
    private bool _isMobile = false;
    
    private void OnBreakpointChanged(Breakpoint breakpoint)
    {
        _isMobile = breakpoint < Breakpoint.Md;
        StateHasChanged();
    }

    // ==================== DATA ====================
    private Tenant? tenant;
    private CompanyInfoDto companyInfo = new();
    private IBrowserFile? selectedLogoFile;
    private bool isSaving = false;

    // NXRE QA #6: lista 16 województw (dropdown zamiast ręcznego wpisywania)
    private static readonly string[] _voivodeships = new[]
    {
        "dolnośląskie", "kujawsko-pomorskie", "lubelskie", "lubuskie",
        "łódzkie", "małopolskie", "mazowieckie", "opolskie",
        "podkarpackie", "podlaskie", "pomorskie", "śląskie",
        "świętokrzyskie", "warmińsko-mazurskie", "wielkopolskie", "zachodniopomorskie"
    };
    
    private Guid _tenantId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tenantId = TenantProvider.GetCurrentTenantId() ?? Guid.Empty;
            
            if (_tenantId == Guid.Empty)
            {
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var userPrincipal = authState.User;
                if (userPrincipal?.Identity?.IsAuthenticated == true)
                {
                    var user = await UserManager.GetUserAsync(userPrincipal);
                    if (user?.TenantId.HasValue == true && user.TenantId.Value != Guid.Empty)
                    {
                        _tenantId = user.TenantId.Value;
                    }
                }
            }
            
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd ładowania ustawień: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadData()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        Db.SetTenant(_tenantId);
        
        tenant = await Db.Tenants.FirstOrDefaultAsync(t => t.Id == _tenantId);
        if (tenant == null)
        {
            if (_tenantId != Guid.Empty)
            {
                tenant = new Tenant { Id = _tenantId, Name = "Nowa wypożyczalnia" };
                Db.Tenants.Add(tenant);
                await Db.SaveChangesAsync();
                Snackbar.Add("Utworzono nową firmę - uzupełnij dane", Severity.Info);
            }
            else
            {
                Snackbar.Add("Nie znaleziono danych firmy - zaloguj się ponownie", Severity.Error);
                return;
            }
        }

        var existingCompanyInfo = await Db.CompanyInfos.FirstOrDefaultAsync(ci => ci.TenantId == _tenantId);
        if (existingCompanyInfo != null)
        {
            companyInfo = new CompanyInfoDto
            {
                Address = existingCompanyInfo.Address,
                PhoneNumber = existingCompanyInfo.PhoneNumber,
                Email = existingCompanyInfo.Email,
                NIP = existingCompanyInfo.NIP,
                REGON = existingCompanyInfo.REGON,
                LegalForm = existingCompanyInfo.LegalForm,
                OpeningHours = existingCompanyInfo.OpeningHours,
                Description = existingCompanyInfo.Description,
                ExtraInfo = existingCompanyInfo.ExtraInfo,
                Lat = existingCompanyInfo.Lat,
                Lon = existingCompanyInfo.Lon,
                City = existingCompanyInfo.City,
                PostalCode = existingCompanyInfo.PostalCode,
                Voivodeship = existingCompanyInfo.Voivodeship,
                SmsConfirmationEnabled = existingCompanyInfo.SmsConfirmationEnabled,
                SmsThanksEnabled = existingCompanyInfo.SmsThanksEnabled,
                SmsReminderEnabled = existingCompanyInfo.SmsReminderEnabled,
                SmsThanksText = existingCompanyInfo.SmsThanksText,
                SmsReminderText = existingCompanyInfo.SmsReminderText,
                SmsReminderText2 = existingCompanyInfo.SmsReminderText2,
                SmsReminderText3 = existingCompanyInfo.SmsReminderText3,
                EmailThanksText = existingCompanyInfo.EmailThanksText,
                EmailReminderText = existingCompanyInfo.EmailReminderText,
                EmailReminderText2 = existingCompanyInfo.EmailReminderText2,
                EmailReminderText3 = existingCompanyInfo.EmailReminderText3,
                RegulationsText = existingCompanyInfo.RegulationsText
            };
        }
    }

    private void OnLogoSelected(InputFileChangeEventArgs e)
    {
        selectedLogoFile = e.File;
    }

    private void OnLocationChanged((double Lat, double Lon) location)
    {
        companyInfo.Lat = Math.Round(location.Lat, 6);
        companyInfo.Lon = Math.Round(location.Lon, 6);
        StateHasChanged();
    }

    private void OnLocationDetailsChanged(LeafletMap.LocationDetails details)
    {
        companyInfo.Lat = Math.Round(details.Lat, 6);
        companyInfo.Lon = Math.Round(details.Lon, 6);
        companyInfo.City = details.City;
        companyInfo.Voivodeship = details.Voivodeship;
        if (!string.IsNullOrWhiteSpace(details.PostalCode))
        {
            companyInfo.PostalCode = details.PostalCode;
        }
        if (!string.IsNullOrWhiteSpace(details.Address))
        {
            companyInfo.Address = details.Address;
        }
        StateHasChanged();
    }

    private void ClearLocation()
    {
        companyInfo.Lat = null;
        companyInfo.Lon = null;
        companyInfo.City = null;
        companyInfo.PostalCode = null;
        companyInfo.Voivodeship = null;
        StateHasChanged();
    }

    private async Task Save()
    {
        if (tenant == null) return;

        var normalizedPrimary = BrandColor.NormalizeHex(tenant.PrimaryColorHex);
        if (!string.IsNullOrWhiteSpace(tenant.PrimaryColorHex) && normalizedPrimary is null)
        {
            Snackbar.Add("Kolor główny musi mieć format #RRGGBB, np. #2F3C7E.", Severity.Warning);
            return;
        }

        var normalizedSecondary = BrandColor.NormalizeHex(tenant.SecondaryColorHex);
        if (!string.IsNullOrWhiteSpace(tenant.SecondaryColorHex) && normalizedSecondary is null)
        {
            Snackbar.Add("Kolor dodatkowy musi mieć format #RRGGBB, np. #F96167.", Severity.Warning);
            return;
        }

        tenant.PrimaryColorHex = normalizedPrimary;
        tenant.SecondaryColorHex = normalizedSecondary;

        if (selectedLogoFile is not null && GetLogoValidationError(selectedLogoFile) is { } logoError)
        {
            Snackbar.Add(logoError, Severity.Error);
            return;
        }

        // NXRE QA #7: blokada zapisu bez Miasto/Województwo
        if (companyInfo != null)
        {
            if (string.IsNullOrWhiteSpace(companyInfo.City))
            {
                Snackbar.Add("Uzupełnij pole Miasto — wybierz lokalizację na mapie lub wpisz ręcznie.", Severity.Warning);
                return;
            }
            if (string.IsNullOrWhiteSpace(companyInfo.Voivodeship))
            {
                Snackbar.Add("Wybierz województwo z listy.", Severity.Warning);
                return;
            }
        }

        isSaving = true;
        try
        {
            await using var Db = await DbFactory.CreateDbContextAsync();
            Db.SetTenant(_tenantId);
            
            Db.Tenants.Update(tenant);
            
            if (selectedLogoFile != null)
            {
                try
                {
                    var ext = Path.GetExtension(selectedLogoFile.Name).ToLowerInvariant();
                    var rel = $"images/tenants/{_tenantId}/{_tenantId}{ext}";
                    await using var stream = selectedLogoFile.OpenReadStream(MaxLogoBytes);
                    var url = await FileStorage.SaveAsync(rel, stream);
                    tenant.LogoUrl = url;
                    Snackbar.Add("Logo zapisane!", Severity.Success);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Nie udało się zapisać logo tenanta {TenantId}", _tenantId);
                    Snackbar.Add("Nie udało się zapisać logo. Sprawdź plik i spróbuj ponownie.", Severity.Error);
                    return;
                }
            }
            
            var existingCompanyInfo = await Db.CompanyInfos.FirstOrDefaultAsync(ci => ci.TenantId == _tenantId);
            if (existingCompanyInfo != null)
            {
                // Feedback #8: nazwa na umowie PDF czyta CompanyInfo.Name — synchronizujemy z polem
                // "Nazwa firmy" (Tenant.Name), inaczej PDF pokazuje stary placeholder z rejestracji.
                existingCompanyInfo.Name = tenant.Name;
                existingCompanyInfo.Address = companyInfo.Address;
                existingCompanyInfo.PhoneNumber = companyInfo.PhoneNumber;
                existingCompanyInfo.Email = companyInfo.Email;
                existingCompanyInfo.NIP = companyInfo.NIP;
                existingCompanyInfo.REGON = companyInfo.REGON;
                existingCompanyInfo.LegalForm = companyInfo.LegalForm;
                existingCompanyInfo.OpeningHours = companyInfo.OpeningHours;
                existingCompanyInfo.Description = companyInfo.Description;
                existingCompanyInfo.ExtraInfo = companyInfo.ExtraInfo;
                existingCompanyInfo.Lat = companyInfo.Lat;
                existingCompanyInfo.Lon = companyInfo.Lon;
                existingCompanyInfo.City = companyInfo.City;
                existingCompanyInfo.PostalCode = companyInfo.PostalCode;
                existingCompanyInfo.Voivodeship = companyInfo.Voivodeship;
                existingCompanyInfo.SmsConfirmationEnabled = companyInfo.SmsConfirmationEnabled;
                existingCompanyInfo.SmsThanksEnabled = companyInfo.SmsThanksEnabled;
                existingCompanyInfo.SmsReminderEnabled = companyInfo.SmsReminderEnabled;
                existingCompanyInfo.SmsThanksText = companyInfo.SmsThanksText;
                existingCompanyInfo.SmsReminderText = companyInfo.SmsReminderText;
                existingCompanyInfo.SmsReminderText2 = companyInfo.SmsReminderText2;
                existingCompanyInfo.SmsReminderText3 = companyInfo.SmsReminderText3;
                existingCompanyInfo.EmailThanksText = companyInfo.EmailThanksText;
                existingCompanyInfo.EmailReminderText = companyInfo.EmailReminderText;
                existingCompanyInfo.EmailReminderText2 = companyInfo.EmailReminderText2;
                existingCompanyInfo.EmailReminderText3 = companyInfo.EmailReminderText3;
                existingCompanyInfo.RegulationsText = companyInfo.RegulationsText;
                existingCompanyInfo.UpdatedAtUtc = DateTime.UtcNow;
                
                Db.CompanyInfos.Update(existingCompanyInfo);
            }
            else
            {
                var newCompanyInfo = new CompanyInfo
                {
                    Id = Guid.NewGuid(),
                    TenantId = _tenantId,
                    Name = tenant.Name,   // Feedback #8: nazwa na umowie PDF z pola "Nazwa firmy"
                    Address = companyInfo.Address,
                    PhoneNumber = companyInfo.PhoneNumber,
                    Email = companyInfo.Email,
                    NIP = companyInfo.NIP,
                    REGON = companyInfo.REGON,
                    LegalForm = companyInfo.LegalForm,
                    OpeningHours = companyInfo.OpeningHours,
                    Description = companyInfo.Description,
                    ExtraInfo = companyInfo.ExtraInfo,
                    Lat = companyInfo.Lat,
                    Lon = companyInfo.Lon,
                    City = companyInfo.City,
                    PostalCode = companyInfo.PostalCode,
                    Voivodeship = companyInfo.Voivodeship,
                    SmsConfirmationEnabled = companyInfo.SmsConfirmationEnabled,
                    SmsThanksEnabled = companyInfo.SmsThanksEnabled,
                    SmsReminderEnabled = companyInfo.SmsReminderEnabled,
                    SmsThanksText = companyInfo.SmsThanksText,
                    SmsReminderText = companyInfo.SmsReminderText,
                    SmsReminderText2 = companyInfo.SmsReminderText2,
                    SmsReminderText3 = companyInfo.SmsReminderText3,
                    EmailThanksText = companyInfo.EmailThanksText,
                    EmailReminderText = companyInfo.EmailReminderText,
                    EmailReminderText2 = companyInfo.EmailReminderText2,
                    EmailReminderText3 = companyInfo.EmailReminderText3,
                    RegulationsText = companyInfo.RegulationsText,
                    CreatedAtUtc = DateTime.UtcNow,
                    UpdatedAtUtc = DateTime.UtcNow
                };
                
                await Db.CompanyInfos.AddAsync(newCompanyInfo);
            }
            
            await Db.SaveChangesAsync();

            // Cache invalidation — tenant.Name + CompanyInfo mogły się zmienić, kolejne strony muszą odświeżyć.
            AppCache.InvalidateTenant(_tenantId);
            selectedLogoFile = null;

            Snackbar.Add("Ustawienia zostały zapisane", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd podczas zapisywania: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private const long MaxLogoBytes = 5 * 1024 * 1024;

    private static string? GetLogoValidationError(IBrowserFile file)
    {
        if (file.Size <= 0)
            return "Wybrany plik logo jest pusty.";

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (extension is not (".jpg" or ".jpeg" or ".png" or ".webp"))
            return "Logo musi być plikiem PNG, JPG lub WebP.";

        if (file.Size > MaxLogoBytes)
            return "Logo jest za duże. Maksymalny rozmiar to 5 MB.";

        return null;
    }

