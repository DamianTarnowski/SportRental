    private async Task OnQrScanned(string qrCode)
    {
        if (!_continuousScan)
            _showScanner = false;
        
        var (type, id, skuOrCode) = SportRental.Admin.Services.QrCode.SimpleQrCodeGenerator.ParseQrCodeData(qrCode);
        
        Product? product = null;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.SetTenant(CurrentTenantId());
        
        if (id.HasValue)
        {
            product = await db.Products.FirstOrDefaultAsync(p => p.Id == id.Value);
        }
        else if (type == "Barcode" && !string.IsNullOrEmpty(skuOrCode))
        {
            // Barcode — search by SKU
            product = await db.Products.FirstOrDefaultAsync(p => p.Sku == skuOrCode);
            
            // Try short ID format (SR + first 8 chars of GUID)
            if (product == null && skuOrCode.StartsWith("SR", StringComparison.OrdinalIgnoreCase) && skuOrCode.Length == 10)
            {
                var shortId = skuOrCode[2..].ToLower();
                product = await db.Products.FirstOrDefaultAsync(p => p.Id.ToString().Replace("-", "").StartsWith(shortId));
            }
        }
        
        if (product != null)
        {
            var existingItem = editItems.FirstOrDefault(i => i.ProductId == product.Id);
            if (existingItem != null)
            {
                existingItem.Quantity++;
            }
            else
            {
                var days = Math.Max(1, (int)Math.Ceiling(((endDate ?? DateTime.Today.AddDays(1)) - (startDate ?? DateTime.Today)).TotalDays));
                editItems.Add(new RentalItem
                {
                    Id = Guid.NewGuid(),
                    ProductId = product.Id,
                    Quantity = 1,
                    PricePerDay = product.DailyPrice,
                    Subtotal = product.DailyPrice * days
                });
            }
            Recalculate();
            Snackbar.Add($"Dodano: {product.Name}", Severity.Success);
        }
        else
        {
            Snackbar.Add($"Nie znaleziono produktu: {qrCode}", Severity.Warning);
        }
        
        StateHasChanged();
    }

    private void RemoveItem(RentalItem item)
    {
        editItems.Remove(item);
        Recalculate();
    }

    private void Recalculate()
    {
        var start = startDate ?? DateTime.Today;
        var end = endDate ?? DateTime.Today.AddDays(1);
        var days = Math.Max(1, (int)Math.Ceiling((end - start).TotalDays));
        var hours = editModel.HoursRented ?? 1;
        
        foreach (var item in editItems)
        {
            var product = products.FirstOrDefault(p => p.Id == item.ProductId);
            
            if (editModel.RentalType == RentalType.Hourly && product?.HourlyPrice.HasValue == true)
            {
                item.PricePerHour ??= product.HourlyPrice;
                if (item.PricePerDay == 0) item.PricePerDay = product.DailyPrice;
                item.Subtotal = (item.PricePerHour ?? product.HourlyPrice.Value) * item.Quantity * hours;
            }
            else
            {
                if (item.PricePerDay == 0) item.PricePerDay = product?.DailyPrice ?? 0;
                item.PricePerHour ??= product?.HourlyPrice;
                item.Subtotal = item.PricePerDay * item.Quantity * days;
            }
        }
    }

    private int GetAvail(Guid productId)
    {
        var baseQty = products.FirstOrDefault(p => p.Id == productId)?.AvailableQuantity ?? 0;
        var alreadyReserved = reservedByProduct.GetValueOrDefault(productId);
        var inCart = editItems.Where(i => i.ProductId == productId).Sum(i => i.Quantity);
        return Math.Max(0, baseQty - alreadyReserved - inCart);
    }

