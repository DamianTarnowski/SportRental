    private async Task OpenEditCustomerFromRental()
    {
        var existing = customers.FirstOrDefault(c => c.Id == editModel.CustomerId);
        if (existing == null) return;

        var clone = new Customer
        {
            Id = existing.Id,
            TenantId = existing.TenantId,
            FullName = existing.FullName,
            Email = existing.Email,
            PhoneNumber = existing.PhoneNumber,
            DocumentNumber = existing.DocumentNumber,
            Address = existing.Address,
            Notes = existing.Notes,
            CreatedAtUtc = existing.CreatedAtUtc
        };
        var parameters = new DialogParameters
        {
            ["Customer"] = clone,
            ["IsNew"] = false
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false
        };
        var dialog = await DialogService.ShowAsync<CustomerEditDialog>("Edytuj klienta", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is Customer updated)
        {
            await SaveCustomerFromRentalAsync(updated, isNew: false);
        }
    }

    private async Task SaveCustomerFromRentalAsync(Customer model, bool isNew)
    {
        model.FullName = model.FullName?.Trim() ?? string.Empty;
        model.Email = model.Email?.Trim();
        model.PhoneNumber = NormalizePhone(model.PhoneNumber);
        model.Address = model.Address?.Trim();
        model.DocumentNumber = model.DocumentNumber?.Trim();
        model.Notes = model.Notes?.Trim();

        try
        {
            await using var Db = await DbFactory.CreateDbContextAsync();
            Db.SetTenant(CurrentTenantId());

            if (isNew)
            {
                model.Id = Guid.NewGuid();
                model.CreatedAtUtc = DateTime.UtcNow;
                model.TenantId = CurrentTenantId();
                await Db.Customers.AddAsync(model);
                Snackbar.Add($"Klient {model.FullName} dodany", MudBlazor.Severity.Success);
            }
            else
            {
                var tracked = await Db.Customers.FindAsync(model.Id);
                if (tracked == null)
                {
                    Snackbar.Add("Nie znaleziono klienta", MudBlazor.Severity.Warning);
                    return;
                }
                tracked.FullName = model.FullName;
                tracked.Email = model.Email;
                tracked.PhoneNumber = model.PhoneNumber;
                tracked.DocumentNumber = model.DocumentNumber;
                tracked.Address = model.Address;
                tracked.Notes = model.Notes;
                Snackbar.Add($"Klient {model.FullName} zaktualizowany", MudBlazor.Severity.Success);
            }
            await Db.SaveChangesAsync();

            customers = await Db.Customers.AsNoTracking().OrderBy(c => c.FullName).ToListAsync();
            customersDict = customers.ToDictionary(c => c.Id);
            editModel.CustomerId = model.Id;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving customer from rental dialog");
            Snackbar.Add($"Błąd zapisu klienta: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private static string? NormalizePhone(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return null;
        phone = phone.Trim().Replace(" ", "");
        if (phone.Length == 9 && !phone.StartsWith("+")) phone = "+48" + phone;
        return phone;
    }

    private async Task SendCustomSms()
    {
        if (customSmsRental == null || string.IsNullOrWhiteSpace(customSmsMessage))
            return;
            
        var customer = customersDict.GetValueOrDefault(customSmsRental.CustomerId);
        if (customer == null || string.IsNullOrWhiteSpace(customer.PhoneNumber))
        {
            Snackbar.Add("Klient nie ma numeru telefonu", MudBlazor.Severity.Warning);
            return;
        }
        
        sendingCustomSms = true;
        StateHasChanged();
        
        try
        {
            await SmsSender.SendAsync(customer.PhoneNumber, customSmsMessage);
            Snackbar.Add($"📱 SMS wysłany do {customer.PhoneNumber}", MudBlazor.Severity.Success);
            CloseCustomSmsDialog();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to send custom SMS to {Phone}", customer.PhoneNumber);
            Snackbar.Add($"Błąd wysyłania SMS: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            sendingCustomSms = false;
            StateHasChanged();
        }
    }

    private async Task IssueInvoice(Rental rental)
    {
        try
        {
            // Idempotent: jeśli faktura już istnieje, otwiera istniejącą zamiast tworzyć duplikat
            await using var db = await DbFactory.CreateDbContextAsync();
            var existing = await db.Invoices.FirstOrDefaultAsync(i => i.RentalId == rental.Id);

            SportRental.Infrastructure.Domain.Invoice invoice;
            if (existing != null)
            {
                invoice = existing;
                Snackbar.Add($"Faktura {invoice.Number} już istnieje — otwieram PDF.", MudBlazor.Severity.Info);
            }
            else
            {
                invoice = await InvoiceService.CreateForRentalAsync(rental.Id);
                Snackbar.Add($"Wystawiono fakturę {invoice.Number} ({invoice.GrossAmount:N2} zł brutto).", MudBlazor.Severity.Success);
            }

            // Otwórz PDF w nowej karcie (endpoint /api/invoices/{id}/pdf wymaga auth — cookie sesji Blazor)
            await JS.InvokeVoidAsync("open", $"/api/invoices/{invoice.Id}/pdf", "_blank");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to issue invoice for rental {RentalId}", rental.Id);
            Snackbar.Add($"Błąd wystawiania faktury: {ex.Message}", MudBlazor.Severity.Error);
        }
    }
