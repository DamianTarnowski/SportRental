    private async Task SendReminderSms(Rental rental)
    {
        try
        {
            var customer = customersDict.GetValueOrDefault(rental.CustomerId);
            if (customer == null || string.IsNullOrWhiteSpace(customer.PhoneNumber))
            {
                Snackbar.Add("Klient nie ma numeru telefonu", MudBlazor.Severity.Warning);
                return;
            }

            await using var Db = await DbFactory.CreateDbContextAsync();
            Db.SetTenant(CurrentTenantId());

            var companyInfo = await Db.CompanyInfos.AsNoTracking()
                .FirstOrDefaultAsync(ci => ci.TenantId == CurrentTenantId());

            var productIds = rental.Items?.Select(i => i.ProductId).Distinct().ToList() ?? new();
            var productNames = await Db.Products.AsNoTracking()
                .Where(p => productIds.Contains(p.Id))
                .ToDictionaryAsync(p => p.Id, p => p.Name);

            var message = SportRental.Admin.Services.Email.RentalReminderService
                .BuildReminderSmsText(rental, companyInfo ?? new CompanyInfo(), productNames);

            await SmsSender.SendReminderAsync(customer.PhoneNumber, customer.FullName, message);

            var tracked = await Db.Rentals.FindAsync(rental.Id);
            if (tracked != null)
            {
                tracked.IsReminderSmsSent = true;
                tracked.ReminderSmsSentAtUtc = DateTime.UtcNow;
                await Db.SaveChangesAsync();
            }

            rental.IsReminderSmsSent = true;
            rental.ReminderSmsSentAtUtc = DateTime.UtcNow;

            Snackbar.Add("Przypomnienie SMS wysłane!", MudBlazor.Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd wysyłania przypomnienia SMS");
            Snackbar.Add($"Błąd: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task ConfirmRentalByAdmin(Rental rental)
    {
        try
        {
            var result = await RentalConfirmationService.ConfirmByAdminAsync(rental.Id, "admin");
            if (result.Success)
            {
                rental.IsSmsConfirmed = true;
                if (rental.Status == RentalStatus.Pending)
                    rental.Status = RentalStatus.Confirmed;
                Snackbar.Add($"✅ {result.Message}", MudBlazor.Severity.Success);
                StateHasChanged();
            }
            else
            {
                Snackbar.Add($"⚠️ {result.Message}", MudBlazor.Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd ręcznego potwierdzenia wynajmu {RentalId}", rental.Id);
            Snackbar.Add($"Błąd: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task Delete(Rental rental)
    {
        try
        {
            await using var Db = await DbFactory.CreateDbContextAsync();
            Db.SetTenant(CurrentTenantId());
            
            var items = await Db.RentalItems.Where(i => i.RentalId == rental.Id).ToListAsync();
            Db.RentalItems.RemoveRange(items);
            
            var tracked = await Db.Rentals.FindAsync(rental.Id);
            if (tracked == null)
            {
                Snackbar.Add("Wynajem nie istnieje lub został już usunięty", MudBlazor.Severity.Warning);
                return;
            }
            Db.Rentals.Remove(tracked);
            await Db.SaveChangesAsync();
            
            Snackbar.Add($"Wynajem został usunięty", MudBlazor.Severity.Success);
            
            rentals.RemoveAll(r => r.Id == rental.Id);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd podczas usuwania wynajmu: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private void ExtendRental(Rental rental)
    {
        Edit(rental);

        // BUG sprzed 2026-04-25: brałem DateTime.Now (local) i zapisywał z Kind=Utc bez
        // konwersji — efekt: rental kończył się 2h za późno (Polska UTC+2 latem), a
        // RentalReminderService wysyłał SMS "kończy się o {godzina}" 2h za wcześnie niż
        // klient się spodziewał. Maciej zgłosił "Mamy 11:47 a przychodzi SMS że kończy się 10:00".
        var newEndDate = DateTime.Now.AddDays(7);
        endDate = newEndDate;
        editModel.EndDateUtc = DateTime.SpecifyKind(newEndDate, DateTimeKind.Local).ToUniversalTime();

        Snackbar.Add("Zmień datę zakończenia aby przedłużyć wynajem", MudBlazor.Severity.Warning);
    }
    
