@page "/"
@rendermode InteractiveServer

<PageTitle>RentSpot — panel partnera</PageTitle>

<div class="admin-home">
    <AuthorizeView>
        <Authorized>
            @* DS v2: flat navy-inverse hero, bez gradientu, bez emoji *@
            <MudPaper Elevation="0" Class="rs-hero pa-6 mb-5">
                <MudText Typo="Typo.h4" Class="rs-hero-title">Witaj, @context.User.Identity?.Name</MudText>
                <MudText Typo="Typo.body1" Class="rs-hero-subtitle">Panel partnera wypożyczalni sprzętu sportowego</MudText>
            </MudPaper>

            <MudText Typo="Typo.subtitle1" Class="mb-3 d-flex align-center" Style="font-weight: 600;">
                <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Primary" Class="mr-2" />
                Szybkie akcje
            </MudText>
            <MudGrid Spacing="3" Class="mb-6">
                <MudItem xs="12" sm="6" md="3">
                    <a href="/dashboard" class="rs-quick-action">
                        <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="rs-quick-action-icon" />
                        <h3>Dashboard</h3>
                        <p>Przegląd statystyk</p>
                    </a>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <a href="/admin/rentals" class="rs-quick-action">
                        <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Class="rs-quick-action-icon" />
                        <h3>Nowy wynajem</h3>
                        <p>Utwórz rezerwację</p>
                    </a>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <a href="/admin/products" class="rs-quick-action">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="rs-quick-action-icon" />
                        <h3>Produkty</h3>
                        <p>Zarządzaj sprzętem</p>
                    </a>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <a href="/admin/customers" class="rs-quick-action">
                        <MudIcon Icon="@Icons.Material.Filled.Groups" Class="rs-quick-action-icon" />
                        <h3>Klienci</h3>
                        <p>Baza klientów</p>
                    </a>
                </MudItem>
            </MudGrid>

            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudCard Outlined="true" Elevation="0" Class="rs-info-card">
                        <MudCardContent>
                            <div class="d-flex align-center gap-3 mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Primary" Size="Size.Large" />
                                <div>
                                    <MudText Typo="Typo.h6">Funkcje panelu</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Dostępne narzędzia</MudText>
                                </div>
                            </div>
                            <MudList T="string" Dense="true">
                                <MudListItem Icon="@Icons.Material.Filled.Inventory" Text="Zarządzanie produktami i stanami magazynowymi" />
                                <MudListItem Icon="@Icons.Material.Filled.People" Text="Baza klientów i historia wypożyczeń" />
                                <MudListItem Icon="@Icons.Material.Filled.CalendarMonth" Text="Kalendarz rezerwacji" />
                                <MudListItem Icon="@Icons.Material.Filled.Description" Text="Automatyczne generowanie umów PDF" />
                                <MudListItem Icon="@Icons.Material.Filled.Analytics" Text="Raporty i statystyki" />
                            </MudList>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCard Outlined="true" Elevation="0" Class="rs-info-card">
                        <MudCardContent>
                            <div class="d-flex align-center gap-3 mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Color="Color.Tertiary" Size="Size.Large" />
                                <div>
                                    <MudText Typo="Typo.h6">Wskazówki</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Porady dla admina</MudText>
                                </div>
                            </div>
                            <MudList T="string" Dense="true">
                                <MudListItem Icon="@Icons.Material.Filled.TipsAndUpdates" Text="Regularnie aktualizuj stany magazynowe" />
                                <MudListItem Icon="@Icons.Material.Filled.TipsAndUpdates" Text="Sprawdzaj kalendarz na początku dnia" />
                                <MudListItem Icon="@Icons.Material.Filled.TipsAndUpdates" Text="Wysyłaj przypomnienia o zwrotach" />
                                <MudListItem Icon="@Icons.Material.Filled.TipsAndUpdates" Text="Monitoruj raporty sprzedaży" />
                                <MudListItem Icon="@Icons.Material.Filled.TipsAndUpdates" Text="Dostosuj szablon umowy do potrzeb" />
                            </MudList>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </Authorized>
        <NotAuthorized>
            @* DS v2: flat navy-inverse hero, bez gradient, bez emoji, jeden CTA *@
            <div class="rs-welcome">
                <div class="rs-welcome-content">
                    <div class="rs-welcome-logo">
                        <svg viewBox="0 0 100 100" width="72" height="72" aria-hidden="true">
                            <circle cx="50" cy="50" r="48" fill="#F96167" />
                            <text x="50" y="72" font-family="Outfit, Inter, system-ui, sans-serif" font-size="64" font-weight="900" text-anchor="middle" fill="#FFFFFF">R</text>
                        </svg>
                    </div>
                    <h1 class="rs-welcome-title">RentSpot<span class="rs-welcome-dot">.</span></h1>
                    <p class="rs-welcome-subtitle">Panel partnera — wypożyczalnie sprzętu sportowego</p>

                    <div class="rs-welcome-features">
                        <div class="rs-feature">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                            <span>Zarządzaj produktami</span>
                        </div>
                        <div class="rs-feature">
                            <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" />
                            <span>Obsługuj klientów</span>
                        </div>
                        <div class="rs-feature">
                            <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Small" />
                            <span>Analizuj raporty</span>
                        </div>
                    </div>

                    <div class="rs-welcome-cta">
                        <MudButton Href="/Account/Login"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   Class="rs-welcome-btn">
                            Zaloguj się
                        </MudButton>
                        <MudText Typo="Typo.caption" Class="rs-welcome-register">
                            Nie masz konta? <MudLink Href="/Account/Register" Color="Color.Inherit" Underline="Underline.Always">Zarejestruj się</MudLink>
                        </MudText>
                    </div>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

<style>
    .admin-home { animation: fadeInUp 0.4s ease-out; }

    /* DS v2: flat navy-inverse hero, no gradient */
    .rs-hero {
        background: var(--navy-900, #1B2350) !important;
        color: #E8EBF5 !important;
        border-radius: 16px !important;
        border: 1px solid var(--navy-800, #242E61) !important;
    }
    .rs-hero-title { color: #FFFFFF !important; font-weight: 700; letter-spacing: -0.01em; }
    .rs-hero-subtitle { color: rgba(232, 235, 245, 0.75) !important; }

    /* Quick action card — outlined + flat */
    .rs-quick-action {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 1.25rem 1.5rem;
        background: var(--surface-card, #FFFFFF);
        border: 1px solid var(--line, #DDE2EC);
        border-radius: 16px;
        color: var(--text-body, #1C2438);
        text-decoration: none;
        box-shadow: var(--shadow-xs, 0 1px 2px rgba(24,31,69,0.06));
        transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 200ms, border-color 200ms;
    }
    .rs-quick-action:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md, 0 2px 4px rgba(24,31,69,0.05), 0 12px 28px -8px rgba(24,31,69,0.14));
        border-color: var(--line-strong, #C3CAD9);
        text-decoration: none;
        color: var(--text-body, #1C2438);
    }
    .rs-quick-action-icon {
        font-size: 2rem !important;
        color: var(--coral-500, #F96167) !important;
        margin-bottom: 0.25rem;
    }
    .rs-quick-action h3 {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0;
        color: var(--text-body, #1C2438);
    }
    .rs-quick-action p {
        font-size: 0.875rem;
        color: var(--text-secondary, #5B6B82);
        margin: 0;
    }

    /* Info cards (Funkcje panelu / Wskazówki) */
    .rs-info-card { border-radius: 16px !important; }

    /* Welcome hero (NotAuthorized) — flat navy, bez gradientu coral */
    .rs-welcome {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--navy-900, #1B2350);
        border-radius: 16px;
        margin: -1rem -0.5rem;
        padding: 3rem 2rem;
        color: #E8EBF5;
    }
    .rs-welcome-content { text-align: center; max-width: 520px; }
    .rs-welcome-logo { margin-bottom: 1.25rem; }
    .rs-welcome-title {
        font-family: 'Outfit', system-ui, sans-serif;
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #FFFFFF;
        margin: 0 0 0.5rem 0;
    }
    .rs-welcome-dot { color: #F96167; }
    .rs-welcome-subtitle {
        font-size: 1rem;
        color: rgba(232, 235, 245, 0.8);
        margin-bottom: 2rem;
    }
    .rs-welcome-features {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 2.5rem;
    }
    .rs-feature {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        padding: 0.5rem 1rem;
        border-radius: 999px;
        font-size: 0.875rem;
        color: rgba(232, 235, 245, 0.9);
    }
    .rs-welcome-cta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
    }
    .rs-welcome-btn {
        font-weight: 600 !important;
        padding: 0.75rem 2rem !important;
        font-size: 1rem !important;
    }
    .rs-welcome-register { color: rgba(232, 235, 245, 0.7); }
    .rs-welcome-register a { color: #F96167; }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
