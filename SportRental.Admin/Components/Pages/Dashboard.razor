@code {
    [Inject] private IDbContextFactory<ApplicationDbContext> DbFactory { get; set; } = default!;
    [Inject] private SportRental.Infrastructure.Tenancy.ITenantProvider TenantProvider { get; set; } = default!;
    [Inject] private SportRental.Admin.Services.Dashboard.DashboardMetricsService MetricsService { get; set; } = default!;
    [Inject] private SportRental.Admin.Services.Cache.IAppCache AppCache { get; set; } = default!;

    private int productsCount;
    private int customersCount;
    private int activeRentals;
    private int todayReturns;
    private int todayIssues;
    private SportRental.Admin.Services.Dashboard.DashboardMetrics? metrics;
    private List<SportRental.Admin.Services.Dashboard.TimelineEvent> timelineEvents = new();

    private const int TimelineStartHour = 6;
    private const int TimelineEndHour = 22;

    private double EventPct(DateTime localTime)
    {
        var minutes = (localTime.TimeOfDay.TotalMinutes - TimelineStartHour * 60.0)
            / ((TimelineEndHour - TimelineStartHour) * 60.0) * 100.0;
        return Math.Clamp(minutes, 0, 100);
    }

    private double? NowPctOfDay()
    {
        var n = DateTime.Now;
        if (n.Hour < TimelineStartHour || n.Hour > TimelineEndHour) return null;
        return EventPct(n);
    }

    private List<UpcomingReturnVm> upcomingReturns = new();
    private List<ActiveVm> activeNow = new();
    private string selectedBranch = "Wszystkie";
    private List<string> branches = new() { "Wszystkie" };
    private string tenantName = "RentSpot";
    private string[] weekLabels = Array.Empty<string>();
    private List<MudBlazor.ChartSeries> weekData = new();
    private ChartOptions chartOptions = new()
    {
        LineStrokeWidth = 3,
        ChartPalette = new[] { "#2F3C7E", "#F96167" }
    };

    protected override async Task OnInitializedAsync()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        var tid = TenantProvider.GetCurrentTenantId();
        Db.SetTenant(tid);
        if (tid.HasValue)
        {
            // PERF: nazwa tenanta to read-mostly — cached przez IAppCache na 15min.
            var t = await AppCache.GetTenantNameAsync(tid.Value);
            if (!string.IsNullOrWhiteSpace(t)) tenantName = t;
            metrics = await MetricsService.GetAsync(tid.Value);
            timelineEvents = await MetricsService.GetTodayTimelineAsync(tid.Value);
        }
        productsCount = await Db.Products.AsNoTracking().CountAsync();
        customersCount = await Db.Customers.AsNoTracking().CountAsync();
        activeRentals = await Db.Rentals.AsNoTracking().CountAsync(r => r.Status == RentalStatus.Active || r.Status == RentalStatus.Confirmed);
        var today = DateTime.UtcNow.Date;
        todayReturns = await Db.Rentals.AsNoTracking().CountAsync(r => r.EndDateUtc.Date == today);

        var utcToday = DateTime.UtcNow.Date;
        var next7 = utcToday.AddDays(7);
        todayIssues = await Db.Rentals.CountAsync(r => r.StartDateUtc >= utcToday && r.StartDateUtc < utcToday.AddDays(1));
        var data = await Db.Rentals.AsNoTracking()
            .OrderBy(r => r.EndDateUtc)
            .Where(r => r.EndDateUtc >= utcToday && r.EndDateUtc <= next7)
            .Select(r => new
            {
                r.Id,
                r.CustomerId,
                r.EndDateUtc,
                r.TotalAmount
            })
            .ToListAsync();

        // Aktywne teraz — pobieramy najpierw, żeby customerMap pokrył oba zestawy.
        var now = DateTime.UtcNow;
        var actives = await Db.Rentals.AsNoTracking()
            .Where(r => r.StartDateUtc <= now && r.EndDateUtc >= now && r.Status != RentalStatus.Cancelled)
            .Select(r => new { r.Id, r.CustomerId, r.StartDateUtc, r.EndDateUtc, r.TotalAmount })
            .OrderBy(r => r.EndDateUtc)
            .Take(20)
            .ToListAsync();

        var allCustomerIds = data.Select(d => d.CustomerId).Concat(actives.Select(a => a.CustomerId)).Distinct().ToList();
        var customerMap = await Db.Customers.AsNoTracking()
            .Where(c => allCustomerIds.Contains(c.Id))
            .ToDictionaryAsync(c => c.Id, c => new { c.FullName, c.TrustLevel });

        var itemsMap = await Db.RentalItems.AsNoTracking()
            .Where(ri => data.Select(d => d.Id).Contains(ri.RentalId))
            .GroupBy(ri => ri.RentalId)
            .ToDictionaryAsync(g => g.Key, g => g.Sum(x => x.Quantity));

        upcomingReturns = data.Select(d =>
        {
            var c = customerMap.GetValueOrDefault(d.CustomerId);
            return new UpcomingReturnVm
            {
                CustomerName = c?.FullName ?? d.CustomerId.ToString(),
                CustomerTrustLevel = c?.TrustLevel ?? CustomerTrustLevel.Unverified,
                EndDateLocal = d.EndDateUtc.ToLocalTime(),
                ItemsSummary = $"{itemsMap.GetValueOrDefault(d.Id, 0)} szt.",
                TotalAmount = d.TotalAmount
            };
        }).ToList();

        // Wykres: ostatnie 7 dni wg startu wynajmu
        var labels = new List<string>();
        var values = new List<double>();
        for (int i = 6; i >= 0; i--)
        {
            var day = utcToday.AddDays(-i);
            var count = await Db.Rentals.AsNoTracking().CountAsync(r => r.StartDateUtc >= day && r.StartDateUtc < day.AddDays(1));
            labels.Add(day.ToLocalTime().ToString("MM-dd"));
            values.Add(count);
        }
        weekLabels = labels.ToArray();
        weekData = new List<MudBlazor.ChartSeries>
        {
            new MudBlazor.ChartSeries { Name = "Wynajmy", Data = values.ToArray() }
        };

        activeNow = actives.Select(a =>
        {
            var c = customerMap.GetValueOrDefault(a.CustomerId);
            return new ActiveVm
            {
                CustomerName = c?.FullName ?? a.CustomerId.ToString(),
                CustomerTrustLevel = c?.TrustLevel ?? CustomerTrustLevel.Unverified,
                StartDateLocal = a.StartDateUtc.ToLocalTime(),
                EndDateLocal = a.EndDateUtc.ToLocalTime(),
                TotalAmount = a.TotalAmount
            };
        }).ToList();
    }

    private static string TrustEmoji(CustomerTrustLevel level) => level switch
    {
        CustomerTrustLevel.Good => "🟢",
        CustomerTrustLevel.Watch => "🟡",
        CustomerTrustLevel.Restricted => "🔴",
        _ => "✅"
    };

    private sealed class UpcomingReturnVm
    {
        public string CustomerName { get; set; } = string.Empty;
        public CustomerTrustLevel CustomerTrustLevel { get; set; } = CustomerTrustLevel.Unverified;
        public DateTime EndDateLocal { get; set; }
        public string ItemsSummary { get; set; } = string.Empty;
        public decimal TotalAmount { get; set; }
    }

    private sealed class ActiveVm
    {
        public string CustomerName { get; set; } = string.Empty;
        public CustomerTrustLevel CustomerTrustLevel { get; set; } = CustomerTrustLevel.Unverified;
        public DateTime StartDateLocal { get; set; }
        public DateTime EndDateLocal { get; set; }
        public decimal TotalAmount { get; set; }
    }
}
