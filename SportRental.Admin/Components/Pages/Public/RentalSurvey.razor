@page "/ankieta/{RentalId:guid}"
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout EmptyLayout

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using SportRental.Admin.Services
@using SportRental.Admin.Services.Time
@using SportRental.Infrastructure
@using SportRental.Infrastructure.Domain
@using System.ComponentModel.DataAnnotations

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IReviewSurveyTokenService TokenService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Wystaw opinię — RentSpot</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-6 py-md-8">
    @if (_state == PageState.Loading)
    {
        <div class="d-flex justify-center py-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate />
        </div>
    }
    else if (_state == PageState.InvalidToken)
    {
        <MudPaper Class="pa-6 text-center" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.LinkOff" Size="Size.Large" Color="Color.Warning" />
            <MudText Typo="Typo.h5" Class="mt-3">Link wygasł lub jest nieprawidłowy</MudText>
            <MudText Typo="Typo.body1" Class="mt-2 mud-text-secondary">
                Jeśli chcesz wystawić opinię, zaloguj się i przejdź do zakładki "Moje wypożyczenia".
            </MudText>
        </MudPaper>
    }
    else if (_state == PageState.AlreadySubmitted)
    {
        <MudPaper Class="pa-6 text-center" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
            <MudText Typo="Typo.h5" Class="mt-3">Opinia już wystawiona</MudText>
            <MudText Typo="Typo.body1" Class="mt-2 mud-text-secondary">
                Dziękujemy, Twoja opinia z @_existingReviewDate?.ToString("dd.MM.yyyy") została już zapisana.
            </MudText>
            @if (_existingReviewAverage.HasValue)
            {
                <div class="d-flex justify-center align-center gap-2 mt-4">
                    <MudRating SelectedValue="(int)Math.Round(_existingReviewAverage.Value / 2.0)" MaxValue="5" Disabled />
                    <MudText>@($"{_existingReviewAverage.Value:F1}/10")</MudText>
                </div>
            }
        </MudPaper>
    }
    else if (_state == PageState.ThankYou)
    {
        <MudPaper Class="pa-6 text-center" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.Favorite" Size="Size.Large" Color="Color.Success" />
            <MudText Typo="Typo.h4" Class="mt-3">Dziękujemy za opinię! 🎉</MudText>
            <MudText Typo="Typo.body1" Class="mt-3">
                Twój głos pomaga @_companyName i innym klientom.
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 pa-md-6 mb-4" Elevation="1">
            <div class="d-flex align-center gap-3 mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Large" />
                <MudText Typo="Typo.h5">Jak oceniasz wypożyczenie?</MudText>
            </div>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @_companyName • @_rentalStart?.ToString("dd.MM.yyyy") – @_rentalEnd?.ToString("dd.MM.yyyy")
                @if (_equipmentNames.Count > 0)
                {
                    <span> • @string.Join(", ", _equipmentNames)</span>
                }
            </MudText>
        </MudPaper>

        <MudPaper Class="pa-4 pa-md-6 mb-4" Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="mb-3">Oceny ogólne</MudText>

            <RatingRow Label="Jakość sprzętu" @bind-Value="_quality" />
            <RatingRow Label="Cena" @bind-Value="_price" />
            <RatingRow Label="Obsługa" @bind-Value="_service" />

            <MudTextField Label="Komentarz (opcjonalnie)" @bind-Value="_comment"
                          Lines="4" Variant="Variant.Outlined" Class="mt-4"
                          MaxLength="2000" Counter="2000" />
        </MudPaper>

        @if (_items.Count > 1)
        {
            <MudExpansionPanels Elevation="1" Class="mb-4">
                <MudExpansionPanel Text="Chcesz ocenić konkretne sprzęty? (opcjonalnie)">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                        Możesz pominąć — główna opinia wystarczy. Tutaj rozbicie na sprzęty z tego wynajmu.
                    </MudText>
                    @foreach (var item in _items)
                    {
                        <div class="mb-4">
                            <MudText Typo="Typo.body1" Class="mb-1"><b>@item.ProductName</b></MudText>
                            <RatingRow Label="Ocena" Value="item.Rating"
                                       ValueChanged="v => { item.Rating = v; StateHasChanged(); }" />
                            <MudTextField Label="Uwagi (opcjonalnie)" @bind-Value="item.Comment"
                                          Variant="Variant.Outlined" Lines="2" MaxLength="1000" />
                        </div>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        <div class="d-flex justify-end gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Send"
                       Disabled="_isSubmitting"
                       OnClick="SubmitAsync">
                @(_isSubmitting ? "Wysyłanie…" : "Wystaw opinię")
            </MudButton>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }
    }
</MudContainer>

@code {
    [Parameter] public Guid RentalId { get; set; }
    [SupplyParameterFromQuery(Name = "t")] public string? Token { get; set; }

    private enum PageState { Loading, InvalidToken, AlreadySubmitted, Form, ThankYou }
    private PageState _state = PageState.Loading;

    private Guid _tenantId;
    private Guid _customerId;
    private string _companyName = "RentSpot";
    private DateTime? _rentalStart;
    private DateTime? _rentalEnd;
    private List<string> _equipmentNames = new();
    private List<ItemReviewModel> _items = new();
    private DateTime? _existingReviewDate;
    private double? _existingReviewAverage;

    private int _quality = 8;
    private int _price = 8;
    private int _service = 8;
    private string? _comment;

    private bool _isSubmitting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (Exception)
        {
            // Bezpiecznie spadamy do "link wygasł" zamiast 500. Logi serwera złapią właściwy
            // exception, klientowi pokazujemy bezpieczne UI.
            _state = PageState.InvalidToken;
        }
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _state = PageState.InvalidToken;
            return;
        }

        if (!TokenService.TryValidate(Token, RentalId, out _))
        {
            _state = PageState.InvalidToken;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var rental = await db.Rentals.IgnoreQueryFilters()
            .Include(r => r.Items).ThenInclude(i => i.Product)
            .AsNoTracking()
            .FirstOrDefaultAsync(r => r.Id == RentalId);

        if (rental is null)
        {
            _state = PageState.InvalidToken;
            return;
        }

        _tenantId = rental.TenantId;
        _customerId = rental.CustomerId;
        _rentalStart = PolishTimeZone.FromUtc(rental.StartDateUtc);
        _rentalEnd = PolishTimeZone.FromUtc(rental.EndDateUtc);
        _equipmentNames = rental.Items.Select(i => i.Product?.Name ?? "Sprzęt").ToList();
        _items = rental.Items
            .Select(i => new ItemReviewModel
            {
                RentalItemId = i.Id,
                ProductName = i.Product?.Name ?? "Sprzęt",
                Rating = 0
            })
            .ToList();

        var company = await db.CompanyInfos.IgnoreQueryFilters().AsNoTracking()
            .FirstOrDefaultAsync(c => c.TenantId == rental.TenantId);
        if (!string.IsNullOrWhiteSpace(company?.Name)) _companyName = company.Name;

        var existing = await db.RentalReviews.IgnoreQueryFilters().AsNoTracking()
            .FirstOrDefaultAsync(rr => rr.RentalId == RentalId);
        if (existing is not null)
        {
            _existingReviewDate = existing.CreatedAtUtc;
            _existingReviewAverage = (existing.QualityScore + existing.PriceScore + existing.ServiceScore) / 3.0;
            _state = PageState.AlreadySubmitted;
            return;
        }

        _state = PageState.Form;
    }

    private async Task SubmitAsync()
    {
        _errorMessage = null;
        if (_quality < 0 || _quality > 10 || _price < 0 || _price > 10 || _service < 0 || _service > 10)
        {
            _errorMessage = "Oceny muszą być w zakresie 0-10.";
            return;
        }

        _isSubmitting = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var alreadyExists = await db.RentalReviews.IgnoreQueryFilters()
                .AnyAsync(rr => rr.RentalId == RentalId);
            if (alreadyExists)
            {
                _state = PageState.AlreadySubmitted;
                return;
            }

            var review = new RentalReview
            {
                Id = Guid.NewGuid(),
                TenantId = _tenantId,
                RentalId = RentalId,
                CustomerId = _customerId,
                QualityScore = _quality,
                PriceScore = _price,
                ServiceScore = _service,
                Comment = string.IsNullOrWhiteSpace(_comment) ? null : _comment.Trim(),
                IsHidden = false,
                CreatedAtUtc = DateTime.UtcNow
            };

            foreach (var item in _items.Where(i => i.Rating > 0 || !string.IsNullOrWhiteSpace(i.Comment)))
            {
                // Pomiń pozycje bez oceny i bez komentarza — nie zaśmiecamy bazy "0-ratingami"
                if (item.Rating <= 0 && string.IsNullOrWhiteSpace(item.Comment)) continue;

                var rentalItem = await db.RentalItems.IgnoreQueryFilters().AsNoTracking()
                    .Where(ri => ri.Id == item.RentalItemId && ri.RentalId == RentalId)
                    .Select(ri => new { ri.Id, ri.ProductId })
                    .FirstOrDefaultAsync();
                if (rentalItem is null) continue;

                review.ItemReviews.Add(new RentalItemReview
                {
                    Id = Guid.NewGuid(),
                    RentalReviewId = review.Id,
                    RentalItemId = rentalItem.Id,
                    ProductId = rentalItem.ProductId,
                    Rating = Math.Clamp(item.Rating, 0, 10),
                    Comment = string.IsNullOrWhiteSpace(item.Comment) ? null : item.Comment.Trim(),
                    CreatedAtUtc = DateTime.UtcNow
                });
            }

            db.RentalReviews.Add(review);
            await db.SaveChangesAsync();

            _state = PageState.ThankYou;
            Snackbar.Add("Dziękujemy za opinię!", Severity.Success);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Nie udało się zapisać opinii: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private class ItemReviewModel
    {
        public Guid RentalItemId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public int Rating { get; set; }
        public string? Comment { get; set; }
    }
}
