@inherits LayoutComponentBase

@*
    Pusty layout — bez nawigacji admina. Użyty dla publicznych stron takich jak /ankieta/{id}.
    NIE renderuj MudPopoverProvider/MudDialogProvider/MudSnackbarProvider — one są już w App.razor
    jako root-level singletons. Duplikat tutaj wyrzuca:
    InvalidOperationException: "There is already a subscriber to the content with the given
    section ID 'mud-overlay-to-popover-provider'." (SectionOutlet collision).
*@
<div style="min-height: 100vh; background: linear-gradient(135deg, #e3f2fd 0%, #fff 40%);">
    <main>
        @Body
    </main>
</div>
