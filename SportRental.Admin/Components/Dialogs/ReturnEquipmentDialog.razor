@rendermode InteractiveServer
@using SportRental.Infrastructure.Data
@using SportRental.Infrastructure.Domain
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.DataProtection
@using System.Data
@using SportRental.Admin.Services
@using SportRental.Admin.Services.Email
@using SportRental.Admin.Services.Guards

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IEmailSender EmailSender
@inject IDataProtectionProvider ProtectorProvider
@inject IConfiguration Config
@inject ILogger<ReturnEquipmentDialog> Logger
@inject SportRental.Admin.Services.IReviewSurveyTokenService SurveyTokenService
@inject SportRental.Admin.Services.ICustomerTrustCalculator TrustCalc
@inject NavigationManager NavigationManager
@inject SportRental.Admin.Payments.IPaymentGateway PaymentGateway

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Input" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Przyjęcie zwrotu</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            @* Info o kliencie *@
            <MudAlert Severity="Severity.Info" Dense="true" Class="pa-2">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                    <MudText Typo="Typo.body2" Style="font-weight: 600;">
                        @(Rental?.Customer?.FullName ?? "Nieznany klient")
                    </MudText>
                </div>
            </MudAlert>
            
            @* Lista produktów - kompaktowa *@
            <MudText Typo="Typo.caption" Style="font-weight: 600;">Produkty:</MudText>
            <MudStack Spacing="1">
                @if (Rental?.Items != null)
                {
                    @foreach (var item in Rental.Items)
                    {
                        <div class="d-flex align-center gap-2 pa-1" style="background: var(--mud-palette-background-grey); border-radius: 6px;">
                            <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body2">@(item.Product?.Name ?? "Produkt")</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">×@item.Quantity</MudChip>
                        </div>
                    }
                }
            </MudStack>
            
            @* Depozyt *@
            <MudAlert Severity="Severity.Warning" Dense="true" Class="pa-2">
                <div class="d-flex align-center justify-space-between">
                    <MudText Typo="Typo.body2">Depozyt pobrany:</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@(CollectedDepositAmount.Pln())</MudText>
                </div>
            </MudAlert>
            
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_depositRefund" 
                                     Label="Do zwrotu"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.End"
                                     AdornmentText="zł"
                                     Min="0"
                                     Max="@CollectedDepositAmount"
                                     Dense="true" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_damageCharge" 
                                     Label="Za uszkodzenia"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.End"
                                     AdornmentText="zł"
                                     Min="0"
                                     Dense="true" />
                </MudItem>
            </MudGrid>
            
            @* Stan sprzętu *@
            <MudText Typo="Typo.caption" Style="font-weight: 600;">Stan sprzętu:</MudText>
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                <MudChip T="string" 
                         Color="@(_equipmentCondition == "good" ? Color.Success : Color.Default)" 
                         Variant="@(_equipmentCondition == "good" ? Variant.Filled : Variant.Outlined)"
                         Size="Size.Small"
                         OnClick="SetConditionGood">
                    Dobry
                </MudChip>
                <MudChip T="string" 
                         Color="@(_equipmentCondition == "minor" ? Color.Warning : Color.Default)" 
                         Variant="@(_equipmentCondition == "minor" ? Variant.Filled : Variant.Outlined)"
                         Size="Size.Small"
                         OnClick="SetConditionMinor">
                    Drobne
                </MudChip>
                <MudChip T="string" 
                         Color="@(_equipmentCondition == "damaged" ? Color.Error : Color.Default)" 
                         Variant="@(_equipmentCondition == "damaged" ? Variant.Filled : Variant.Outlined)"
                         Size="Size.Small"
                         OnClick="SetConditionDamaged">
                    Uszkodzony
                </MudChip>
            </MudStack>
            
            @* Uwagi *@
            <MudTextField @bind-Value="_returnNotes"
                          Label="Uwagi (opcjonalne)"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Dense="true"
                          Placeholder="Stan sprzętu, uszkodzenia..." />

            @* Ocena klienta — RODO-friendly, bez tekstu, dla budowy historii zaufania.
               Opcjonalne: jeśli admin pominie, recenzja nie zostaje utworzona. *@
            <MudExpansionPanels Elevation="0" Class="mt-1">
                <MudExpansionPanel Text="@(_rateCustomer ? "Oceniasz klienta (3 oceny, opcjonalnie)" : "Oceń klienta (opcjonalnie)")"
                                   Expanded="_rateCustomer"
                                   ExpandedChanged="(v) => _rateCustomer = v">
                    <MudText Typo="Typo.caption" Class="mb-2 mud-text-secondary">
                        Bez komentarzy (RODO). Inni właściciele wypożyczalni widzą tylko poziom zaufania, nie szczegóły.
                    </MudText>
                    <div class="d-flex align-center gap-2 my-1">
                        <MudText Style="min-width: 130px;" Typo="Typo.body2">Terminowość zwrotu</MudText>
                        <MudRating @bind-SelectedValue="_timelinessStars" MaxValue="5" Size="Size.Small" />
                    </div>
                    <div class="d-flex align-center gap-2 my-1">
                        <MudText Style="min-width: 130px;" Typo="Typo.body2">Stan sprzętu</MudText>
                        <MudRating @bind-SelectedValue="_conditionStars" MaxValue="5" Size="Size.Small" />
                    </div>
                    <div class="d-flex align-center gap-2 my-1">
                        <MudText Style="min-width: 130px;" Typo="Typo.body2">Komunikacja</MudText>
                        <MudRating @bind-SelectedValue="_communicationStars" MaxValue="5" Size="Size.Small" />
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Size="Size.Small">Anuluj</MudButton>
        <MudButton OnClick="Submit" 
                   Variant="Variant.Filled" 
                   Color="Color.Primary"
                   Disabled="@(string.IsNullOrEmpty(_equipmentCondition) || _isProcessing)"
                   StartIcon="@Icons.Material.Filled.Check"
                   Size="Size.Small">
            @if (_isProcessing)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
            }
            Potwierdź
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    private IMudDialogInstance? MudDialog { get; set; }
    
    [Parameter]
    public Rental? Rental { get; set; }
    
    private string? _returnNotes;
    private decimal _depositRefund;
    private decimal _damageCharge;
    // Domyślnie "Dobry" — żeby Potwierdź było od razu klikalne. Inwestor zgłaszał że
    // "ciężko kliknąć, nic nie można" — to była ta blokada. Pracownik może zmienić.
    private string? _equipmentCondition = "good";
    private bool _isProcessing;

    // Ocena klienta (RODO-friendly, opcjonalna). 1 gwiazdka = 2 punkty (skala 0-10 w bazie).
    private bool _rateCustomer = false;
    private int _timelinessStars = 0;
    private int _conditionStars = 0;
    private int _communicationStars = 0;

    protected override void OnParametersSet()
    {
        _depositRefund = CollectedDepositAmount;
    }

    private decimal CollectedDepositAmount => Rental is not null && RentalGuards.IsDepositCollected(Rental)
        ? Math.Max(0m, Rental.DepositAmount)
        : 0m;

    private void Cancel() => MudDialog?.Cancel();
    
    private void SetConditionGood() => _equipmentCondition = "good";
    private void SetConditionMinor() => _equipmentCondition = "minor";
    private void SetConditionDamaged() => _equipmentCondition = "damaged";

    private async Task Submit()
    {
        if (Rental == null || string.IsNullOrEmpty(_equipmentCondition)) return;

        _isProcessing = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await using var transaction = await db.Database.BeginTransactionAsync(IsolationLevel.Serializable);
            var usesPostgresRowLocks = db.Database.ProviderName?.Contains(
                "Npgsql",
                StringComparison.OrdinalIgnoreCase) == true;

            var rental = usesPostgresRowLocks
                ? await db.Rentals
                    .FromSqlInterpolated($"SELECT * FROM \"Rentals\" WHERE \"Id\" = {Rental.Id} FOR UPDATE")
                    .Include(r => r.Customer)
                    .FirstOrDefaultAsync()
                : await db.Rentals
                    .Include(r => r.Customer)
                    .FirstOrDefaultAsync(r => r.Id == Rental.Id);

            if (rental == null)
            {
                Snackbar.Add("Nie znaleziono wypożyczenia", Severity.Error);
                MudDialog?.Cancel();
                return;
            }

            if (rental.ReturnedAtUtc.HasValue || rental.Status == RentalStatus.Completed)
            {
                Snackbar.Add("Ten zwrot został już wcześniej zapisany.", Severity.Info);
                MudDialog?.Close(DialogResult.Ok(true));
                return;
            }

            MarketplaceOrder? marketplaceOrder = null;
            if (rental.MarketplaceOrderId.HasValue)
            {
                marketplaceOrder = usesPostgresRowLocks
                    ? await db.MarketplaceOrders
                        .FromSqlInterpolated($"SELECT * FROM \"MarketplaceOrders\" WHERE \"Id\" = {rental.MarketplaceOrderId.Value} FOR UPDATE")
                        .FirstOrDefaultAsync()
                    : await db.MarketplaceOrders
                        .FirstOrDefaultAsync(order => order.Id == rental.MarketplaceOrderId.Value);
            }

            var collectedDeposit = RentalGuards.IsDepositCollected(rental)
                ? Math.Max(0m, rental.DepositAmount)
                : 0m;
            if (_depositRefund < 0m || _depositRefund > collectedDeposit)
            {
                Snackbar.Add("Kwota zwrotu depozytu jest nieprawidłowa. Odśwież wynajem i spróbuj ponownie.", Severity.Error);
                return;
            }

            var now = DateTime.UtcNow;

            // Depozyt online musi zostać faktycznie zwrócony w Stripe, zanim panel
            // zapisze sukces. Dla depozytu gotówkowego zapis potwierdza operację kasową.
            if (_depositRefund > 0m && !string.IsNullOrWhiteSpace(rental.PaymentIntentId))
            {
                var refundSucceeded = await PaymentGateway.RefundPaymentAsync(
                    Guid.Empty,
                    rental.PaymentIntentId,
                    _depositRefund,
                    "requested_by_customer",
                    $"return-deposit:{rental.Id:N}");
                if (!refundSucceeded)
                {
                    Snackbar.Add("Nie udało się zwrócić depozytu w Stripe. Zwrot sprzętu nie został zapisany.", Severity.Error);
                    return;
                }
            }

            rental.ReturnedAtUtc = now;
            rental.ReturnNotes = _returnNotes;
            rental.ReturnDepositRefund = _depositRefund;
            if (_depositRefund > 0m)
            {
                rental.PaymentStatus = _depositRefund >= rental.DepositAmount
                    ? "DepositRefunded"
                    : "DepositPartiallyRefunded";
                if (_depositRefund >= rental.DepositAmount)
                    rental.DepositPaidAtUtc = null;
            }
            else if (collectedDeposit > 0m)
            {
                rental.PaymentStatus = "DepositRetained";
            }
            rental.DamageCharge = _damageCharge > 0 ? _damageCharge : null;
            rental.Status = RentalStatus.Completed;

            if (marketplaceOrder is not null)
            {
                if (_depositRefund > 0m)
                    SportRental.Admin.Payments.MarketplaceOrderAccounting.ApplyRefund(
                        marketplaceOrder,
                        _depositRefund,
                        now);

                var hasOpenRental = await db.Rentals.IgnoreQueryFilters()
                    .AnyAsync(other =>
                        other.MarketplaceOrderId == marketplaceOrder.Id &&
                        other.Id != rental.Id &&
                        other.Status != RentalStatus.Completed &&
                        other.Status != RentalStatus.Cancelled);
                SportRental.Admin.Payments.MarketplaceOrderAccounting.MarkRentalCompleted(
                    marketplaceOrder,
                    hasOpenRental,
                    now);
            }

            // NXRE QA #17: zmniejsz HowManyRented (zwracamy sprzęt do dostępności)
            var rentalItems = await db.RentalItems.Where(i => i.RentalId == rental.Id).ToListAsync();
            foreach (var grp in rentalItems.GroupBy(i => i.ProductId))
            {
                var qty = grp.Sum(i => i.Quantity);
                await db.Products.Where(p => p.Id == grp.Key)
                    .ExecuteUpdateAsync(s => s.SetProperty(p => p.HowManyRented,
                        p => p.HowManyRented - qty < 0 ? 0 : p.HowManyRented - qty));
            }

            var conditionText = _equipmentCondition switch
            {
                "good" => "Stan: dobry",
                "minor" => "Stan: drobne uszkodzenia",
                "damaged" => "Stan: poważne uszkodzenia",
                _ => ""
            };

            if (!string.IsNullOrEmpty(conditionText))
            {
                rental.ReturnNotes = string.IsNullOrEmpty(rental.ReturnNotes)
                    ? conditionText
                    : $"{conditionText}. {rental.ReturnNotes}";
            }

            // Ocena klienta (opcjonalna) — RODO-friendly, bez tekstów. Pomijamy jeśli admin
            // nie kliknął żadnej gwiazdki w żadnym wymiarze.
            var hasAnyRating = _timelinessStars > 0 || _conditionStars > 0 || _communicationStars > 0;
            CustomerReview? newCustomerReview = null;
            if (_rateCustomer && hasAnyRating)
            {
                var alreadyExists = await db.CustomerReviews.IgnoreQueryFilters()
                    .AnyAsync(cr => cr.RentalId == rental.Id);
                if (!alreadyExists)
                {
                    newCustomerReview = new CustomerReview
                    {
                        Id = Guid.NewGuid(),
                        TenantId = rental.TenantId,
                        CustomerId = rental.CustomerId,
                        RentalId = rental.Id,
                        TimelinessScore = Math.Clamp(_timelinessStars * 2, 0, 10),
                        ConditionScore = Math.Clamp(_conditionStars * 2, 0, 10),
                        CommunicationScore = Math.Clamp(_communicationStars * 2, 0, 10),
                        CreatedAtUtc = now
                    };
                    db.CustomerReviews.Add(newCustomerReview);
                }
            }

            await db.SaveChangesAsync();
            await transaction.CommitAsync();

            // Thank-you mail wysyłamy dopiero po trwałym zapisie zwrotu. Błąd kanału
            // komunikacji nie może wycofać rozliczenia ani trzymać blokady zamówienia.
            var mailSent = await TrySendReturnThankYouAsync(rental, now);
            if (mailSent)
            {
                rental.ReviewRequestCount = 1;
                rental.LastReviewRequestSentAtUtc = now;
                await db.SaveChangesAsync();
            }

            // Recalc trust level — dopiero po SaveChanges, bo Recalculate czyta z bazy.
            if (newCustomerReview != null)
            {
                try { await TrustCalc.RecalculateAsync(rental.CustomerId); }
                catch (Exception ex) { Logger.LogError(ex, "Trust recalc failed for {CustomerId}", rental.CustomerId); }
            }

            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd: {ex.Message}", Severity.Error);
            MudDialog?.Cancel();
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task<bool> TrySendReturnThankYouAsync(Rental rental, DateTime now)
    {
        if (rental.Customer?.Email is null) return false;
        if (rental.Customer.ReviewEmailsOptOut) return false;

        try
        {
            // Link do ankiety kieruje na sradmin (Blazor Server) — ładuje się natychmiast, bez
            // logowania, token-validated. Host pobieramy z bieżącego requestu, żeby dev i prod
            // działały bez osobnej konfiguracji (w dev np. https://localhost:7083/ankieta/...).
            var adminBaseUrl = new Uri(NavigationManager.BaseUri).GetLeftPart(UriPartial.Authority);
            var surveyToken = SurveyTokenService.Generate(rental.Id);
            var reviewUrl = $"{adminBaseUrl}/ankieta/{rental.Id:D}?t={Uri.EscapeDataString(surveyToken)}";

            // Opt-out zostaje na kliencie WASM (tam jest publiczna lista opinii z linkiem "zrezygnuj").
            var clientBaseUrl = ClientAppUrlResolver.Resolve(Config, adminBaseUrl);
            var optOutProtector = ProtectorProvider.CreateProtector("ReviewOptOut");
            var optOutToken = optOutProtector.Protect(rental.Customer.Id.ToString("N"));
            var optOutUrl = $"{clientBaseUrl}/reviews/opt-out?token={Uri.EscapeDataString(optOutToken)}";

            await using var db = await DbFactory.CreateDbContextAsync();
            var companyName = await db.CompanyInfos.AsNoTracking()
                .Where(c => c.TenantId == rental.TenantId)
                .Select(c => c.Name)
                .FirstOrDefaultAsync();

            await EmailSender.SendReturnThankYouAsync(
                rental.Customer.Email,
                rental.Customer.FullName,
                reviewUrl,
                optOutUrl,
                companyName);

            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nie udało się wysłać thank-you maila po zwrocie dla wynajmu {RentalId}", rental.Id);
            return false;
        }
    }
}
