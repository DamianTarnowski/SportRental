@using SportRental.Infrastructure.Domain
@using SportRental.Admin.Services
@using SportRental.Admin.Services.QrCode
@inject IQrLabelGenerator LabelGenerator
@inject IBarcodeGenerator BarcodeGenerator
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.ViewWeek" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Generuj etykiety z kodami kreskowymi</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @* 
                UWAGA: Generowanie etykiet QR Code jest zachowane w kodzie (metoda GenerateLabelsAsync),
                ale wyłączone z interfejsu ze względów bezpieczeństwa — kody QR mogą być łatwo
                podmienione (phishing, przekierowanie na złośliwe strony). Kody kreskowe Code 128
                są bezpieczniejsze w środowisku wypożyczalni sprzętu.
                Aby przywrócić QR, odkomentuj toggle poniżej i zmień _useBarcode na false.
            *@
            @* <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.subtitle2">Typ kodu:</MudText>
                <MudToggleGroup T="bool" @bind-Value="_useBarcode" Color="Color.Primary" Rounded="true" CheckMark="true">
                    <MudToggleItem T="bool" Value="false" Text="QR Code" />
                    <MudToggleItem T="bool" Value="true" Text="Kod kreskowy" />
                </MudToggleGroup>
            </MudStack> *@

            <!-- Label Size Selection -->
            <MudSelect T="LabelSize" @bind-Value="_selectedSize" Label="Rozmiar etykiet" Variant="Variant.Outlined">
                <MudSelectItem Value="LabelSize.Small">Małe (38×30mm) - 45 na stronę</MudSelectItem>
                <MudSelectItem Value="LabelSize.Medium">Średnie (62×50mm) - 15 na stronę</MudSelectItem>
                <MudSelectItem Value="LabelSize.Large">Duże (92×70mm) - 8 na stronę</MudSelectItem>
            </MudSelect>
            
            <!-- Product Selection -->
            <MudText Typo="Typo.subtitle2" Class="mt-2">Wybierz produkty:</MudText>
            
            <MudPaper Elevation="0" Class="pa-2" Style="max-height: 300px; overflow-y: auto; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;">
                @if (Products == null || !Products.Any())
                {
                    <MudText Color="Color.Secondary" Class="pa-2">Brak produktów</MudText>
                }
                else
                {
                    <MudList T="string" Dense="true">
                        @foreach (var product in Products)
                        {
                            var isSelected = _selectedProducts.ContainsKey(product.Id);
                            <MudListItem @key="product.Id">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width: 100%;">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudCheckBox T="bool" Value="isSelected" 
                                                     ValueChanged="(val) => ToggleProduct(product, val)" 
                                                     Color="Color.Primary" />
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2" Class="fw-bold">@product.Name</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @(product.Sku ?? "Brak SKU")
                                            </MudText>
                                        </MudStack>
                                    </MudStack>
                                    @if (isSelected)
                                    {
                                        <MudNumericField T="int" @bind-Value="_selectedProducts[product.Id]" 
                                                         Label="Ilość" Variant="Variant.Outlined" 
                                                         Min="1" Max="100" Style="width: 80px;"
                                                         Margin="Margin.Dense" />
                                    }
                                </MudStack>
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
            
            <!-- Summary -->
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                <MudText Typo="Typo.body2">
                    Wybrano <strong>@_selectedProducts.Count</strong> produktów, 
                    łącznie <strong>@_selectedProducts.Values.Sum()</strong> etykiet
                </MudText>
            </MudAlert>
            
            <!-- Preview -->
            @if (_selectedProducts.Any())
            {
                <MudExpansionPanels>
                    <MudExpansionPanel Text="Podgląd etykiety" IsInitiallyExpanded="false">
                        <div class="label-preview">
                            <div class="label-preview-barcode">
                                @if (!string.IsNullOrWhiteSpace(_previewBarcodeImage))
                                {
                                    <img src="@_previewBarcodeImage" alt="Podgląd kodu kreskowego" />
                                }
                                else
                                {
                                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="68px" />
                                }
                            </div>
                            <div class="label-preview-text">
                                <strong>@(_previewProduct?.Name ?? "Nazwa produktu")</strong>
                                <br />
                                <small>@(_previewProduct?.Sku ?? "SKU")</small>
                                @if (!string.IsNullOrWhiteSpace(_previewBarcodeData))
                                {
                                    <br />
                                    <code>@_previewBarcodeData</code>
                                }
                            </div>
                        </div>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_isGenerating">Anuluj</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                   OnClick="GenerateLabels" Disabled="!_selectedProducts.Any() || _isGenerating"
                   StartIcon="@(_isGenerating ? null : Icons.Material.Filled.Download)">
            @if (_isGenerating)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Generowanie...</span>
            }
            else
            {
                <span>Pobierz PDF</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .label-preview {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        border: 1px dashed var(--mud-palette-lines-default);
        border-radius: 8px;
        background: var(--mud-palette-background-grey);
    }
    
    .label-preview-barcode {
        width: min(100%, 240px);
        min-width: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 4px;
        padding: 0.5rem;
    }

    .label-preview-barcode img {
        display: block;
        width: 100%;
        height: auto;
        max-width: 220px;
    }

    .label-preview-text code {
        font-size: 0.75rem;
        word-break: break-all;
        background: rgba(0, 0, 0, 0.04);
        padding: 0.1rem 0.3rem;
        border-radius: 4px;
        display: inline-block;
        margin-top: 0.35rem;
    }

    .label-preview-text {
        font-size: 0.875rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    
    [Parameter] public IEnumerable<Product>? Products { get; set; }
    [Parameter] public IEnumerable<Guid>? PreselectedProductIds { get; set; }
    
    private LabelSize _selectedSize = LabelSize.Medium;
    private Dictionary<Guid, int> _selectedProducts = new();
    private bool _isGenerating;
    private Product? _previewProduct;
    private string? _previewBarcodeImage;
    private string? _previewBarcodeData;
    // BEZPIECZEŃSTWO: Kody QR wyłączone — używamy wyłącznie kodów kreskowych Code 128.
    // Kod QR generowania (GenerateLabelsAsync) pozostaje w kodzie na wypadek przyszłej potrzeby.
    private bool _useBarcode = true; // zawsze true — QR wyłączone z UI
    
    protected override async Task OnParametersSetAsync()
    {
        if (PreselectedProductIds != null)
        {
            foreach (var id in PreselectedProductIds)
            {
                if (!_selectedProducts.ContainsKey(id))
                {
                    _selectedProducts[id] = 1;
                }
            }
        }

        await RefreshPreviewAsync();
    }
    
    private async Task ToggleProduct(Product product, bool selected)
    {
        if (selected)
        {
            _selectedProducts[product.Id] = 1;
        }
        else
        {
            _selectedProducts.Remove(product.Id);
        }

        await RefreshPreviewAsync();
    }
    
    private async Task GenerateLabels()
    {
        if (!_selectedProducts.Any() || Products == null)
            return;
        
        _isGenerating = true;
        StateHasChanged();
        
        try
        {
            var productsWithQuantities = Products
                .Where(p => _selectedProducts.ContainsKey(p.Id))
                .Select(p => (p, _selectedProducts[p.Id]))
                .ToList();
            
            var pdfBytes = _useBarcode
                ? await LabelGenerator.GenerateBarcodeLabelAsync(productsWithQuantities, _selectedSize)
                : await LabelGenerator.GenerateLabelsAsync(productsWithQuantities, _selectedSize);
            
            // Download the PDF
            var codeType = _useBarcode ? "barcode" : "qr";
            var fileName = $"etykiety-{codeType}-{DateTime.Now:yyyyMMdd-HHmmss}.pdf";
            await DownloadFile(pdfBytes, fileName, "application/pdf");
            
            Snackbar.Add($"Wygenerowano {_selectedProducts.Values.Sum()} etykiet", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd generowania: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isGenerating = false;
            StateHasChanged();
        }
    }
    
    private async Task DownloadFile(byte[] fileBytes, string fileName, string contentType)
    {
        using var stream = new MemoryStream(fileBytes);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, contentType, streamRef);
    }

    private async Task RefreshPreviewAsync()
    {
        _previewProduct = Products?.FirstOrDefault(p => _selectedProducts.ContainsKey(p.Id));

        if (_previewProduct == null)
        {
            _previewBarcodeImage = null;
            _previewBarcodeData = null;
            return;
        }

        _previewBarcodeData = BarcodeGenerator.GenerateProductBarcodeData(_previewProduct.Id, _previewProduct.Sku);
        _previewBarcodeImage = await BarcodeGenerator.GenerateBarcodeAsync(_previewBarcodeData, 520, 140);
    }
    
    private void Cancel() => MudDialog.Cancel();
}
