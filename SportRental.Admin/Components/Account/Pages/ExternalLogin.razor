@page "/Account/ExternalLogin"

@using Microsoft.AspNetCore.Identity
@using SportRental.Admin.Data
@using SportRental.Admin.Services.Auth
@using SportRental.Shared.Legal

@inject SignInManager<ApplicationUser> SignInManager
@inject ExternalLoginProvisioningService ExternalLoginProvisioner
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ExternalLogin> Logger

<PageTitle>Łączenie konta · RentSpot</PageTitle>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="auth-page">
        <div class="auth-card">
            <div class="auth-logo">
                <div class="auth-logo-icon">R<span class="auth-logo-dot">.</span></div>
            </div>
            <h1 class="auth-title">Logowanie przez @ProviderDisplayName</h1>
            <p class="auth-subtitle">@_message</p>
            <a class="btn btn-primary w-100" href="Account/Login">Wróć do logowania</a>
        </div>
    </div>
}

@code {
    public const string LoginCallbackAction = "LoginCallback";

    private string? _message;
    private ExternalLoginInfo? _externalLoginInfo;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? RemoteError { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Action { get; set; }

    [SupplyParameterFromQuery]
    private string? TermsVersion { get; set; }

    [SupplyParameterFromQuery]
    private string? PrivacyVersion { get; set; }

    private string ProviderDisplayName => _externalLoginInfo?.ProviderDisplayName ?? "Google";

    protected override async Task OnInitializedAsync()
    {
        if (RemoteError is not null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login",
                $"Błąd dostawcy zewnętrznego: {RemoteError}", HttpContext);
        }

        var info = await SignInManager.GetExternalLoginInfoAsync();
        if (info is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login",
                "Nie udało się odczytać danych logowania zewnętrznego.", HttpContext);
        }

        _externalLoginInfo = info;

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            if (Action == LoginCallbackAction)
            {
                await OnLoginCallbackAsync();
                return;
            }

            RedirectManager.RedirectTo("Account/Login");
        }
    }

    private async Task OnLoginCallbackAsync()
    {
        if (_externalLoginInfo is null) return;

        var hasCurrentLegalAcknowledgement =
            string.Equals(TermsVersion, LegalDocumentVersions.Terms, StringComparison.Ordinal) &&
            string.Equals(PrivacyVersion, LegalDocumentVersions.Privacy, StringComparison.Ordinal);

        // Dla logowania uruchomionego z aplikacji klienckiej wersje dokumentów są
        // chronione w OAuth state. Zapisujemy oświadczenie przed utworzeniem sesji.
        if (hasCurrentLegalAcknowledgement)
        {
            var existingUser = await SignInManager.UserManager.FindByLoginAsync(
                _externalLoginInfo.LoginProvider,
                _externalLoginInfo.ProviderKey);
            if (existingUser is not null &&
                (!string.Equals(existingUser.AcceptedTermsVersion, LegalDocumentVersions.Terms, StringComparison.Ordinal) ||
                 !string.Equals(existingUser.AcknowledgedPrivacyVersion, LegalDocumentVersions.Privacy, StringComparison.Ordinal) ||
                 existingUser.LegalAcceptedAtUtc is null))
            {
                existingUser.AcceptedTermsVersion = LegalDocumentVersions.Terms;
                existingUser.AcknowledgedPrivacyVersion = LegalDocumentVersions.Privacy;
                existingUser.LegalAcceptedAtUtc = DateTime.UtcNow;
                var updateResult = await SignInManager.UserManager.UpdateAsync(existingUser);
                if (!updateResult.Succeeded)
                {
                    _message = "Nie udało się zapisać akceptacji dokumentów. Spróbuj ponownie.";
                    return;
                }
            }
        }

        // Krok 1: jeśli Google login jest już powiązany — zaloguj od razu.
        var signInResult = await SignInManager.ExternalLoginSignInAsync(
            _externalLoginInfo.LoginProvider,
            _externalLoginInfo.ProviderKey,
            isPersistent: false,
            bypassTwoFactor: true);

        if (signInResult.Succeeded)
        {
            Logger.LogInformation("{Name} zalogowany przez {Provider}.",
                _externalLoginInfo.Principal.Identity?.Name, _externalLoginInfo.LoginProvider);
            RedirectAfterSignIn();
        }

        if (signInResult.IsLockedOut)
        {
            RedirectManager.RedirectTo("Account/Lockout");
        }

        // Brak powiązania: można utworzyć nowe konto, ale nie wolno automatycznie
        // dołączać providera do istniejącego konta wyłącznie po zgodnym emailu.
        var provisioning = await ExternalLoginProvisioner.ProvisionAsync(
            _externalLoginInfo,
            TermsVersion,
            PrivacyVersion);
        if (provisioning.Status != ExternalLoginProvisioningStatus.Created || provisioning.User is null)
        {
            // Taki sam komunikat dla kolizji i błędu provisioningu — bez ujawniania,
            // czy pod adresem zwróconym przez providera istnieje konto lokalne.
            _message = "Nie można dokończyć logowania tą metodą. Użyj dotychczasowej metody logowania lub skontaktuj się z obsługą.";
            return;
        }

        var user = provisioning.User;
        Logger.LogInformation("Utworzono nowe konto z providera {Provider}.",
            _externalLoginInfo.LoginProvider);
        await SignInManager.SignInAsync(user, isPersistent: false, _externalLoginInfo.LoginProvider);
        RedirectAfterSignIn();
    }

    private void RedirectAfterSignIn()
    {
        var returnUrl = SafeReturnUrl.ResolveLocal(ReturnUrl);
        if (SafeReturnUrl.IsClientPath(returnUrl))
        {
            RedirectManager.RedirectTo(
                $"api/auth/external-complete?returnUrl={Uri.EscapeDataString(returnUrl)}");
        }

        RedirectManager.RedirectTo(returnUrl);
    }
}
