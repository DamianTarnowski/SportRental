@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Identity.UI.Services
@using SportRental.Admin.Data
@using MudBlazor

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject IEmailSender EmailSender
@inject ILogger<ChangePassword> Logger

<PageTitle>Zmiana hasła - SportRental</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Primary" />
        <MudText Typo="Typo.h5">Zmiana hasła</MudText>
    </MudStack>

    <StatusMessage Message="@message" />
    
    <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Input.OldPassword" 
                              Label="Obecne hasło" 
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.LockOpen"
                              Placeholder="Wprowadź obecne hasło" />
                <ValidationMessage For="() => Input.OldPassword" class="mud-input-helper-text" style="color: var(--mud-palette-error);" />
            </MudItem>
            
            <MudItem xs="12" sm="6">
                @* Empty for layout balance *@
            </MudItem>
            
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Input.NewPassword" 
                              Label="Nowe hasło" 
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Placeholder="Min. 6 znaków" />
                <ValidationMessage For="() => Input.NewPassword" class="mud-input-helper-text" style="color: var(--mud-palette-error);" />
            </MudItem>
            
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="Input.ConfirmPassword" 
                              Label="Potwierdź nowe hasło" 
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.LockReset"
                              Placeholder="Powtórz nowe hasło" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="mud-input-helper-text" style="color: var(--mud-palette-error);" />
            </MudItem>
            
            <MudItem xs="12">
                <MudButton ButtonType="ButtonType.Submit" 
                           Variant="Variant.Filled" 
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Size="Size.Large">
                    Zmień hasło
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudStack>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private bool hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        hasPassword = await UserManager.HasPasswordAsync(user);
        if (!hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            message = $"Błąd: {string.Join(", ", changePasswordResult.Errors.Select(error => error.Description))}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User changed their password successfully.");

        // SEC-015: powiadom użytkownika o zmianie hasła (best-effort; niepowodzenie nie blokuje zmiany).
        if (!string.IsNullOrWhiteSpace(user.Email))
        {
            try
            {
                await EmailSender.SendEmailAsync(
                    user.Email,
                    "SportRental – zmiana hasła",
                    "<p>Cześć,</p>" +
                    "<p>Twoje hasło do konta SportRental zostało właśnie zmienione.</p>" +
                    "<p><strong>Jeśli to nie Ty</strong> – natychmiast skontaktuj się z administracją wypożyczalni, " +
                    "ponieważ ktoś mógł uzyskać dostęp do Twojego konta.</p>" +
                    $"<p>Data zmiany: {DateTime.UtcNow:yyyy-MM-dd HH:mm} UTC</p>");
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Nie udało się wysłać powiadomienia o zmianie hasła dla {Email}", user.Email);
            }
        }

        RedirectManager.RedirectToCurrentPageWithStatus("Hasło zostało zmienione.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Obecne hasło jest wymagane")]
        [DataType(DataType.Password)]
        [Display(Name = "Obecne hasło")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Nowe hasło jest wymagane")]
        [StringLength(100, ErrorMessage = "Hasło musi mieć od {2} do {1} znaków.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Nowe hasło")]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Potwierdź nowe hasło")]
        [Compare("NewPassword", ErrorMessage = "Hasła muszą być identyczne.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
