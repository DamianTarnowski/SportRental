@page "/Account/Logout"
<PageTitle>Wylogowanie</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-6 text-center" Elevation="4" Style="border-radius: 16px;">
        <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Large" Color="Color.Primary" Class="mb-4" />
        <MudText Typo="Typo.h5" Class="mb-2">Wylogować się?</MudText>
        <MudText Class="mb-5">Zakończysz sesję panelu partnera i aplikacji klienta.</MudText>
        <form action="/Account/Logout" method="post">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@(ReturnUrl ?? "/Account/Login")" />
            <MudStack Row="true" Justify="Justify.Center" Spacing="2">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Error">
                    Wyloguj
                </MudButton>
                <MudButton Href="/" Variant="Variant.Outlined" Color="Color.Default">
                    Anuluj
                </MudButton>
            </MudStack>
        </form>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

}
