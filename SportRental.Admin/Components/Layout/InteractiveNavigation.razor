@rendermode InteractiveServer

@inject SportRental.Admin.Services.UI.ThemeService Theme

<MudAppBar Elevation="1" Color="Color.Primary" Fixed="true">
    @if (_breakpoint < Breakpoint.Md)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                       Color="Color.Inherit" 
                       Edge="Edge.Start" 
                       OnClick="ToggleDrawer" />
    }
    <div class="rs-brand">
        <svg class="rs-brand-mark" viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="48" fill="#F96167" />
            <text x="50" y="72" font-family="Inter, system-ui, sans-serif" font-size="64" font-weight="900" text-anchor="middle" fill="#FFFFFF">R</text>
        </svg>
        <span class="rs-brand-word">RentSpot<span class="rs-brand-dot">.</span></span>
    </div>
    <MudSpacer />
    <ThemeSwitcher />
</MudAppBar>

<MudDrawer @bind-Open="_drawerOpen" 
           ClipMode="DrawerClipMode.Always" 
           Elevation="2"
           Variant="@(_breakpoint >= Breakpoint.Md ? DrawerVariant.Responsive : DrawerVariant.Temporary)"
           Breakpoint="Breakpoint.Md"
           Class="pt-14">
    <NavMenu />
</MudDrawer>

<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />

<style>
    .rs-brand { display: inline-flex; align-items: center; gap: 10px; margin-left: 8px; }
    .rs-brand-mark { width: 28px; height: 28px; flex: 0 0 28px; }
    .rs-brand-word { font-family: 'Inter', system-ui, -apple-system, sans-serif; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.01em; color: #fff; line-height: 1; }
    .rs-brand-dot { color: #F96167; margin-left: 1px; font-weight: 900; }
</style>

@code {
    private bool _drawerOpen = true;
    private Breakpoint _breakpoint = Breakpoint.Md;
    
    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void OnBreakpointChanged(Breakpoint breakpoint)
    {
        _breakpoint = breakpoint;

        // Na mobile drawer zamknięty domyślnie, na desktop otwarty
        if (_breakpoint < Breakpoint.Md)
        {
            _drawerOpen = false;
        }

        StateHasChanged();
    }
}
