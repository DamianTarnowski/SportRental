@rendermode InteractiveServer
@implements IDisposable

@inject SportRental.Admin.Services.UI.ThemeService Theme
@inject IJSRuntime JS

<MudThemeProvider @ref="_mudThemeProvider" @bind-IsDarkMode="_isDarkMode" Theme="@Theme.CurrentTheme" />

@code {
    private MudThemeProvider? _mudThemeProvider;
    private bool _isDarkMode;
    private const string ThemeStorageKey = "rs-theme-dark";

    protected override void OnInitialized()
    {
        _isDarkMode = false;
        Theme.IsDarkMode = false;
        Theme.OnChanged += HandleThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // NXRE QA #4: per-device preferencja motywu z localStorage przeglądarki.
                // Każde urządzenie pamięta swój wybór osobno (komputer ↔ telefon).
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ThemeStorageKey);
                if (saved == "1")
                {
                    _isDarkMode = true;
                    Theme.IsDarkMode = true;
                    await InvokeAsync(StateHasChanged);
                }
                else if (saved == "0")
                {
                    _isDarkMode = false;
                    Theme.IsDarkMode = false;
                }

                if (_mudThemeProvider != null)
                {
                    await _mudThemeProvider.WatchSystemPreference(OnSystemPreferenceChanged);
                }
            }
            catch
            {
                // Ignore JS interop errors during prerendering
            }
        }
    }

    private Task OnSystemPreferenceChanged(bool newValue)
    {
        // OS-level dark mode change — ignorujemy, user świadomie wybiera przez toggle.
        return Task.CompletedTask;
    }

    private async void HandleThemeChanged()
    {
        _isDarkMode = Theme.IsDarkMode;
        try
        {
            // NXRE QA #4: zapisz wybór do localStorage tego urządzenia.
            await JS.InvokeVoidAsync("localStorage.setItem", ThemeStorageKey, _isDarkMode ? "1" : "0");
        }
        catch
        {
            // SignalR rozłączony lub prerender — zignoruj.
        }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Theme.OnChanged -= HandleThemeChanged;
    }
}
