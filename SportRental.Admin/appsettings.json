{
  "KeyVault": {
    "Url": "https://vault2127.vault.azure.net/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Features": {
    "AllowOwnerSelfRegistration": true
  },
  "Storage": {
    "Provider": "AzureBlob"
  },
  "Sms": {
    "Provider": "SmsApi"
  },
  "smsApi": {
    "isEnabled": true,
    "sendConfirmationAttempts": 3,
    "senderName": "2WAY"
  },
  "SerwerSms": {
    "IsEnabled": true,
    "SenderName": "SportRental",
    "UseSmsEco": true,
    "MaxRetries": 3,
    "TestMode": false
  }
}
